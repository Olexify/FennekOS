#!/usr/bin/env bash
# Brings an existing user's shortcuts up to Fennek's current defaults, once per version, before the window
# manager starts (KDE copies every shortcut into the user's own file, so new defaults never reach them).
# New users get the same from /etc/xdg/kglobalshortcutsrc.
set -u
# Colour scheme, once: Breeze (blue) -> Fennek (violet). A scheme the user picked themselves stays.
colors_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/colors-version
if [ "$(cat "$colors_seen" 2>/dev/null)" != 2026-10-17 ]; then
    case "$(kreadconfig6 --file kdeglobals --group General --key ColorScheme)" in
        ""|BreezeLight|BreezeClassic) plasma-apply-colorscheme FennekLight >/dev/null 2>&1 ;;
        BreezeDark) plasma-apply-colorscheme FennekDark >/dev/null 2>&1 ;;
    esac
    mkdir -p "${colors_seen%/*}" && echo 2026-10-17 >"$colors_seen"
fi

# Look, once: back to a Fennek theme if a stock one took over (e.g. the Dark mode switch used to pick Breeze Dark,
# which replaced Fennek's frames, icons and panels). The layout stays as it is. The light/dark switch then
# alternates between the two Fennek themes. File Explorer opens on This PC (also first in its sidebar), and the
# desktop gets the This PC and Recycle Bin icons if it has none.
theme_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/theme-version
if [ "$(cat "$theme_seen" 2>/dev/null)" != 2026-10-17 ]; then
    k() { kreadconfig6 --file kdeglobals --group KDE --key "$1"; }
    case "$(k DefaultLightLookAndFeel)" in org.fennek.*) ;; *) kwriteconfig6 --file kdeglobals --group KDE --key DefaultLightLookAndFeel org.fennek.desktop ;; esac
    case "$(k DefaultDarkLookAndFeel)" in org.fennek.*) ;; *) kwriteconfig6 --file kdeglobals --group KDE --key DefaultDarkLookAndFeel org.fennek.dark.desktop ;; esac
    case "$(k LookAndFeelPackage)" in
        org.fennek.*) ;;
        *[Dd]ark*) timeout 60 plasma-apply-lookandfeel --apply org.fennek.dark.desktop >/dev/null 2>&1 ;;
        *) timeout 60 plasma-apply-lookandfeel --apply org.fennek.desktop >/dev/null 2>&1 ;;
    esac
    places=${XDG_DATA_HOME:-$HOME/.local/share}/user-places.xbel
    [ -f "$places" ] && /usr/libexec/fennek-first-login-places --ensure-thispc "$places"
    /usr/libexec/fennek-desktop-icons                                   # This PC and Recycle Bin on the desktop
    kwriteconfig6 --file dolphinrc --group General --key HomeUrl thispc:/   # Files opens on This PC
    kwriteconfig6 --file dolphinrc --group General --key RememberOpenedTabs false
    mkdir -p "${theme_seen%/*}" && echo 2026-10-17 >"$theme_seen"
fi

# Pointer, once per change: the earlier stock pointers -> Fennek's own (an own choice stays).
ptr_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/pointer-version
if [ "$(cat "$ptr_seen" 2>/dev/null)" != 2026-10-18 ]; then
    case "$(kreadconfig6 --file kcminputrc --group Mouse --key cursorTheme)" in
        ""|Bibata-Modern-Ice|Breeze_Light|breeze_cursors) kwriteconfig6 --file kcminputrc --group Mouse --key cursorTheme Fennek-Cursors ;;
    esac
    mkdir -p "${ptr_seen%/*}" && echo 2026-10-18 >"$ptr_seen"
fi

# Icons, once: a dark desktop gets the dark-ready Fennek icons (the light set drew dark symbols on dark windows).
icons_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/icons-version
if [ "$(cat "$icons_seen" 2>/dev/null)" != 2026-10-18 ]; then
    [ "$(kreadconfig6 --file kdeglobals --group General --key ColorScheme)" = FennekDark ] \
        && [ "$(kreadconfig6 --file kdeglobals --group Icons --key Theme --default Fennek)" = Fennek ] \
        && kwriteconfig6 --file kdeglobals --group Icons --key Theme Fennek-Dark
    mkdir -p "${icons_seen%/*}" && echo 2026-10-18 >"$icons_seen"
fi

# Taskbar and This PC, once: right-click on the taskbar = the classic taskbar menu (panels made before it
# existed kept KDE's panel menu), and This PC as big grouped icons for accounts made before that existed.
tb_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/taskbar-menu-version
if [ "$(cat "$tb_seen" 2>/dev/null)" != 2026-10-18 ]; then
    rc=plasma-org.kde.plasma.desktop-appletsrc
    [ "$(kreadconfig6 --file "$rc" --group ActionPlugins --group 1 --key 'RightButton;NoModifier')" = org.kde.contextmenu ] \
        && kwriteconfig6 --file "$rc" --group ActionPlugins --group 1 --key 'RightButton;NoModifier' org.fennek.taskbarmenu
    vp=${XDG_DATA_HOME:-$HOME/.local/share}/dolphin/view_properties/remote/.directory
    [ -e "$vp" ] || { mkdir -p "${vp%/*}" && cp /etc/skel/.local/share/dolphin/view_properties/remote/.directory "$vp"; }
    mkdir -p "${tb_seen%/*}" && echo 2026-10-18 >"$tb_seen"
fi

# Files, once: the classic menu bar on (KDE hid it at the first start).
files_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/files-version
if [ "$(cat "$files_seen" 2>/dev/null)" != 2026-10-17 ]; then
    kwriteconfig6 --file dolphinrc --group MainWindow --key MenuBar Enabled
    state=${XDG_STATE_HOME:-$HOME/.local/state}/dolphinstaterc
    mkdir -p "${state%/*}" && kwriteconfig6 --file "$state" --group MainWindow --key MenuBar Enabled
    mkdir -p "${files_seen%/*}" && echo 2026-10-17 >"$files_seen"
fi

version=2026-10-18b
seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/shortcuts-version
[ "$(cat "$seen" 2>/dev/null)" = "$version" ] && exit 0
f=${XDG_CONFIG_HOME:-$HOME/.config}/kglobalshortcutsrc
if [ -f "$f" ]; then
    kw() { kwriteconfig6 --file "$f" --group "$1" --key "$2" "$3"; }
    kw kwin Overview $'Meta+Tab\tMeta+W,Meta+W,Toggle Overview'                 # Super+Tab: task view
    kw plasmashell "next activity" "none,Meta+Tab,Walk through activities"
    kw kwin "Window Close" "none,Alt+F4,Close Window"                            # Alt+F4: see fennekaltf4
    kw kwin "Fennek Close or Shut Down" "Alt+F4,Alt+F4,Close the window, or shut down from the desktop"
    kwriteconfig6 --file "$f" --group services --group org.kde.krunner.desktop --key _launch $'Meta+R	Alt+Space	Alt+F2	Search'   # Super+R: Run box
    kwriteconfig6 --file "$f" --group services --group fennek-settings.desktop --key _launch Meta+I                    # Super+I: Settings
    kwriteconfig6 --file "$f" --group services --group org.kde.plasma-systemmonitor.desktop --key _launch $'Ctrl+Shift+Esc	Ctrl+Esc'   # Task Manager
fi
mkdir -p "${seen%/*}" && echo "$version" >"$seen"
