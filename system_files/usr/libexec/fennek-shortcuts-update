#!/usr/bin/env bash
# Brings an existing user's shortcuts up to Fennek's current defaults, once per version, before the window
# manager starts (KDE copies every shortcut into the user's own file, so new defaults never reach them).
# New users get the same from /etc/xdg/kglobalshortcutsrc.
set -u
# Colour scheme, once: Breeze (blue) -> Fennek (violet). A scheme the user picked themselves stays.
colors_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/colors-version
if [ "$(cat "$colors_seen" 2>/dev/null)" != 2026-10-17 ]; then
    case "$(kreadconfig6 --file kdeglobals --group General --key ColorScheme)" in
        ""|BreezeLight|BreezeClassic) plasma-apply-colorscheme FennekLight >/dev/null 2>&1 ;;
        BreezeDark) plasma-apply-colorscheme FennekDark >/dev/null 2>&1 ;;
    esac
    mkdir -p "${colors_seen%/*}" && echo 2026-10-17 >"$colors_seen"
fi

# Look, once: back to a Fennek theme if a stock one took over (e.g. the Dark mode switch used to pick Breeze Dark,
# which replaced Fennek's frames, icons and panels). The layout stays as it is. The light/dark switch then
# alternates between the two Fennek themes. Files opens on Home (also first in its sidebar), and the desktop gets
# the Home and Recycle Bin icons if it has none.
theme_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/theme-version
if [ "$(cat "$theme_seen" 2>/dev/null)" != 2026-10-17 ]; then
    k() { kreadconfig6 --file kdeglobals --group KDE --key "$1"; }
    case "$(k DefaultLightLookAndFeel)" in org.fennek.*) ;; *) kwriteconfig6 --file kdeglobals --group KDE --key DefaultLightLookAndFeel org.fennek.desktop ;; esac
    case "$(k DefaultDarkLookAndFeel)" in org.fennek.*) ;; *) kwriteconfig6 --file kdeglobals --group KDE --key DefaultDarkLookAndFeel org.fennek.dark.desktop ;; esac
    case "$(k LookAndFeelPackage)" in
        org.fennek.*) ;;
        *[Dd]ark*) timeout 60 plasma-apply-lookandfeel --apply org.fennek.dark.desktop >/dev/null 2>&1 ;;
        *) timeout 60 plasma-apply-lookandfeel --apply org.fennek.desktop >/dev/null 2>&1 ;;
    esac
    places=${XDG_DATA_HOME:-$HOME/.local/share}/user-places.xbel
    [ -f "$places" ] && /usr/libexec/fennek-first-login-places --ensure-home "$places"
    /usr/libexec/fennek-desktop-icons                                   # Home and Recycle Bin on the desktop
    kwriteconfig6 --file dolphinrc --group General --key RememberOpenedTabs false
    mkdir -p "${theme_seen%/*}" && echo 2026-10-17 >"$theme_seen"
fi

# Pointer, once per change: the earlier stock pointers -> Fennek's own (an own choice stays).
ptr_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/pointer-version
if [ "$(cat "$ptr_seen" 2>/dev/null)" != 2026-10-18 ]; then
    case "$(kreadconfig6 --file kcminputrc --group Mouse --key cursorTheme)" in
        ""|Bibata-Modern-Ice|Breeze_Light|breeze_cursors) kwriteconfig6 --file kcminputrc --group Mouse --key cursorTheme Fennek-Cursors ;;
    esac
    mkdir -p "${ptr_seen%/*}" && echo 2026-10-18 >"$ptr_seen"
fi

# Icons, once: a dark desktop gets the dark-ready Fennek icons (the light set drew dark symbols on dark windows).
icons_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/icons-version
if [ "$(cat "$icons_seen" 2>/dev/null)" != 2026-10-18 ]; then
    [ "$(kreadconfig6 --file kdeglobals --group General --key ColorScheme)" = FennekDark ] \
        && [ "$(kreadconfig6 --file kdeglobals --group Icons --key Theme --default Fennek)" = Fennek ] \
        && kwriteconfig6 --file kdeglobals --group Icons --key Theme Fennek-Dark
    mkdir -p "${icons_seen%/*}" && echo 2026-10-18 >"$icons_seen"
fi

# Taskbar and This PC, once: right-click on the taskbar = the classic taskbar menu (panels made before it
# existed kept KDE's panel menu), and This PC as big grouped icons for accounts made before that existed.
tb_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/taskbar-menu-version
if [ "$(cat "$tb_seen" 2>/dev/null)" != 2026-10-18 ]; then
    rc=plasma-org.kde.plasma.desktop-appletsrc
    [ "$(kreadconfig6 --file "$rc" --group ActionPlugins --group 1 --key 'RightButton;NoModifier')" = org.kde.contextmenu ] \
        && kwriteconfig6 --file "$rc" --group ActionPlugins --group 1 --key 'RightButton;NoModifier' org.fennek.taskbarmenu
    vp=${XDG_DATA_HOME:-$HOME/.local/share}/dolphin/view_properties/remote/.directory
    [ -e "$vp" ] || { mkdir -p "${vp%/*}" && cp /etc/skel/.local/share/dolphin/view_properties/remote/.directory "$vp"; }
    mkdir -p "${tb_seen%/*}" && echo 2026-10-18 >"$tb_seen"
fi

# Desktop right-click, once: classic and short (New, Paste, Icons, Terminal, Wallpaper, Display); lock and sign
# out stay in Start, editing the desktop layout in its own menu.
dm_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/desktop-menu-version
# Repair (2026-10-18 build): a first sign-in got only these settings and no menu; give the desktop its menu back.
arc=${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc
if grep -qF '[ActionPlugins][0][RightButton;NoModifier]' "$arc" 2>/dev/null \
   && [ -z "$(kreadconfig6 --file plasma-org.kde.plasma.desktop-appletsrc --group ActionPlugins --group 0 --key 'RightButton;NoModifier')" ]; then
    kwriteconfig6 --file plasma-org.kde.plasma.desktop-appletsrc --group ActionPlugins --group 0 --key 'RightButton;NoModifier' org.kde.contextmenu
fi
# Only once the desktop has made its own menu settings: written earlier, they would stand in for KDE's defaults and
# leave the desktop with no right-click menu at all (first sign-in). Then it simply happens at the next sign-in.
if [ "$(cat "$dm_seen" 2>/dev/null)" != 2026-10-18b ]    && [ "$(kreadconfig6 --file plasma-org.kde.plasma.desktop-appletsrc --group ActionPlugins --group 0 --key 'RightButton;NoModifier')" = org.kde.contextmenu ]; then
    for a in _lock_screen _logout "edit mode"; do
        kwriteconfig6 --file plasma-org.kde.plasma.desktop-appletsrc --group ActionPlugins --group 0 \
            --group 'RightButton;NoModifier' --key "$a" false
    done
    mkdir -p "${dm_seen%/*}" && echo 2026-10-18b >"$dm_seen"
fi

# Widget style, once: Breeze -> Fennek (Breeze plus: the wheel scrolls the page, not the drop-down under it).
ws_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/widget-style-version
if [ "$(cat "$ws_seen" 2>/dev/null)" != 2026-10-18 ]; then
    case "$(kreadconfig6 --file "${XDG_CONFIG_HOME:-$HOME/.config}/kdeglobals" --group KDE --key widgetStyle)" in
        Breeze|breeze) kwriteconfig6 --file kdeglobals --group KDE --key widgetStyle Fennek ;;
    esac
    mkdir -p "${ws_seen%/*}" && echo 2026-10-18 >"$ws_seen"
fi

# Splash, once: KDE's Plasma splash -> Fennek's (an own choice of another splash stays).
splash_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/splash-version
if [ "$(cat "$splash_seen" 2>/dev/null)" != 2026-10-18 ]; then
    case "$(kreadconfig6 --file "${XDG_CONFIG_HOME:-$HOME/.config}/ksplashrc" --group KSplash --key Theme)" in
        ""|org.kde.breeze.desktop|org.fedoraproject.*) kwriteconfig6 --file ksplashrc --group KSplash --key Theme org.fennek.desktop
                                                       kwriteconfig6 --file ksplashrc --group KSplash --key Engine KSplashQML ;;
    esac
    mkdir -p "${splash_seen%/*}" && echo 2026-10-18 >"$splash_seen"
fi

# Day/night pair, again (2026-10-18): back to the two Fennek looks if something set KDE's (Quick Settings then
# offered Breeze / Breeze Dark and switching swapped in KDE's taskbar and frames).
pair_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/look-pair-version
if [ "$(cat "$pair_seen" 2>/dev/null)" != 2026-10-18 ]; then
    k() { kreadconfig6 --file kdeglobals --group KDE --key "$1"; }
    case "$(k DefaultLightLookAndFeel)" in org.fennek.*) ;; *) kwriteconfig6 --file kdeglobals --group KDE --key DefaultLightLookAndFeel org.fennek.desktop ;; esac
    case "$(k DefaultDarkLookAndFeel)" in org.fennek.*) ;; *) kwriteconfig6 --file kdeglobals --group KDE --key DefaultDarkLookAndFeel org.fennek.dark.desktop ;; esac
    mkdir -p "${pair_seen%/*}" && echo 2026-10-18 >"$pair_seen"
fi

# Light look, once: fully light (light taskbar, Start, pop-ups) instead of the earlier dark panels.
panel_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/light-panel-version
if [ "$(cat "$panel_seen" 2>/dev/null)" != 2026-10-18 ]; then
    # the account's own choice, read from its file (kreadconfig6 would mix in the system-wide light default)
    if grep -qs '^LookAndFeelPackage=org.fennek.desktop$' "${XDG_CONFIG_HOME:-$HOME/.config}/kdeglobals"; then
        case "$(kreadconfig6 --file "${XDG_CONFIG_HOME:-$HOME/.config}/plasmarc" --group Theme --key name)" in
            ""|fennek-dark) kwriteconfig6 --file plasmarc --group Theme --key name fennek-light ;;
        esac
    fi
    mkdir -p "${panel_seen%/*}" && echo 2026-10-18 >"$panel_seen"
fi

# Virtual machine, once: no 3D card there, so every frame is drawn by the processor. Blur behind panels and long
# animations make it feel slow; switch them off (real PCs keep them). An own choice stays.
vm_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/vm-speed-version
if [ "$(cat "$vm_seen" 2>/dev/null)" != 2026-10-18 ]; then
    if systemd-detect-virt --vm --quiet; then
        cfg=${XDG_CONFIG_HOME:-$HOME/.config}   # the user's own files only (not the system defaults)
        [ -z "$(kreadconfig6 --file "$cfg/kwinrc" --group Plugins --key blurEnabled)" ] && kwriteconfig6 --file kwinrc --group Plugins --key blurEnabled false
        [ -z "$(kreadconfig6 --file "$cfg/kwinrc" --group Plugins --key contrastEnabled)" ] && kwriteconfig6 --file kwinrc --group Plugins --key contrastEnabled false
        [ -z "$(kreadconfig6 --file "$cfg/kdeglobals" --group KDE --key AnimationDurationFactor)" ] \
            && kwriteconfig6 --file kdeglobals --group KDE --key AnimationDurationFactor 0.25
    fi
    mkdir -p "${vm_seen%/*}" && echo 2026-10-18 >"$vm_seen"
fi

# Desktop Ctrl + mouse wheel = display size, once; only after the desktop made its own settings (as above).
zoom_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/desktop-zoom-version
if [ "$(cat "$zoom_seen" 2>/dev/null)" != 2026-10-18 ] \
   && [ "$(kreadconfig6 --file plasma-org.kde.plasma.desktop-appletsrc --group ActionPlugins --group 0 --key 'RightButton;NoModifier')" = org.kde.contextmenu ]; then
    [ -z "$(kreadconfig6 --file plasma-org.kde.plasma.desktop-appletsrc --group ActionPlugins --group 0 --key 'wheel:Vertical;ControlModifier')" ] \
        && kwriteconfig6 --file plasma-org.kde.plasma.desktop-appletsrc --group ActionPlugins --group 0 --key 'wheel:Vertical;ControlModifier' org.fennek.uiscale
    mkdir -p "${zoom_seen%/*}" && echo 2026-10-18 >"$zoom_seen"
fi

# Files, once: the classic menu bar on (KDE hid it at the first start).
files_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/files-version
if [ "$(cat "$files_seen" 2>/dev/null)" != 2026-10-20c ]; then   # 10-20: Information panel on, details pop-up only on a selected item, no stars
    kwriteconfig6 --file dolphinrc --group MainWindow --key MenuBar Enabled
    state=${XDG_STATE_HOME:-$HOME/.local/state}/dolphinstaterc
    mkdir -p "${state%/*}" && kwriteconfig6 --file "$state" --group MainWindow --key MenuBar Enabled
    kwriteconfig6 --file dolphinrc --group General --key ShowToolTips true   # the patched Files shows it on selected items only
    old=$(kreadconfig6 --file "$state" --group State --key State)
    [ -n "$old" ] && kwriteconfig6 --file "$state" --group State --key State "$(printf '%s' "$old" | /usr/libexec/fennek-files-info-panel)"
    for k in rating tags userComment; do kwriteconfig6 --file baloofileinformationrc --group Show --key "$k" false; done
    mkdir -p "${files_seen%/*}" && echo 2026-10-20c >"$files_seen"
fi

# Wallpapers, once: the extra wallpapers and theme pictures left the system (they come from FennekWallpapers when
# picked). A desktop, lock screen or Fennek Live picture that used one points to the account's own copy, which is
# fetched in the background (no network now: the next sign-in tries again; meanwhile the desktop shows its default).
wp_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/wallpapers-version
if [ "$(cat "$wp_seen" 2>/dev/null)" != 2026-10-20 ]; then
    own=${XDG_DATA_HOME:-$HOME/.local/share}/wallpapers
    pending=0
    conf=("${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc" "${XDG_CONFIG_HOME:-$HOME/.config}/kscreenlockerrc")
    for w in Amber Sakura Royal Arcade Fennek-Classic Leonote-Night Leonote-Graph Leonote-Paper; do
        for f in "${conf[@]}"; do [ -f "$f" ] && sed -i "s|file:///usr/share/wallpapers/$w/|file://$own/$w/|g" "$f"; done
        if grep -qsF "file://$own/$w/" "${conf[@]}" && [ ! -d "$own/$w" ]; then
            (/usr/libexec/fennek-wallpaper-get "$w" >/dev/null 2>&1 &)   # retried at the next sign-in until it's there
            pending=1
        fi
    done
    [ $pending = 0 ] && mkdir -p "${wp_seen%/*}" && echo 2026-10-20 >"$wp_seen"
fi
# The stock pictures (KDE's, Fedora's) moved one folder down (Fennek's own come first on the Background page):
# a desktop or lock screen that uses one follows it there.
for f in "${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc" "${XDG_CONFIG_HOME:-$HOME/.config}/kscreenlockerrc"; do
    grep -qs 'file:///usr/share/wallpapers/' "$f" || continue
    for w in /usr/share/wallpapers/More/*/; do
        [ -d "$w" ] || continue; n=$(basename "$w"); sed -i "s#file:///usr/share/wallpapers/$n/#file:///usr/share/wallpapers/More/$n/#g" "$f"
    done
done

# Files sidebar, once: hide "Devices" (system partitions) and "Recent", the bin is Recycle Bin (English).
pl_seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/places-version
if [ "$(cat "$pl_seen" 2>/dev/null)" != 2026-10-20b ]; then   # Home is the start place again (shown as the Home page); This PC goes; Recent hidden
    places=${XDG_DATA_HOME:-$HOME/.local/share}/user-places.xbel
    [ -f "$places" ] && /usr/libexec/fennek-first-login-places --ensure-home "$places"
    kwriteconfig6 --file dolphinrc --group General --key HomeUrl --delete   # Files opens on the home folder
    /usr/libexec/fennek-desktop-icons                                       # This PC icon -> Home
    mkdir -p "${pl_seen%/*}" && echo 2026-10-20b >"$pl_seen"
fi

version=2026-10-22
seen=${XDG_STATE_HOME:-$HOME/.local/state}/fennek/shortcuts-version
[ "$(cat "$seen" 2>/dev/null)" = "$version" ] && exit 0
f=${XDG_CONFIG_HOME:-$HOME/.config}/kglobalshortcutsrc
if [ -f "$f" ]; then
    kw() { kwriteconfig6 --file "$f" --group "$1" --key "$2" "$3"; }
    kw kwin Overview $'Meta+Tab\tMeta+W,Meta+W,Toggle Overview'                 # Super+Tab: task view
    kw plasmashell "next activity" "none,Meta+Tab,Walk through activities"
    kw kwin "Window Close" "none,Alt+F4,Close Window"                            # Alt+F4: see fennekaltf4
    kw kwin "Fennek Close or Shut Down" "Alt+F4,Alt+F4,Close the window, or shut down from the desktop"
    kw kwin "Show Desktop" "none,Meta+D,Peek at Desktop"                                   # Super+D: see fennekshowdesktop
    kw kwin "Fennek Show Desktop" "Meta+D,Meta+D,Show the desktop; press again to bring the windows back"
    kw kwin "Window Quick Tile Top" "none,Meta+Up,Quick Tile Window to the Top"               # Super+Up / Down: fennekarrows
    kw kwin "Window Quick Tile Bottom" "none,Meta+Down,Quick Tile Window to the Bottom"
    kw kwin "Fennek Maximize" "Meta+Up,Meta+Up,Maximize the window"
    kw kwin "Fennek Restore or Minimize" "Meta+Down,Meta+Down,Restore a maximized window, or minimize it"
    kw kwin MinimizeAll "Meta+M,Meta+Shift+D,Minimize all windows"                       # Super+M
    kw kwin minimizeAllOthers "Meta+Home,Meta+Shift+O,Minimize all other windows"          # Super+Home
    kwriteconfig6 --file "$f" --group services --group org.kde.krunner.desktop --key _launch $'Alt+Space	Alt+F2	Search'   # search
    kwriteconfig6 --file "$f" --group services --group fennek-run.desktop --key _launch Meta+R                            # Super+R: Run box
    kwriteconfig6 --file "$f" --group services --group fennek-settings.desktop --key _launch Meta+I                    # Super+I: Settings
    kwriteconfig6 --file "$f" --group services --group org.kde.plasma-systemmonitor.desktop --key _launch $'Ctrl+Shift+Esc	Ctrl+Esc'   # Task Manager
    kwriteconfig6 --file "$f" --group services --group fennek-winx.desktop --key _launch Meta+X                       # Super+X: quick links
    kwriteconfig6 --file "$f" --group services --group fennek-about.desktop --key _launch Meta+Pause                # Super+Pause: About
    kwriteconfig6 --file "$f" --group services --group fennek-search.desktop --key _launch Meta+S                   # Super+S: Search
    kw ksmserver "Log Out" "none,Ctrl+Alt+Del,Log Out"                                   # Ctrl+Alt+Del: security options
    kwriteconfig6 --file "$f" --group services --group fennek-security.desktop --key _launch Ctrl+Alt+Del
    kwriteconfig6 --file "$f" --group services --group org.kde.spectacle.desktop --key _launch none          # PrtSc keys: fennek-printscreen
    kwriteconfig6 --file "$f" --group services --group org.kde.spectacle.desktop --key ActiveWindowScreenShot none
    python3 - "$f" <<'PYEOF'   # Super+R: only the Run box (KDE's screenshot app records the screen with it)
import re, sys
p = sys.argv[1]
t = open(p, encoding="utf-8").read()
out, group = [], ""
for line in t.split("\n"):
    if line.startswith("["):
        group = line
    elif "=" in line and group != "[services][fennek-run.desktop]":
        key, val = line.split("=", 1)
        parts = val.split(",")
        active = [k for k in parts[0].split("\t") if k != "Meta+R"]
        if len(active) != len(parts[0].split("\t")):
            parts[0] = "\t".join(active) or "none"
            line = key + "=" + ",".join(parts)
    out.append(line)
n = "\n".join(out)
if n != t:
    open(p + ".fennek-new", "w", encoding="utf-8").write(n)
    import os; os.replace(p + ".fennek-new", p)
PYEOF
    kwriteconfig6 --file "$f" --group services --group fennek-run.desktop --key _launch Meta+R
    kw "KDE Keyboard Layout Switcher" "Switch to Next Keyboard Layout" $'Meta+Space\tMeta+Alt+K,Meta+Alt+K,Switch to Next Keyboard Layout'   # Super+Space: next language
fi
mkdir -p "${seen%/*}" && echo "$version" >"$seen"
