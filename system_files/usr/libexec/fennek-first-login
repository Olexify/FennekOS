#!/usr/bin/bash
# Once per user, at the first login: make sure the Fennek look (taskbar, Start menu, wallpaper) is active,
# and give Files the classic sidebar. The base writes Fedora's theme into new users' own settings, which
# would hide the Fennek default.
set -u
places="${XDG_DATA_HOME:-$HOME/.local/share}/user-places.xbel"
[ -e "$places" ] || /usr/libexec/fennek-first-login-places "$places"
/usr/libexec/fennek-first-login-keyboard   # taskbar language labels: ENG / УКР …

stamp="${XDG_CONFIG_HOME:-$HOME/.config}/fennek/first-login-done"
[ -e "$stamp" ] && exit 0
lnf=$(kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage)
if [ "${lnf#org.fennek.}" = "$lnf" ]; then   # not a Fennek look (light or dark)
    sleep 3   # let the desktop finish starting, so the layout reset reaches the running taskbar
    plasma-apply-lookandfeel --apply org.fennek.desktop --resetLayout || exit 1   # retried next login
fi
# Desktop icons for This PC and the Recycle Bin (in the user's language).
desk=$(xdg-user-dir DESKTOP 2>/dev/null)
if [ -n "$desk" ] && [ "$desk" != "$HOME" ] && mkdir -p "$desk"; then
    case "${LANG:-}" in uk*) pc="Цей ПК"; bin="Кошик" ;; *) pc="This PC"; bin="Recycle Bin" ;; esac
    printf '[Desktop Entry]\nType=Link\nName=%s\nIcon=computer\nURL=thispc:/\n' "$pc" > "$desk/this-pc.desktop"
    printf '[Desktop Entry]\nType=Link\nName=%s\nIcon=user-trash-full\nEmptyIcon=user-trash\nURL=trash:/\n' "$bin" > "$desk/recycle-bin.desktop"
fi
# Files: classic menu bar (File, Edit, View…). KDE keeps this in the per-user state file, which system defaults
# don't reach.
state="${XDG_STATE_HOME:-$HOME/.local/state}/dolphinstaterc"
[ -e "$state" ] || { mkdir -p "${state%/*}" && printf '[MainWindow]
MenuBar=Enabled
' > "$state"; }
mkdir -p "${stamp%/*}" && touch "$stamp"
# First login only: say hello (pick a look, what keeps you safe, tips).
(sleep 2; fennek-app welcome) >/dev/null 2>&1 &
