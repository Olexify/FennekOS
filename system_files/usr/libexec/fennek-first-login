#!/usr/bin/bash
# Once per user, at the first login: make sure the Fennek look (taskbar, Start menu, wallpaper) is active,
# and give Files the classic sidebar. The base writes Fedora's theme into new users' own settings, which
# would hide the Fennek default.
set -u
places="${XDG_DATA_HOME:-$HOME/.local/share}/user-places.xbel"
[ -e "$places" ] || /usr/libexec/fennek-first-login-places "$places"
/usr/libexec/fennek-first-login-keyboard   # taskbar language labels: ENG / УКР …

stamp="${XDG_CONFIG_HOME:-$HOME/.config}/fennek/first-login-done"
[ -e "$stamp" ] && exit 0
lnf=$(kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage)
if [ "${lnf#org.fennek.}" = "$lnf" ]; then   # not a Fennek look (light or dark)
    sleep 3   # let the desktop finish starting, so the layout reset reaches the running taskbar
    plasma-apply-lookandfeel --apply org.fennek.dark.desktop --resetLayout || exit 1   # retried next login
fi
# Dark by default: a new account (no look of its own yet) starts in Fennek OS Dark. Welcome, Settings and the action
# center's Dark mode tile switch it any time. (The system-wide default stays the light one underneath.)
# (The file itself, read directly: kreadconfig6 would mix in the system-wide default and always find a look.)
if ! grep -qs '^LookAndFeelPackage=' "${XDG_CONFIG_HOME:-$HOME/.config}/kdeglobals"; then
    plasma-apply-lookandfeel --apply org.fennek.dark.desktop || exit 1   # retried next login
    # and record the choice in the account's own file, so later steps see dark, not the system-wide light default
    kwriteconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage org.fennek.dark.desktop
    kwriteconfig6 --file plasmarc --group Theme --key name fennek-dark   # the dark taskbar and Start too
fi
/usr/libexec/fennek-desktop-icons   # This PC and Recycle Bin on the desktop
# Files: classic menu bar. On its own first start Files hides it; so new users start as "already set up": the
# window layout Files makes on that first start (side panels closed), menu bar on.
rc=${XDG_CONFIG_HOME:-$HOME/.config}/dolphinrc
state=${XDG_STATE_HOME:-$HOME/.local/state}/dolphinstaterc
if [ -z "$(kreadconfig6 --file "$rc" --group General --key Version)" ]; then
    kwriteconfig6 --file "$rc" --group General --key Version 202
    kwriteconfig6 --file "$rc" --group MainWindow --key MenuBar Enabled
    mkdir -p "${state%/*}" && kwriteconfig6 --file "$state" --group State --key State "$(cat /usr/share/fennek/files-first-window-state)"
fi
mkdir -p "${stamp%/*}" && touch "$stamp"
# First login only: say hello (pick a look, what keeps you safe, tips). Started from the installer USB instead:
# Install Fennek OS or try it first.
app=welcome; grep -qw rd.live.image /proc/cmdline && command -v liveinst >/dev/null && app=live
(sleep 2; fennek-app "$app") >/dev/null 2>&1 &
