#!/usr/bin/bash
# Screenshots, the classic keys. A picture goes to the clipboard only (paste it anywhere); the notice offers Save
# (to Pictures/Screenshots) and Annotate. Nothing stays after you sign out unless you ask.
#   copy    PrtSc: the whole screen        window  Alt+PrtSc: the active window
#   region  Super+Shift+S: drag a box (a plain click or Escape: nothing happens)
#   save    Super+PrtSc: the whole screen, saved straight away
set -u
case ${1:-} in
    copy | save) what=--fullscreen ;;
    window) what=--activewindow ;;
    region) what=--region ;;
    *) echo "usage: fennek-printscreen copy|window|region|save" >&2; exit 2 ;;
esac
tmp=$(mktemp --suffix=.png); trap 'rm -f "$tmp"' EXIT
spectacle --background --nonotify "$what" --output "$tmp" >/dev/null 2>&1
[ -s "$tmp" ] || exit 0                                   # cancelled
if [ "$1" = region ]; then                                # a click, not a box: the snipping tool took the whole screen
    size=$(magick identify -format '%wx%h' "$tmp" 2>/dev/null)
    screens=$(kscreen-doctor -j 2>/dev/null | python3 -c '
import json, sys
for o in json.load(sys.stdin).get("outputs", []):
    m = next((m for m in o.get("modes", []) if m.get("id") == o.get("currentModeId")), None)
    if o.get("enabled") and m:
        print("{}x{}".format(m["size"]["width"], m["size"]["height"]))')
    grep -qxF -- "$size" <<<"$screens" && exit 0
fi

dir=$(kreadconfig6 --file spectaclerc --group ImageSave --key imageSaveLocation)
dir=${dir#file://}; [ -n "$dir" ] || dir=$(xdg-user-dir PICTURES)/Screenshots
save() {
    mkdir -p -- "$dir"
    dest=$dir/Screenshot_$(date +%Y%m%d_%H%M%S).png
    cp -- "$tmp" "$dest"
}
if [ "$1" = save ]; then
    save
    a=$(notify-send -a "Screenshot" -i "$dest" -h "string:image-path:$dest" --action=default=Open --action=folder="Show in folder" \
        --wait "Screenshot saved" "In ${dir##*/}.")
    case $a in
        default) xdg-open "$dest" ;;
        folder) dolphin --select "$dest" ;;
    esac
    exit 0
fi

# For the notice's picture and its buttons: in memory (/run), for as long as the notice stays in the action center.
latest=${XDG_RUNTIME_DIR:-/tmp}/fennek-screenshot-$$.png
mv -- "$tmp" "$latest"; tmp=$latest
wl-copy --type image/png <"$latest"
a=$(notify-send -a "Screenshot" -i "$latest" -h "string:image-path:$latest" --action=default=Open --action=save=Save --action=edit=Annotate \
    --wait "Screenshot copied" "Paste it anywhere.")
case $a in
    save) save; notify-send -a "Screenshot" -i "$dest" -t 4000 "Screenshot saved" "In ${dir##*/}." ;;
    edit | default) save; spectacle --edit-existing "$dest" ;;
esac
exit 0
