#!/usr/bin/python3
"""Write a new user's Files sidebar in the classic order (only when they have none yet):
This PC, pinned folders, Network, Recycle Bin. Removable drives (USB sticks) appear on their own; KDE's
"Devices" group (internal and system partitions) stays hidden: drives are on the This PC page.

Written with KDE's current places format version (4), so KDE doesn't add its own defaults on top.

  fennek-first-login-places FILE
  fennek-first-login-places --ensure-thispc FILE   existing sidebar: This PC on top if missing, hide "Devices"
  fennek-first-login-places --selftest
"""
import os, subprocess, sys
from xml.sax.saxutils import escape, quoteattr
from urllib.parse import quote


def xdg(kind):
    try:
        out = subprocess.run(["xdg-user-dir", kind], capture_output=True, text=True).stdout.strip()
    except OSError:
        return None
    return out if out and out != os.path.expanduser("~") and os.path.isdir(out) else None


def places(folders):
    """folders: [(label, path, icon)] -> xbel text."""
    items = [("This PC", "thispc:/", "computer")]   # on top: Files opens here
    items += [(label, "file://" + quote(path), icon) for label, path, icon in folders]
    items += [("Network", "remote:/", "folder-network"), ("Recycle Bin", "trash:/", "user-trash")]
    out = ['<?xml version="1.0" encoding="UTF-8"?>', "<!DOCTYPE xbel>",
           '<xbel xmlns:bookmark="http://www.freedesktop.org/standards/desktop-bookmarks" '
           'xmlns:mime="http://www.freedesktop.org/standards/shared-mime-info" xmlns:kdepriv="http://www.kde.org/kdepriv">',
           ' <info>', '  <metadata owner="http://www.kde.org">', '   <kde_places_version>4</kde_places_version>',
           '   ' + HIDE_DEVICES, '  </metadata>', ' </info>']
    for n, (label, href, icon) in enumerate(items):
        out += [f" <bookmark href={quoteattr(href)}>", f"  <title>{escape(label)}</title>", "  <info>",
                f'   <metadata owner="http://freedesktop.org"><bookmark:icon name={quoteattr(icon)}/></metadata>',
                f'   <metadata owner="http://www.kde.org"><ID>fennek/{n}</ID></metadata>', "  </info>", " </bookmark>"]
    return "\n".join(out + ["</xbel>", ""])


HIDE_DEVICES = "<GroupState-Devices-IsHidden>true</GroupState-Devices-IsHidden>"
THISPC = (' <bookmark href="thispc:/">\n  <title>This PC</title>\n  <info>\n'
          '   <metadata owner="http://freedesktop.org"><bookmark:icon name="computer"/></metadata>\n'
          '   <metadata owner="http://www.kde.org"><ID>fennek/thispc</ID></metadata>\n  </info>\n </bookmark>\n')


def ensure_thispc(text):
    """Existing sidebar (KDE's places file): This PC as the first place, if missing. Everything else stays."""
    if 'href="thispc:/"' in text or "<bookmark" not in text:
        return text
    i = text.index("<bookmark")
    i = text.rindex("\n", 0, i) + 1   # start of that line
    return text[:i] + THISPC + text[i:]


def hide_devices(text):
    """Existing sidebar: hide KDE's internal "Devices" group (boot/EFI/system partitions), once."""
    if "GroupState-Devices-IsHidden" in text or "</kde_places_version>" not in text:
        return text
    i = text.index("</kde_places_version>") + len("</kde_places_version>")
    return text[:i] + "\n   " + HIDE_DEVICES + text[i:]


def main(path):
    folders = []
    for kind, icon in (("DESKTOP", "user-desktop"), ("DOWNLOAD", "folder-download"), ("DOCUMENTS", "folder-documents"),
                       ("PICTURES", "folder-pictures"), ("MUSIC", "folder-music"), ("VIDEOS", "folder-videos")):
        d = xdg(kind)
        if d:
            folders.append((os.path.basename(d), d, icon))   # names in the user's language
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".fennek-new"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(places(folders))
    os.replace(tmp, path)


def selftest():
    import xml.dom.minidom
    x = places([("Документи", "/var/home/u/Документи", "folder-documents"), ("A & B", "/var/home/u/A & B", "folder")])
    doc = xml.dom.minidom.parseString(x)
    hrefs = [b.getAttribute("href") for b in doc.getElementsByTagName("bookmark")]
    assert hrefs[0] == "thispc:/" and hrefs[3:] == ["remote:/", "trash:/"]
    assert hrefs[1] == "file:///var/home/u/%D0%94%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D0%B8", hrefs[1]
    assert hrefs[2] == "file:///var/home/u/A%20%26%20B"
    assert doc.getElementsByTagName("title")[2].firstChild.data == "A & B"
    assert doc.getElementsByTagName("kde_places_version")[0].firstChild.data == "4"
    old = '<xbel>\n <info/>\n <bookmark href="file:///home/u">\n  <title>Home</title>\n </bookmark>\n</xbel>\n'
    new = ensure_thispc(old)
    assert new.index('href="thispc:/"') < new.index('href="file:///home/u"') and ensure_thispc(new) == new
    xml.dom.minidom.parseString(new.replace("<xbel>", '<xbel xmlns:bookmark="x">'))
    assert HIDE_DEVICES in x
    v4 = '<info>\n  <metadata owner="http://www.kde.org">\n   <kde_places_version>4</kde_places_version>\n  </metadata>\n</info>'
    assert hide_devices(v4).count(HIDE_DEVICES) == 1 and hide_devices(hide_devices(v4)) == hide_devices(v4)
    print("selftest ok")


if __name__ == "__main__":
    if sys.argv[1:] == ["--selftest"]:
        selftest()
    elif len(sys.argv) == 3 and sys.argv[1] == "--ensure-thispc":
        p = sys.argv[2]
        t = open(p, encoding="utf-8").read()
        new = hide_devices(ensure_thispc(t))
        if new != t:
            with open(p + ".fennek-new", "w", encoding="utf-8") as f:
                f.write(new)
            os.replace(p + ".fennek-new", p)
    elif len(sys.argv) == 2:
        main(sys.argv[1])
    else:
        sys.exit(__doc__)
