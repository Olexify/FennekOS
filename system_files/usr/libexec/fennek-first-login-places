#!/usr/bin/python3
"""Write a new user's Files sidebar (only when they have none yet): Home, pinned folders, Network, Recycle Bin.
Removable drives (USB sticks) appear on their own; KDE's "Devices" group (internal and system partitions) stays
hidden: drives are on the Home page.

Written with KDE's current places format version (4), so KDE doesn't add its own defaults on top.

  fennek-first-login-places FILE
  fennek-first-login-places --ensure-home FILE     existing sidebar: Home on top (an older "This PC" entry goes),
                                                   hide "Devices" and "Recent", the bin called Recycle Bin (English)
  fennek-first-login-places --selftest
"""
import os, re, subprocess, sys
from xml.sax.saxutils import escape, quoteattr
from urllib.parse import quote


def xdg(kind):
    try:
        out = subprocess.run(["xdg-user-dir", kind], capture_output=True, text=True).stdout.strip()
    except OSError:
        return None
    return out if out and out != os.path.expanduser("~") and os.path.isdir(out) else None


def places(folders, home=None):
    """folders: [(label, path, icon)] -> xbel text."""
    home = home or os.path.expanduser("~")
    items = [("Home", "file://" + quote(home), "user-home")]   # on top: Files opens here
    items += [(label, "file://" + quote(path), icon) for label, path, icon in folders]
    items += [("Network", "remote:/", "folder-network"), ("Recycle Bin", "trash:/", "user-trash")]
    out = ['<?xml version="1.0" encoding="UTF-8"?>', "<!DOCTYPE xbel>",
           '<xbel xmlns:bookmark="http://www.freedesktop.org/standards/desktop-bookmarks" '
           'xmlns:mime="http://www.freedesktop.org/standards/shared-mime-info" xmlns:kdepriv="http://www.kde.org/kdepriv">',
           ' <info>', '  <metadata owner="http://www.kde.org">', '   <kde_places_version>4</kde_places_version>',
           '   ' + HIDE_DEVICES, '   ' + HIDE_RECENT, '   ' + KDE_DONE, '  </metadata>', ' </info>']
    for n, (label, href, icon) in enumerate(items):
        out += [f" <bookmark href={quoteattr(href)}>", f"  <title>{escape(label)}</title>", "  <info>",
                f'   <metadata owner="http://freedesktop.org"><bookmark:icon name={quoteattr(icon)}/></metadata>',
                f'   <metadata owner="http://www.kde.org"><ID>fennek/{n}</ID></metadata>', "  </info>", " </bookmark>"]
    return "\n".join(out + ["</xbel>", ""])


HIDE_DEVICES = "<GroupState-Devices-IsHidden>true</GroupState-Devices-IsHidden>"
HIDE_RECENT = "<GroupState-RecentlySaved-IsHidden>true</GroupState-RecentlySaved-IsHidden>"
# KDE adds its "Recent" places (and shows that group again) the first time unless these say it already did.
KDE_DONE = "<withRecentlyUsed>true</withRecentlyUsed><withBaloo>true</withBaloo>"
def ensure_home(text, home):
    """Existing sidebar (KDE's places file): Home as the first place (shown again if an earlier Fennek hid it); an
    older "This PC" entry goes (Home is that page now). Everything else stays."""
    i = text.find('<bookmark href="thispc:/">')
    if i >= 0:
        j = text.index("</bookmark>", i) + len("</bookmark>")
        i = text.rindex("\n", 0, i) + 1
        if text[j:j + 1] == "\n":
            j += 1
        text = text[:i] + text[j:]
    href = "href=" + quoteattr("file://" + quote(home))
    k = text.find("<bookmark " + href + ">")
    if k >= 0:
        e = text.index("</bookmark>", k)
        text = text[:k] + text[k:e].replace("<IsHidden>true</IsHidden>", "") + text[e:]
        return text
    if "<bookmark" not in text:
        return text
    k = text.rindex("\n", 0, text.index("<bookmark")) + 1
    entry = (f" <bookmark {href}>\n  <title>Home</title>\n  <info>\n"
             '   <metadata owner="http://freedesktop.org"><bookmark:icon name="user-home"/></metadata>\n'
             '   <metadata owner="http://www.kde.org"><ID>fennek/home</ID></metadata>\n  </info>\n </bookmark>\n')
    return text[:k] + entry + text[k:]


def hide_group(text, tag):
    """Existing sidebar: hide one of KDE's groups (tag = HIDE_DEVICES / HIDE_RECENT), once."""
    name = tag[1:tag.index(">")]
    if f"<{name}>false</{name}>" in text:   # KDE set it shown when it added its own entries
        return text.replace(f"<{name}>false</{name}>", tag, 1)
    if name in text or "</kde_places_version>" not in text:
        return text
    i = text.index("</kde_places_version>") + len("</kde_places_version>")
    return text[:i] + "\n   " + tag + text[i:]


def hide_devices(text):
    """KDE's internal "Devices" group (boot/EFI/system partitions): drives are on This PC; USB sticks still show."""
    return hide_group(text, HIDE_DEVICES)


def ui_language():
    """The display language picked in Settings (Plasma's own setting), else the session's."""
    import configparser
    c = configparser.ConfigParser(interpolation=None, strict=False)
    try:
        c.read(os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "plasma-localerc"))
        lang = c.get("Translations", "LANGUAGE", fallback="")
    except configparser.Error:
        lang = ""
    return lang or os.environ.get("LANG", "")


def recycle_bin(text):
    """English: the bin is "Recycle Bin" (KDE says Trash / Wastebin). Its stored title is only used once it is no
    longer a translated system entry."""
    i = text.find('<bookmark href="trash:/">')
    if i < 0:
        return text
    j = text.index("</bookmark>", i)
    b = text[i:j]
    b = re.sub(r"<title>[^<]*</title>", "<title>Recycle Bin</title>", b, count=1)
    b = b.replace("<IsSystemItem>true</IsSystemItem>", "<IsSystemItem>false</IsSystemItem>")
    return text[:i] + b + text[j:]


def main(path):
    folders = []
    for kind, icon in (("DESKTOP", "user-desktop"), ("DOWNLOAD", "folder-download"), ("DOCUMENTS", "folder-documents"),
                       ("PICTURES", "folder-pictures"), ("MUSIC", "folder-music"), ("VIDEOS", "folder-videos")):
        d = xdg(kind)
        if d:
            folders.append((os.path.basename(d), d, icon))   # names in the user's language
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".fennek-new"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(places(folders))
    os.replace(tmp, path)


def selftest():
    import xml.dom.minidom
    x = places([("Документи", "/var/home/u/Документи", "folder-documents"), ("A & B", "/var/home/u/A & B", "folder")], "/var/home/u")
    doc = xml.dom.minidom.parseString(x)
    hrefs = [b.getAttribute("href") for b in doc.getElementsByTagName("bookmark")]
    assert hrefs[0] == "file:///var/home/u" and hrefs[3:] == ["remote:/", "trash:/"]
    assert hrefs[1] == "file:///var/home/u/%D0%94%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D0%B8", hrefs[1]
    assert hrefs[2] == "file:///var/home/u/A%20%26%20B"
    assert doc.getElementsByTagName("title")[2].firstChild.data == "A & B"
    assert doc.getElementsByTagName("kde_places_version")[0].firstChild.data == "4"
    old = '<xbel>\n <info/>\n <bookmark href="file:///home/u">\n  <title>Home</title>\n </bookmark>\n</xbel>\n'
    pc = ('<xbel>\n <bookmark href="thispc:/">\n  <title>This PC</title>\n </bookmark>\n <bookmark href="file:///home/u">\n'
          '  <title>Home</title>\n  <info><metadata owner="http://www.kde.org"><IsHidden>true</IsHidden></metadata></info>\n'
          ' </bookmark>\n</xbel>\n')
    new = ensure_home(pc, "/home/u")
    assert "thispc:/" not in new and "IsHidden" not in new and ensure_home(new, "/home/u") == new, new
    added = ensure_home('<xbel>\n <bookmark href="trash:/">\n  <title>Bin</title>\n </bookmark>\n</xbel>\n', "/home/u")
    assert added.index('href="file:///home/u"') < added.index('href="trash:/"')
    xml.dom.minidom.parseString(added.replace("<xbel>", '<xbel xmlns:bookmark="x">'))
    assert HIDE_DEVICES in x
    v4 = '<info>\n  <metadata owner="http://www.kde.org">\n   <kde_places_version>4</kde_places_version>\n  </metadata>\n</info>'
    assert hide_devices(v4).count(HIDE_DEVICES) == 1 and hide_devices(hide_devices(v4)) == hide_devices(v4)
    both = hide_group(hide_devices(v4), HIDE_RECENT)
    assert both.count(HIDE_RECENT) == 1 and both.count(HIDE_DEVICES) == 1
    shown = v4.replace("</kde_places_version>", "</kde_places_version><GroupState-RecentlySaved-IsHidden>false</GroupState-RecentlySaved-IsHidden>")
    assert hide_group(shown, HIDE_RECENT).count(HIDE_RECENT) == 1 and "IsHidden>false" not in hide_group(shown, HIDE_RECENT)
    assert "<withRecentlyUsed>true</withRecentlyUsed>" in x
    kde = (' <bookmark href="trash:/">\n  <title>Trash</title>\n  <info>\n   <metadata owner="http://www.kde.org">'
           '<IsSystemItem>true</IsSystemItem></metadata>\n  </info>\n </bookmark>\n')
    r = recycle_bin(kde)
    assert "<title>Recycle Bin</title>" in r and "<IsSystemItem>false</IsSystemItem>" in r and recycle_bin(r) == r
    assert recycle_bin(old) == old
    print("selftest ok")


if __name__ == "__main__":
    if sys.argv[1:] == ["--selftest"]:
        selftest()
    elif len(sys.argv) == 3 and sys.argv[1] in ("--ensure-home", "--ensure-thispc"):
        p = sys.argv[2]
        t = open(p, encoding="utf-8").read()
        new = hide_group(hide_devices(ensure_home(t, os.path.expanduser("~"))), HIDE_RECENT)
        if ui_language().startswith("en"):
            new = recycle_bin(new)
        if new != t:
            with open(p + ".fennek-new", "w", encoding="utf-8") as f:
                f.write(new)
            os.replace(p + ".fennek-new", p)
    elif len(sys.argv) == 2:
        main(sys.argv[1])
    else:
        sys.exit(__doc__)
