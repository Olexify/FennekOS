#!/usr/bin/python3 -u
"""Boot guard: an update that doesn't start properly on this computer undoes itself, without anyone having to do a thing.

A new version gets two tries. The boot loader counts them (boot-guard.cfg), so even a version that never gets as far as
starting anything falls back by itself; a version that starts but brings up no desktop is caught here. Only ever acts on
a freshly installed update, and only on a computer whose desktop has been seen working before: a PC that never shows a
desktop (no screen, say) isn't "broken", and an old version is never rolled back on its own.

Crashes, panics and power cuts use up a try. A clean restart during the watch doesn't (the sign-in screen's Restart button
needs no account): the tries are put back on the way down. Someone signed in proves the desktop came up, there and then.
Starting an older version from the boot menu proves nothing about the new one: it stays first, with the tries it has left.
With none left that start is where the boot loader would fall back to anyway, so it goes back there and then.

Going back can be cut short at any moment. The tries are full before the list of versions changes, so whatever comes first
afterwards simply starts and gets checked: the boot loader never takes "menu entry 1" from a list that has moved.

/boot can be read-only for the whole system: this process writes to it through a private view, nobody else sees a change.

  fennek-boot-guard arm        at shutdown: if an update was really put in place, give it its tries
  fennek-boot-guard check      at every start: did this version come up? (no-op on ordinary starts)
  fennek-boot-guard vet        after an update was downloaded: one that already failed here isn't installed again, and none
                               while the running version is unproven: it would push out the one that's known to work
  fennek-boot-guard --selftest
"""
import json, os, shutil, signal, subprocess, sys, time

GRUB = "/boot/grub2"
STATE = "/var/lib/fennek/boot-guard"
WORKED = STATE + "/desktop-worked"
ROLLED_BACK = STATE + "/rolled-back"   # JSON {"digest", "version", "when"}: the sign-in notice and "vet" read it
WENT_BACK = "/run/fennek-boot-guard-went-back"   # this start ends by going back: no tries for what that made the default
TRIES = 2
WAIT = 300        # seconds a new version has to bring up the sign-in screen or a desktop
STEADY = 30       # ... and keep the sign-in screen up this long
BUSY = 600        # seconds to keep asking rpm-ostree, which refuses during a transaction
SIGNED_IN = "signed in"


def sh(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True, errors="replace")


def boot_writable(boot="/boot"):
    """A writable /boot for this process alone (what ostree itself does). Every command of a service starts with the
    system's view again, so this also goes for "arm", right after the update was put in place."""
    if os.access(boot, os.W_OK):
        return
    try:
        os.unshare(os.CLONE_NEWNS)
    except OSError as e:
        print(f"no private view of {boot}: {e}")
        return
    for cmd in (("mount", "--make-rprivate", "/"), ("mount", "-o", "remount,rw", boot)):
        r = sh(*cmd)
        if r.returncode:
            print(f"{' '.join(cmd)}: {r.stderr.strip()}")


def hold_boot():
    """An automounted /boot would time out during the watch and take this service down with it (RequiresMountsFor=).
    A file held open keeps it up, in the system's view: the automounter doesn't see into private ones."""
    os.open("/boot", os.O_RDONLY)


def parse_env(text):
    return dict(l.split("=", 1) for l in text.splitlines() if "=" in l and not l.startswith("#"))


def read_env():
    try:
        with open(GRUB + "/grubenv", encoding="utf-8", errors="replace") as f:
            return parse_env(f.read())
    except OSError:
        return {}


def editenv(*args):
    boot_writable()
    r = sh("grub2-editenv", GRUB + "/grubenv", *args)
    if r.returncode:
        print(f"couldn't change the boot loader's settings ({' '.join(args)}): {r.stderr.strip()}")
    return r.returncode == 0


def install_grub_part(grub=GRUB, ours="/usr/share/fennek/boot-guard.cfg"):
    """The boot loader's part. custom.cfg is the one file its configuration always reads and updates leave alone."""
    shutil.copyfile(ours, grub + "/fennek-boot-guard.cfg")
    custom, line = grub + "/custom.cfg", "source $prefix/fennek-boot-guard.cfg"
    old = open(custom, encoding="utf-8").read() if os.path.exists(custom) else ""
    if line not in old:
        with open(custom, "a", encoding="utf-8") as f:
            f.write(("" if old.endswith("\n") or not old else "\n") + line + "\n")


def status():
    """What rpm-ostree says, {} if it can't say."""
    try:
        return json.loads(sh("rpm-ostree", "status", "--json").stdout)
    except ValueError:
        return {}


def deployments():
    """rpm-ostree's list, in boot order: a waiting update comes first."""
    return status().get("deployments", [])


def keep_trying(attempt, wait=BUSY, sleep=time.sleep):
    """True as soon as attempt() works, False if it still doesn't after `wait` seconds."""
    for _ in range(wait // 15):
        if attempt():
            return True
        sleep(15)
    return attempt()


def in_menu(deps):
    """The boot menu, in order: a waiting update isn't in it yet."""
    return [d for d in deps if not d.get("staged")]


def not_default(deps):
    """Is something other than the running version first in the boot menu? False if that can't be told."""
    menu = in_menu(deps)
    return bool(menu) and not menu[0].get("booted")


def plan_back(deps, fell_back):
    """Which deployment has to be the default again and which one failed: (back_to, failed) or None.
    A waiting update is neither: it has never run."""
    live = in_menu(deps)
    booted = next((i for i, d in enumerate(live) if d.get("booted")), None)
    if booted is None:
        return None
    if booted > 0:                 # the boot loader already fell back to this one, or else someone chose another default
        return (live[booted], live[0]) if fell_back else None
    return (live[1], live[0]) if len(live) > 1 else None


def index_of(deps, dep):
    """Its index for `ostree admin set-default`, which counts everything listed, a waiting update too."""
    return next((i for i, d in enumerate(deps) if "id" in d and d["id"] == dep.get("id")), None)


def remember_failed(dep):
    try:
        os.makedirs(STATE, exist_ok=True)
        tmp = ROLLED_BACK + ".new"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({"digest": dep.get("container-image-reference-digest", ""), "version": dep.get("version", ""),
                       "when": int(time.time())}, f)
        os.chmod(tmp, 0o644)
        os.replace(tmp, ROLLED_BACK)
    except OSError as e:
        print(f"couldn't remember which version failed: {e}")


def go_back(fell_back=False):
    """True if the failed version is off the boot order. If not, the next start tries again."""
    # During a transaction rpm-ostree refuses, and set-default waits for the end and then applies its index to a list that
    # has changed. So nothing is touched until it's over, however long that takes. A restart before then: the tries decide.
    while status().get("transaction"):
        time.sleep(15)
    deps = deployments()
    plan = plan_back(deps, fell_back)
    if plan:
        back_to, failed = plan
        # The boot loader takes tries=0 as "menu entry 1", which stops being the previous version (or any version) as soon
        # as the list changes. With full tries, whatever comes first after an interruption just starts and gets checked.
        if not editenv("set", f"fennek_tries={TRIES}") or not editenv("unset", "fennek_fell_back"):
            return False
        remember_failed(failed)
        # Everything ahead of the running version goes: a waiting update and, once the boot loader fell back, the failed
        # version itself. So the index comes from the list as it is now. If this was refused, set-default also drops a
        # waiting update when something else becomes the default.
        sh("rpm-ostree", "cleanup", "--pending")
        index = index_of(deployments(), back_to)
        if index:
            sh("ostree", "admin", "set-default", str(index))
        # The list decides, not set-default's exit code: it can fail after the swap, and a transaction that started just
        # now can move the index while it waits for the lock.
        if index_of(in_menu(deployments()), back_to) != 0:
            print("couldn't make the previous version the default again")
            return False
    elif not deps:
        print("couldn't read the list of installed versions")
        return False
    editenv("unset", "fennek_tries", "fennek_fell_back")
    return bool(plan)


def read_desktop(ps_output, dm_active):
    """What's up: someone's desktop (SIGNED_IN), the sign-in screen's compositor (its process id, user sddm) or nothing."""
    rows = [l.split() for l in ps_output.splitlines()]
    rows = [(int(r[0]), r[1]) for r in rows if len(r) == 2 and r[0].isdigit()]
    if any(uid >= 1000 for uid, _ in rows):
        return SIGNED_IN
    return rows[0][1] if rows and dm_active else None


def desktop_running():
    ps = sh("ps", "-C", "kwin_wayland", "-o", "uid=", "-o", "pid=").stdout
    return read_desktop(ps, sh("systemctl", "is-active", "display-manager.service").stdout.strip() == "active")


def wait_for_desktop(running=desktop_running, wait=WAIT, steady=STEADY, sleep=time.sleep):
    """True at once for someone signed in (killing their own compositor later proves nothing), else once the same
    sign-in screen compositor has stayed up for `steady` seconds."""
    seen, since, t = None, 0, 0
    while t <= wait:
        now = running()
        if now == SIGNED_IN:
            return True
        if now and now == seen:
            if t - since >= steady:
                return True
        else:
            seen, since = now, t
        sleep(5)
        t += 5
    return False


def clean_stop(*_):
    """SIGTERM during the watch: a clean restart or shutdown, which isn't a failed try."""
    editenv("set", f"fennek_tries={TRIES}")
    print("stopped cleanly during the watch: this start doesn't count")
    sys.exit(0)


def check():
    hold_boot()
    env = read_env()
    fell_back = "fennek_fell_back" in env
    armed = "fennek_tries" in env and not fell_back
    if armed:
        signal.signal(signal.SIGTERM, clean_stop)
    picked = armed and not_default(deployments())   # the boot menu's other entry: says nothing about the new version
    # The boot loader gave up on the new version, or would on the next start: this is the previous one. A session must not
    # go on with no tries left: the list can change in it ("Go back"), and then 0 means the wrong boot menu entry.
    if fell_back or (picked and env["fennek_tries"] == "0"):
        signal.signal(signal.SIGTERM, signal.SIG_DFL)
        print("the new version didn't start: staying on this one")
        go_back(fell_back=True)
        return
    if picked:
        print("an older version was picked at the start: the new one keeps the tries it has left")
        return
    known = os.path.exists(WORKED)
    if known and not armed:
        return
    if armed:
        print("a new version: watching whether it comes up")
    came_up = wait_for_desktop()
    signal.signal(signal.SIGTERM, signal.SIG_DFL)   # the watch is over: going back's own restart must not put tries back
    if came_up:
        os.makedirs(STATE, exist_ok=True)
        open(WORKED, "w").close()
        if armed:
            editenv("unset", "fennek_tries")
            print("the new version came up fine")
    elif armed and known:
        print("the new version brought up no desktop: going back")
        if go_back():
            open(WENT_BACK, "w").close()
            sh("systemctl", "reboot")
    elif armed:
        editenv("unset", "fennek_tries")   # never seen working here: nothing to compare with, nothing to undo


def new_version_first(status_text):
    """From `ostree admin status`, which lists deployments in boot order, "%c %s %s.%d%s" each, details indented below:
    has a new version just gone ahead of the running one (marked "* ")? A (staged) one isn't in place yet."""
    first = status_text.partition("\n")[0]
    return first.startswith("  ") and "(pending)" in first


def arm():
    """Runs after the step that puts a new version in place, which also succeeds with nothing to do (a waiting update
    was discarded, say). Tries on the running version would make two quick restarts boot the previous one."""
    if os.path.exists(WENT_BACK):
        return
    st = sh("ostree", "admin", "status")   # at shutdown there's no rpm-ostree daemon to ask
    if st.returncode or not new_version_first(st.stdout):
        print("no new version was put in place: no tries to give")
        return
    boot_writable()
    install_grub_part()
    if not os.path.exists(GRUB + "/grubenv"):
        editenv("create")
    editenv("set", f"fennek_tries={TRIES}")
    editenv("unset", "fennek_fell_back")


def vet_once(bad):
    """True when settled. The file that starts this shows up while the transaction is still running."""
    st = status()
    if not st or st.get("transaction"):
        return False
    deps = st.get("deployments", [])
    staged = next((d for d in deps if d.get("staged")), None)
    if not staged or not_default(deps):   # the cleanup takes everything ahead of the running version, not just this update
        return True
    failed_here = bad and staged.get("container-image-reference-digest") == bad
    # Put in place now, it would replace the version that's known to work, and the running one is still unproven.
    if not failed_here and "fennek_tries" not in read_env():
        return True
    if sh("rpm-ostree", "cleanup", "--pending").returncode:
        return False
    print("this update already failed to start here: not installing it again" if failed_here
          else "the running version isn't proven yet: this update comes again later")
    return True


def vet():
    try:
        with open(ROLLED_BACK, encoding="utf-8") as f:
            bad = json.load(f).get("digest")
    except (OSError, ValueError):
        bad = None
    if not keep_trying(lambda: vet_once(bad)):
        print("rpm-ostree stayed busy or refused: a downloaded update that shouldn't be installed yet may still be waiting")


def selftest():
    import tempfile
    global sh, boot_writable, hold_boot, wait_for_desktop, keep_trying, install_grub_part
    global GRUB, STATE, WORKED, ROLLED_BACK, WENT_BACK
    assert parse_env("# GRUB Environment Block\nfennek_tries=1\nmenu_auto_hide=1\n######\n") == {"fennek_tries": "1", "menu_auto_hide": "1"}
    new, old, waiting = {"id": "new", "version": "new", "container-image-reference-digest": "sha"}, {"id": "old"}, {"id": "next", "staged": True}
    run_new, run_old = dict(new, booted=True), dict(old, booted=True)
    assert plan_back([run_new, old], False) == (old, run_new), "running the new one: back to the previous"
    assert plan_back([new, run_old], True) == (run_old, new), "the boot loader fell back: keep this one"
    assert plan_back([old, run_new], False) is None, "no fall back and something else is first: someone chose that"
    assert plan_back([waiting, run_new, old], False) == (old, run_new), "a waiting update neither failed nor is the way back"
    assert plan_back([waiting, new, run_old], True) == (run_old, new)
    assert plan_back([run_new], False) is None and plan_back([waiting, run_new], False) is None, "nothing to go back to"
    assert plan_back([], True) is None
    assert not_default([new, run_old]) and not_default([waiting, new, run_old])
    assert not not_default([run_new, old]) and not not_default([waiting, run_new, old]) and not not_default([]), "can't tell: no"
    assert index_of([run_new, old], old) == 1 and index_of([waiting, run_new, old], old) == 2, "a waiting update counts"
    assert index_of([run_old], run_old) == 0 and index_of([run_new], old) is None and index_of([{}], {}) is None
    # `ostree admin status`, as ot-admin-builtin-status.c prints it.
    running = "* default aaa.0\n    Version: 1.0.15\n    origin: <unknown origin type>\n"
    assert new_version_first("  default bbb.0 (pending)\n    Version: 1.0.16\n" + running)
    assert new_version_first("  default bbb.0 (pending) (soft-reboot)\n" + running)
    assert not new_version_first(running + "  default ccc.0 (rollback)\n"), "nothing new: the running one comes first"
    assert not new_version_first("  default bbb.0 (staged)\n" + running), "not put in place"
    assert not new_version_first("  default bbb.0 (finalization locked)\n" + running)
    assert not new_version_first("  default bbb.0 (staged)\n    Version: 1.0 (pending)\n" + running), "the first line says it"
    assert not new_version_first("No deployments.\n") and not new_version_first("")
    # Who owns the compositor: `ps -o uid= -o pid=`.
    assert read_desktop("  1000    4242\n", False) == SIGNED_IN, "someone signed in, whatever else"
    assert read_desktop("   959    2345\n  1001    4242\n", True) == SIGNED_IN
    assert read_desktop("   959    2345\n", True) == "2345", "the sign-in screen"
    assert read_desktop("   959    2345\n", False) is None, "no display manager"
    assert read_desktop("", True) is None and read_desktop("junk\n1000\n", True) is None
    # Steady for STEADY seconds: a compositor that keeps restarting (a new process each time) never counts.
    ticks = {"t": 0}
    def sleep(s): ticks["t"] += s
    assert wait_for_desktop(lambda: "100", 60, 30, sleep)
    ticks["t"] = 0
    assert not wait_for_desktop(lambda: None, 60, 30, sleep), "never up"
    ticks["t"] = 0
    assert not wait_for_desktop(lambda: str(ticks["t"]), 60, 30, sleep), "crashing again and again"
    ticks["t"] = 0
    assert wait_for_desktop(lambda: None if ticks["t"] < 20 else "7", 120, 30, sleep), "up a little later"
    ticks["t"] = 0
    assert wait_for_desktop(lambda: SIGNED_IN, 60, 30, sleep) and ticks["t"] == 0, "someone signed in: right away"
    assert wait_for_desktop(lambda: "7" if ticks["t"] < 10 else SIGNED_IN, 60, 30, sleep) and ticks["t"] == 10
    tried = []
    assert keep_trying(lambda: tried.append(1) or len(tried) == 3, 600, lambda s: None) and len(tried) == 3, "stops when it works"
    tried.clear()
    assert not keep_trying(lambda: tried.append(1), 30, lambda s: None) and len(tried) == 3, "gives up in the end"
    # Everything else with the commands answered from here: what runs, in what order, and what's left behind.
    ran, answers, at_reboot, at_read, during_watch, desktop, writable, retried, mid_watch = [], {}, [], [], [], [True], [], [], []
    world, read = {"deps": [], "transaction": None}, "rpm-ostree status --json"   # the list, as rpm-ostree and ostree treat it
    def save_env(env):
        with open(GRUB + "/grubenv", "w", encoding="utf-8") as f:
            f.writelines(f"{k}={v}\n" for k, v in env.items())
    def fake_sh(*cmd):
        line = " ".join(cmd)
        ran.append(line)
        assert writable or not line.startswith("grub2-editenv"), "/boot isn't writable yet"
        if line in ("systemctl reboot", read):
            (at_reboot if line != read else at_read).append(signal.getsignal(signal.SIGTERM))
        for start, (rc, out) in answers.items():
            if line.startswith(start):
                return subprocess.CompletedProcess(cmd, rc, out() if callable(out) else out, "")
        rc, out, deps = 0, "", world["deps"]
        if line == read:
            out = json.dumps({"deployments": deps, "transaction": world["transaction"]})
        elif line == "rpm-ostree cleanup --pending":   # refused during a transaction; drops all that's ahead of the running one
            rc = 1 if world["transaction"] else 0
            if not rc:
                world["deps"] = deps[next(i for i, d in enumerate(deps) if d.get("booted")):]
        elif line.startswith("ostree admin set-default "):   # gets the lock first, then counts a waiting update too and drops it
            if "at_lock" in world:
                deps.insert(0, world.pop("at_lock"))
            chosen = deps[int(cmd[-1])]
            world["deps"] = [chosen] + [d for d in deps if d is not chosen and not d.get("staged")]
            rc = world.pop("rc_after_swap", 0)
        elif cmd[0] == "grub2-editenv":
            env = read_env()
            for arg in cmd[3:]:
                env.pop(arg.partition("=")[0], None)
                if cmd[2] == "set":
                    env[arg.partition("=")[0]] = arg.partition("=")[2]
            save_env(env)
        return subprocess.CompletedProcess(cmd, rc, out, "")
    sh = fake_sh
    answers.update({"ps -C kwin_wayland": (0, "  959  2345\n"), "systemctl is-active display-manager.service": (3, "inactive\n")})
    assert desktop_running() is None, "the display manager has to be active"
    answers["systemctl is-active display-manager.service"] = (0, "active\n")
    assert desktop_running() == "2345"
    answers["ps -C kwin_wayland"] = (0, "  959  2345\n 1000  4242\n")
    assert desktop_running() == SIGNED_IN
    ran.clear(), answers.clear()
    real_access = os.access
    os.access, os.unshare, os.CLONE_NEWNS = (lambda *_: False), (lambda _: ran.append("unshare")), 0x20000
    boot_writable()
    assert ran == ["unshare", "mount --make-rprivate /", "mount -o remount,rw /boot"], "private first, only then writable"
    ran.clear()
    os.access = lambda *_: True
    boot_writable()
    assert not ran, "already writable: leave it alone"
    os.access = real_access
    boot_writable, hold_boot = (lambda: writable.append(1)), (lambda: None)
    keep_trying = lambda attempt: retried.append(1) or attempt()
    def fake_wait():
        during_watch.append(signal.getsignal(signal.SIGTERM))
        while mid_watch:
            mid_watch.pop()()
        return desktop[0]
    wait_for_desktop = fake_wait
    with tempfile.TemporaryDirectory() as t:
        ours = t + "/ours.cfg"
        open(ours, "w").write("# guard\n")
        install_grub_part(t, ours)
        install_grub_part(t, ours)
        assert open(t + "/custom.cfg").read().count("fennek-boot-guard.cfg") == 1, "added once"
        assert open(t + "/fennek-boot-guard.cfg").read() == "# guard\n"
        open(t + "/custom.cfg", "w").write("menuentry 'mine' {}")   # someone's own entry stays
        install_grub_part(t, ours)
        assert open(t + "/custom.cfg").read() == "menuentry 'mine' {}\nsource $prefix/fennek-boot-guard.cfg\n"
        install_grub_part = lambda: ran.append("install" if writable else "install on a read-only /boot")
        GRUB, STATE, WENT_BACK = t, t + "/state", t + "/went-back"
        WORKED, ROLLED_BACK = STATE + "/desktop-worked", STATE + "/rolled-back"
        edit, cleanup, armed, fell_back = f"grub2-editenv {t}/grubenv ", "rpm-ostree cleanup --pending", "fennek_tries=1\n", "fennek_tries=0\nfennek_fell_back=1\n"
        def ids():
            return [d["id"] for d in world["deps"]]
        def start(grubenv, up, known=True):
            shutil.rmtree(STATE, ignore_errors=True)
            if os.path.exists(WENT_BACK):
                os.remove(WENT_BACK)
            os.makedirs(STATE)
            if known:
                open(WORKED, "w").close()
            open(t + "/grubenv", "w").write(grubenv)
            desktop[0] = up
            for seen in (ran, at_reboot, at_read, during_watch, writable, retried):
                seen.clear()
            check()
            signal.signal(signal.SIGTERM, signal.SIG_DFL)
        # An ordinary start, and a first one.
        start("", True)
        assert not ran and not during_watch
        start("", True, known=False)
        assert not ran and during_watch == [signal.SIG_DFL] and os.path.exists(WORKED)
        # A new version comes up. Only an armed start puts the tries back when stopped, from the first moment.
        world["deps"] = [run_new, old]
        start(armed, True)
        assert during_watch == [clean_stop] and at_read == [clean_stop] and ran == [read, edit + "unset fennek_tries"] and not at_reboot
        start(armed, True, known=False)
        assert during_watch == [clean_stop] and ran == [read, edit + "unset fennek_tries"] and os.path.exists(WORKED)
        # It doesn't, here where a desktop has been seen working. The tries are safe before the list changes.
        start(armed, False)
        assert [c for c in ran if c != read] == [edit + "set fennek_tries=2", edit + "unset fennek_fell_back", cleanup, "ostree admin set-default 1",
                                                 edit + "unset fennek_tries fennek_fell_back", "systemctl reboot"]
        assert at_reboot == [signal.SIG_DFL], "its own restart doesn't put the tries back"
        assert os.path.exists(WENT_BACK) and json.load(open(ROLLED_BACK))["digest"] == "sha"
        assert ids() == ["old", "new"] and read_env() == {}
        # A waiting update: the index is the one set-default understands, whether the cleanup worked or not.
        world["deps"] = [waiting, run_new, old]
        start(armed, False)
        assert "ostree admin set-default 1" in ran and at_reboot and ids() == ["old", "new"]
        answers[cleanup] = (1, "")
        world["deps"] = [waiting, run_new, old]
        start(armed, False)
        assert "ostree admin set-default 2" in ran and at_reboot and ids() == ["old", "new"], "that drops the waiting one too"
        del answers[cleanup]
        # During a transaction nothing is touched, however long it takes: a restart meanwhile leaves it to the tries.
        naps = []
        time.sleep = lambda _: naps.append((set(ran), read_env(), ids(), os.path.exists(ROLLED_BACK))) or world.update(transaction=None)
        world.update(deps=[run_new, old], transaction=["upgrade", ":1.5", "/path"])
        start(armed, False)
        assert naps == [({read}, {"fennek_tries": "1"}, ["new", "old"], False)] and at_reboot and ids() == ["old", "new"]
        naps.clear()
        world.update(deps=[new, run_old], transaction=["upgrade", ":1.5", "/path"])
        start(fell_back, True)
        assert naps == [({read}, {"fennek_tries": "0", "fennek_fell_back": "1"}, ["new", "old"], False)] and ids() == ["old"]
        # One that starts just after that look and ends with an update waiting: set-default gets the lock then, and its index
        # is the running version's by now. The list shows it: not gone back, and full tries for the next start.
        answers[cleanup] = (1, "")
        world.update(deps=[run_new, old], at_lock=waiting)
        start(armed, False)
        assert "ostree admin set-default 1" in ran and not at_reboot and not os.path.exists(WENT_BACK) and read_env() == {"fennek_tries": "2"}
        del answers[cleanup]
        # set-default's last step can fail after the swap: it did go back.
        world.update(deps=[run_new, old], rc_after_swap=1)
        start(armed, False)
        assert at_reboot and ids() == ["old", "new"] and read_env() == {}
        # No way to get there: the next start tries again.
        world["deps"] = [run_new, old]
        answers["ostree admin set-default"] = (1, "")
        start(armed, False)
        assert not at_reboot and not os.path.exists(WENT_BACK) and ids() == ["new", "old"] and read_env() == {"fennek_tries": "2"}
        answers.clear()
        answers[cleanup] = (0, lambda: answers.update({read: (1, "")}) or "")   # after this the list can't be read
        start(armed, False)
        assert not at_reboot and not os.path.exists(WENT_BACK) and not [c for c in ran if "set-default" in c] and read_env() == {"fennek_tries": "2"}
        answers.clear()
        answers[read] = (1, "")
        start(armed, False)
        assert not at_reboot and not [c for c in ran if c.startswith(edit)] and not os.path.exists(ROLLED_BACK) and not os.path.exists(WENT_BACK)
        answers.clear()
        # The tries can't be made safe: the list stays as it is.
        for refused in (edit + "set fennek_tries", edit + "unset fennek_fell_back"):
            answers[refused] = (1, "")
            start(armed, False)
            assert ids() == ["new", "old"] and cleanup not in ran and not at_reboot and not os.path.exists(ROLLED_BACK), refused
            del answers[refused]
        # Nothing to go back to: the tries go, on either path.
        world["deps"] = [run_new]
        start(armed, False)
        assert edit + "unset fennek_tries fennek_fell_back" in ran and read_env() == {} and not at_reboot and not os.path.exists(ROLLED_BACK)
        world["deps"] = [run_old]
        start(fell_back, True)
        assert read_env() == {} and cleanup not in ran and not os.path.exists(ROLLED_BACK)
        # Someone made another version the default during the watch: nothing to undo, and a stale 0 would mean the wrong entry.
        world["deps"] = [run_new, old]
        mid_watch.append(lambda: world.update(deps=[old, run_new]))
        start(armed, False)
        assert ids() == ["old", "new"] and cleanup not in ran and read_env() == {} and not at_reboot and not os.path.exists(ROLLED_BACK)
        # The older version picked in the boot menu: nothing watched, accepted or undone, the new one keeps what it has left.
        world["deps"] = [new, run_old]
        start(armed, True)
        assert ran == [read] and not during_watch and read_env() == {"fennek_tries": "1"} and not os.path.exists(ROLLED_BACK)
        # With nothing left it goes back there and then: a session with tries at 0 and a list that can change is a trap.
        start("fennek_tries=0\n", True)
        assert not during_watch and ids() == ["old"] and read_env() == {} and json.load(open(ROLLED_BACK))["version"] == "new" and not at_reboot
        # Never seen working here: nothing to compare with, nothing to undo.
        world["deps"] = [run_new, old]
        start(armed, False, known=False)
        assert ran == [read, edit + "unset fennek_tries"] and not at_reboot
        # The boot loader fell back: the cleanup takes the failed version too, or set-default moves it behind.
        world["deps"] = [new, run_old]
        start(fell_back, True)
        assert cleanup in ran and not [c for c in ran if "set-default" in c] and ids() == ["old"] and read_env() == {}
        assert json.load(open(ROLLED_BACK))["version"] == "new", "remembered from before the cleanup"
        assert not at_reboot and not os.path.exists(WENT_BACK) and not during_watch
        assert set(at_read) == {signal.SIG_DFL}, "a clean stop here must leave the tries alone: they lead back to this version"
        answers[cleanup] = (1, "")
        world["deps"] = [new, run_old]
        start(fell_back, True)
        assert "ostree admin set-default 1" in ran and ids() == ["old", "new"] and read_env() == {}
        answers.clear()
        # A real SIGTERM during the watch: the tries go back, and that's the end of it.
        wait_for_desktop = lambda: signal.raise_signal(signal.SIGTERM)
        world["deps"] = [run_new, old]
        open(t + "/grubenv", "w").write(armed)
        ran.clear(), writable.clear()
        try:
            check()
            assert False, "it ends here"
        except SystemExit as stop:
            assert not stop.code
        assert ran == [read, edit + "set fennek_tries=2"]
        signal.signal(signal.SIGTERM, signal.SIG_DFL)
        # arm: only for a version really put in place.
        for text, rc in ((running, 0), ("  default bbb.0 (staged)\n" + running, 0), ("  default bbb.0 (pending)\n" + running, 1), ("", 0)):
            answers["ostree admin status"] = (rc, text)
            ran.clear()
            arm()
            assert ran == ["ostree admin status"], text
        answers["ostree admin status"] = (0, "  default bbb.0 (pending)\n" + running)
        ran.clear(), writable.clear()
        arm()
        assert ran == ["ostree admin status", "install", edit + "set fennek_tries=2", edit + "unset fennek_fell_back"]
        os.remove(t + "/grubenv")
        ran.clear()
        arm()
        assert ran[2] == edit + "create"
        open(WENT_BACK, "w").close()
        ran.clear()
        arm()
        assert not ran, "going back's own restart"
        answers.clear()
        # vet: not while busy, and not without trying to remove the one that failed here.
        bad_update, other_update = dict(waiting, **{"container-image-reference-digest": "bad"}), dict(waiting, **{"container-image-reference-digest": "ok"})
        def waits(*deps, transaction=None):
            world.update(deps=list(deps), transaction=transaction)
            ran.clear()
        save_env({})
        waits(bad_update, run_new, transaction=["upgrade", ":1.5", "/path"])
        assert not vet_once("bad") and cleanup not in ran, "a transaction is running"
        answers[read] = (1, "")
        waits(bad_update, run_new)
        assert not vet_once("bad") and cleanup not in ran, "no answer"
        del answers[read]
        waits(other_update, run_new)
        assert vet_once("bad") and cleanup not in ran, "another update is fine"
        waits(run_new, old)
        assert vet_once("bad") and cleanup not in ran, "nothing waiting"
        waits(bad_update, run_new)
        assert vet_once("bad") and cleanup in ran and ids() == ["new"]
        answers[cleanup] = (1, "")
        waits(bad_update, run_new)
        assert not vet_once("bad"), "refused: ask again"
        del answers[cleanup]
        # While the running version is unproven nothing else gets in: put in place, it would push out the proven one.
        save_env({"fennek_tries": "1"})
        waits(other_update, run_new, old)
        assert vet_once(None) and cleanup in ran and ids() == ["new", "old"]
        answers[cleanup] = (1, "")
        waits(other_update, run_new, old)
        assert not vet_once(None), "refused: ask again"
        del answers[cleanup]
        # With the older version picked in the boot menu it can: and the cleanup would take the new one along with it.
        waits(other_update, new, run_old)
        assert vet_once(None) and cleanup not in ran
        waits(bad_update, new, run_old)
        assert vet_once("bad") and cleanup not in ran
        save_env({})
        shutil.rmtree(STATE)
        waits(bad_update, run_new)
        vet()
        assert cleanup not in ran, "nothing failed here"
        os.makedirs(STATE)
        open(ROLLED_BACK, "w").write(json.dumps({"digest": "bad"}))
        retried.clear()
        waits(bad_update, run_new)
        vet()
        assert retried and cleanup in ran
        # Cut off after any command at all, then started again from there as often as it takes. The boot loader never lands on
        # the wrong version or on none (that's the firmware settings), and it ends on the good one, with the bad one remembered.
        wait_for_desktop = fake_wait
        class Cut(BaseException):
            pass
        left = [0]
        def cut_sh(*cmd):
            done = fake_sh(*cmd)
            left[0] -= 1
            if left[0] < 0:
                raise Cut
            return done
        def boot_loader():   # boot-guard.cfg
            env, entry = read_env(), 0
            if env.get("fennek_tries") in ("2", "1"):
                env["fennek_tries"] = str(int(env["fennek_tries"]) - 1)
            elif "fennek_tries" in env:
                entry, env["fennek_fell_back"] = 1, "1"
            save_env(env)
            return entry
        for grubenv, deps, panics in (("fennek_tries=1\n", [run_new, old], False), ("fennek_tries=0\n", [run_new, old], False),
                                      ("fennek_tries=0\n", [waiting, run_new, old], False), (fell_back, [new, run_old], True),
                                      (fell_back, [waiting, new, run_old], True), (fell_back, [new, run_old], False),
                                      ("fennek_tries=0\n", [new, run_old], True)):
            for cut_after in range(30):
                world["deps"], left[0], sh = deps, cut_after, cut_sh
                try:
                    start(grubenv, deps[-1] is run_old)
                    whole = True
                except Cut:
                    whole = False
                sh = fake_sh
                signal.signal(signal.SIGTERM, signal.SIG_DFL)
                for _ in range(12):
                    if not read_env():
                        break
                    menu, entry = in_menu(world["deps"]), boot_loader()   # a waiting update doesn't survive this
                    assert entry < len(menu) and "old" in ids(), (grubenv, cut_after, "the firmware settings or no good version", ids())
                    world["deps"] = [dict(d, booted=i == entry) for i, d in enumerate(menu)]
                    if not panics or menu[entry]["id"] != "new":
                        desktop[0] = menu[entry]["id"] == "old"
                        check()
                        signal.signal(signal.SIGTERM, signal.SIG_DFL)
                assert in_menu(world["deps"])[0]["id"] == "old" and not read_env(), (grubenv, cut_after, ids(), read_env())
                assert json.load(open(ROLLED_BACK))["digest"] == "sha", (grubenv, cut_after)
                if whole:
                    break
            assert whole, "more commands than this test expects"
    print("selftest ok")


if __name__ == "__main__":
    a = sys.argv[1:]
    if a == ["--selftest"]:
        selftest()
    elif a == ["arm"]:
        arm()
    elif a == ["check"]:
        check()
    elif a == ["vet"]:
        vet()
    else:
        sys.exit(__doc__)
