#!/usr/bin/python3
"""Task Manager data: what runs right now, grouped the way people think about it, from the per-unit numbers Linux
already keeps (each app and service runs in its own cgroup).

  Apps                 your apps (app.slice): name and icon from their Start entry
  Background services  your account's helpers (background.slice, user services): their description
  Desktop              the desktop itself (session.slice: taskbar, window manager…), shown, never ended here
  System services      the computer's services (system.slice), shown, ended only by an administrator elsewhere

  fennek-tasks list            JSON: {"cpus", "mem_total", "mem_used", "groups": [{key, name, items: [...]}]}
                               item: {unit, name, icon, desc, cpu (% of the whole computer), mem (bytes),
                               can_end, procs: [{pid, name, mem}]}
  fennek-tasks end UNIT        stop one of your apps or background services
  fennek-tasks kill PID        end one process of yours (asked to close, made to after 3 seconds)
  fennek-tasks freeze|thaw UNIT   pause one of your apps or background services (nothing runs, memory kept) / go on
  fennek-tasks block PID       no internet for the program a process runs (Fennek Firewall)
  fennek-tasks show PID        Open file location: the program's file, selected in Files
  fennek-tasks perf            counters for the Performance graphs (the window turns them into rates)
  fennek-tasks details         every process: pid, name, user, status, cpu, mem, cmd, own
  fennek-tasks users           who is signed in, with their processes' cpu and memory
  fennek-tasks services        every service (the computer's and your account's): unit, desc, active, sub, scope
  fennek-tasks service start|stop|restart system|user UNIT   (the computer's ask for an administrator)
  fennek-tasks --selftest
"""
import json, os, re, subprocess, sys, time

CG = "/sys/fs/cgroup"
UNIT = re.compile(r"^[A-Za-z0-9@_.:\\-]+\.(service|scope)$")


def read(path, default=""):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return default


def cpu_usec(cg):
    for line in read(os.path.join(cg, "cpu.stat")).splitlines():
        k, _, v = line.partition(" ")
        if k == "usage_usec":
            return int(v)
    return 0


def tree_procs(cg):
    """Every process in this cgroup and below (an app may keep helpers in sub-cgroups)."""
    pids = []
    for root, dirs, files in os.walk(cg):
        pids += [int(p) for p in read(os.path.join(root, "cgroup.procs")).split() if p.isdigit()]
    return pids


def proc_info(pid):
    name = read(f"/proc/{pid}/comm").strip() or str(pid)
    if len(name) == 15:   # the kernel keeps 15 characters: the program's own name in full, when it starts the same
        full = os.path.basename(read(f"/proc/{pid}/cmdline").split("\0")[0])
        name = full if full.startswith(name) else name
    rss, uid, state = 0, -1, ""
    for line in read(f"/proc/{pid}/status").splitlines():
        if line.startswith("VmRSS:"):
            rss = int(line.split()[1]) * 1024
        elif line.startswith("Uid:"):
            uid = int(line.split()[1])
        elif line.startswith("State:"):
            state = line.split()[1]
    return {"pid": pid, "name": name, "mem": rss, "uid": uid, "state": state, "own": uid == os.getuid()}


def proc_ticks(pid):
    """utime + stime of one process, in clock ticks (fields after the name, which may hold spaces)."""
    st = read(f"/proc/{pid}/stat")
    rest = st[st.rfind(")") + 2:].split()
    return int(rest[11]) + int(rest[12]) if len(rest) > 12 else 0


def pids():
    return [int(p) for p in os.listdir("/proc") if p.isdigit()]


def user_name(uid, cache={}):
    if uid not in cache:
        import pwd
        try:
            cache[uid] = pwd.getpwuid(uid).pw_name
        except KeyError:
            cache[uid] = str(uid)
    return cache[uid]


STATES = {"R": "Running", "S": "Running", "D": "Waiting", "I": "Running", "T": "Paused", "t": "Paused", "Z": "Ended",
          "X": "Ended"}


def details():
    hz = os.sysconf("SC_CLK_TCK")
    first = {p: proc_ticks(p) for p in pids()}
    t0 = time.monotonic()
    time.sleep(0.5)
    dt = time.monotonic() - t0
    cpus = os.cpu_count() or 1
    out = []
    for p in pids():
        i = proc_info(p)
        if i["uid"] < 0:
            continue   # gone meanwhile
        cpu = max(0.0, (proc_ticks(p) - first.get(p, 0)) / hz / dt / cpus * 100)
        cmd = read(f"/proc/{p}/cmdline").replace("\0", " ").strip()[:300]
        out.append({"pid": p, "name": i["name"], "user": user_name(i["uid"]), "status": STATES.get(i["state"], "Running"),
                    "cpu": round(cpu, 1), "mem": i["mem"], "cmd": cmd, "own": i["own"]})
    return out


def kill(pid):
    """End one process of yours: asked to close (TERM), made to (KILL) if it is still there after 3 seconds."""
    import signal
    if not str(pid).isdigit() or int(pid) <= 1 or proc_info(int(pid))["uid"] != os.getuid():
        sys.exit("only your own processes can be ended here")
    pid = int(pid)
    try:
        os.kill(pid, signal.SIGTERM)
        for _ in range(30):
            time.sleep(0.1)
            os.kill(pid, 0)
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass


def show(pid):
    """Open file location: the program a process runs, selected in Files (only for processes you can see into)."""
    if not str(pid).isdigit():
        sys.exit("not a process")
    try:
        exe = os.readlink(f"/proc/{int(pid)}/exe")
    except OSError:
        sys.exit("Its file can't be shown (it belongs to the system or another user).")
    exe = exe.removesuffix(" (deleted)")
    if not os.path.exists(exe):
        sys.exit("Its file isn't there any more (it was updated or removed since it started).")
    try:
        subprocess.Popen(["dolphin", "--select", exe], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        sys.exit("Files couldn't be opened.")


def perf():
    cpu = []
    for line in read("/proc/stat").splitlines():
        if line.startswith("cpu"):
            v = [int(x) for x in line.split()[1:]]
            cpu.append([sum(v[:8]), v[3] + (v[4] if len(v) > 4 else 0)])   # total, idle + iowait
    mem = {}
    for line in read("/proc/meminfo").splitlines():
        k, _, v = line.partition(":")
        mem[k] = int(v.split()[0]) * 1024 if v.split() else 0
    rd = wr = 0
    for line in read("/proc/diskstats").splitlines():
        f = line.split()
        # whole disks only (sda, nvme0n1, vda, mmcblk0), not their partitions or loop/zram devices
        if len(f) > 9 and re.match(r"^(sd[a-z]+|vd[a-z]+|xvd[a-z]+|nvme\d+n\d+|mmcblk\d+)$", f[2]):
            rd += int(f[5]) * 512
            wr += int(f[9]) * 512
    rx = tx = 0
    for line in read("/proc/net/dev").splitlines()[2:]:
        name, _, v = line.partition(":")
        if name.strip() != "lo" and v.split():
            rx += int(v.split()[0])
            tx += int(v.split()[8])
    model = ""
    for line in read("/proc/cpuinfo").splitlines():
        if line.startswith("model name"):
            model = line.split(":", 1)[1].strip()
            break
    threads = 0
    ps = pids()
    for p in ps:
        for line in read(f"/proc/{p}/status").splitlines():
            if line.startswith("Threads:"):
                threads += int(line.split()[1])
                break
    up = float(read("/proc/uptime", "0").split()[0] or 0)
    total, avail = mem.get("MemTotal", 0), mem.get("MemAvailable", 0)
    return {"cpu": cpu[0] if cpu else [0, 0], "cores": len(cpu) - 1, "cpu_name": model,
            "mem_total": total, "mem_used": total - avail, "mem_cached": mem.get("Cached", 0),
            "swap_total": mem.get("SwapTotal", 0), "swap_used": mem.get("SwapTotal", 0) - mem.get("SwapFree", 0),
            "disk": [rd, wr], "net": [rx, tx], "procs": len(ps), "threads": threads, "uptime": int(up)}


def users():
    """People signed in (loginctl), with what their processes use right now."""
    out = subprocess.run(["loginctl", "list-users", "--no-legend", "--no-pager"], capture_output=True, text=True).stdout
    signed = {int(l.split()[0]): l.split()[1] for l in out.splitlines() if l.split() and l.split()[0].isdigit()}
    if not signed:
        signed = {os.getuid(): user_name(os.getuid())}
    hz = os.sysconf("SC_CLK_TCK")
    first = {p: proc_ticks(p) for p in pids()}
    t0 = time.monotonic()
    time.sleep(0.5)
    dt = time.monotonic() - t0
    cpus = os.cpu_count() or 1
    tot = {u: {"cpu": 0.0, "mem": 0, "procs": 0} for u in signed}
    for p in pids():
        i = proc_info(p)
        if i["uid"] in tot:
            t = tot[i["uid"]]
            t["cpu"] += max(0.0, (proc_ticks(p) - first.get(p, 0)) / hz / dt / cpus * 100)
            t["mem"] += i["mem"]
            t["procs"] += 1
    return [{"uid": u, "name": n, "you": u == os.getuid(), "cpu": round(tot[u]["cpu"], 1), "mem": tot[u]["mem"],
             "procs": tot[u]["procs"]} for u, n in sorted(signed.items())]


def services():
    out = []
    for scope in ("system", "user"):
        cmd = ["systemctl"] + (["--user"] if scope == "user" else []) + \
              ["list-units", "--type=service", "--all", "--no-pager", "--output=json"]
        try:
            units = json.loads(subprocess.run(cmd, capture_output=True, text=True).stdout or "[]")
        except ValueError:
            units = []
        for u in units:
            if UNIT.match(u.get("unit", "")):
                out.append({"unit": u["unit"], "desc": u.get("description", ""), "active": u.get("active", ""),
                            "sub": u.get("sub", ""), "scope": scope})
    return out


def service(action, scope, unit):
    if action not in ("start", "stop", "restart") or scope not in ("system", "user") or not UNIT.match(unit) \
            or not unit.endswith(".service"):
        sys.exit("not a service action")
    cmd = ["systemctl"] + (["--user"] if scope == "user" else []) + [action, "--", unit]
    sys.exit(subprocess.run(cmd).returncode)


def app_id(unit):
    """app-org.kde.dolphin@3f2a.service / app-flatpak-org.mozilla.firefox-12.scope -> org.kde.dolphin / org.mozilla.firefox."""
    u = unit[4:] if unit.startswith("app-") else unit
    u = re.sub(r"\.(scope|service)$", "", u).split("@")[0]
    u = re.sub(r"-\d+$", "", u)
    u = u[8:] if u.startswith("flatpak-") else u
    return u.replace("\\x2d", "-")


def desktop_entries():
    dirs = [os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "applications")]
    dirs += [os.path.join(d, "applications") for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")]
    out = {}
    for d in dirs:
        try:
            names = os.listdir(d)
        except OSError:
            continue
        for n in names:
            if n.endswith(".desktop") and n[:-8] not in out:
                e = {}
                for line in read(os.path.join(d, n)).splitlines():
                    if line.startswith("[") and line != "[Desktop Entry]":
                        break
                    if "=" in line:
                        k, v = line.split("=", 1)
                        e.setdefault(k.strip(), v.strip())
                out[n[:-8]] = (e.get("Name", n[:-8]), e.get("Icon", ""))
    return out


def descriptions(units, user):
    """Unit -> its Description, in one systemctl call."""
    if not units:
        return {}
    cmd = ["systemctl"] + (["--user"] if user else []) + ["show", "-p", "Id,Description", "--"] + units
    out, cur = {}, {}
    for line in subprocess.run(cmd, capture_output=True, text=True).stdout.splitlines() + [""]:
        if not line:
            if "Id" in cur:
                out[cur["Id"]] = cur.get("Description", "")
            cur = {}
        elif "=" in line:
            k, v = line.split("=", 1)
            cur[k] = v
    return out


def units_in(slice_dir):
    try:
        return sorted(u for u in os.listdir(slice_dir) if UNIT.match(u) and os.path.isdir(os.path.join(slice_dir, u)))
    except OSError:
        return []


def plain_processes():
    """Running programs by name, from /proc (memory only), when the system keeps no per-app units."""
    by = {}
    for p in os.listdir("/proc"):
        if p.isdigit():
            i = proc_info(int(p))
            if i["mem"]:
                by.setdefault(i["name"], []).append(i)
    items = [{"name": n, "icon": "", "desc": "", "unit": n, "cpu": 0.0, "mem": sum(x["mem"] for x in ps), "can_end": False,
              "procs": sorted(ps, key=lambda x: -x["mem"])[:30]} for n, ps in by.items()]
    return sorted(items, key=lambda i: -i["mem"])


def snapshot():
    uid = os.getuid()
    user_root = f"{CG}/user.slice/user-{uid}.slice/user@{uid}.service"
    layout = [("apps", "Apps", f"{user_root}/app.slice", True, True),
              ("background", "Background services", f"{user_root}/background.slice", True, True),
              ("desktop", "Desktop", f"{user_root}/session.slice", True, False),
              ("system", "System services", f"{CG}/system.slice", False, False)]
    found = [(key, name, d, user, can, units_in(d)) for key, name, d, user, can in layout]
    first = {(d, u): cpu_usec(os.path.join(d, u)) for _, _, d, _, _, us in found for u in us}
    t0 = time.monotonic()
    time.sleep(0.5)
    dt = (time.monotonic() - t0) * 1e6
    cpus = os.cpu_count() or 1
    apps = desktop_entries()
    groups = []
    for key, gname, d, user, can, us in found:
        desc = descriptions(us, user) if key != "apps" else {}
        items = []
        for u in us:
            cg = os.path.join(d, u)
            procs = [proc_info(p) for p in tree_procs(cg)]
            if not procs:
                continue
            cpu = max(0.0, (cpu_usec(cg) - first.get((d, u), 0)) / dt / cpus * 100)
            mem = int(read(os.path.join(cg, "memory.current"), "0").strip() or 0)
            if key == "apps":
                name, icon = apps.get(app_id(u), (app_id(u), ""))
                item = {"name": name, "icon": icon or "application-x-executable", "desc": ""}
            else:
                text = desc.get(u, "") or re.sub(r"\.(service|scope)$", "", u)
                item = {"name": text, "icon": "", "desc": re.sub(r"\.(service|scope)$", "", u)}
            item.update({"unit": u, "cpu": round(cpu, 1), "mem": mem, "can_end": can,
                         "frozen": read(os.path.join(cg, "cgroup.freeze")).strip() == "1",
                         "procs": sorted(procs, key=lambda p: -p["mem"])[:30]})
            items.append(item)
        items.sort(key=lambda i: (-i["cpu"], -i["mem"]))
        groups.append({"key": key, "name": gname, "items": items})
    if not any(g["items"] for g in groups):   # no per-app units to read (no systemd here): the programs themselves
        groups.append({"key": "procs", "name": "Programs", "items": plain_processes()})
    total = used = 0
    for line in read("/proc/meminfo").splitlines():
        if line.startswith("MemTotal:"):
            total = int(line.split()[1]) * 1024
        elif line.startswith("MemAvailable:"):
            used = total - int(line.split()[1]) * 1024
    return {"cpus": cpus, "mem_total": total, "mem_used": used, "groups": groups}


def own_unit(unit):
    uid = os.getuid()
    base = f"{CG}/user.slice/user-{uid}.slice/user@{uid}.service"
    return UNIT.match(unit) and any(os.path.isdir(f"{base}/{s}/{unit}") for s in ("app.slice", "background.slice"))


def freeze(unit, on):
    """Pause an app (all its processes stop, nothing is lost) or let it go on: systemd's freezer."""
    if not own_unit(unit):
        sys.exit("not one of your apps or background services")
    sys.exit(subprocess.run(["systemctl", "--user", "freeze" if on else "thaw", "--", unit]).returncode)


def block_target(pid):
    """What the firewall should block for a process: a Windows program by its .exe, otherwise the program file."""
    args = read(f"/proc/{pid}/cmdline").split("\0")
    win = [a for a in args if a.lower().endswith(".exe")   # Proton's own helpers aren't the program
           and os.path.basename(a.replace("\\", "/")).lower() not in ("steam.exe", "start.exe", "explorer.exe")]
    if win:
        return win[-1]
    try:
        return os.readlink(f"/proc/{pid}/exe").removesuffix(" (deleted)")
    except OSError:
        return ""


def block(pid):
    if not str(pid).isdigit() or int(pid) <= 1:
        sys.exit("not a process")
    t = block_target(int(pid))
    if not t:
        sys.exit("Its program can't be found (it belongs to the system or another user).")
    sys.exit(subprocess.run(["fennek-firewall", "block", t]).returncode)


def end(unit):
    """Stop one of your apps or background services (never the desktop, never a system service)."""
    uid = os.getuid()
    base = f"{CG}/user.slice/user-{uid}.slice/user@{uid}.service"
    if not UNIT.match(unit) or not any(os.path.isdir(f"{base}/{s}/{unit}") for s in ("app.slice", "background.slice")):
        sys.exit("not one of your apps or background services")
    sys.exit(subprocess.run(["systemctl", "--user", "stop", "--", unit]).returncode)


def selftest():
    assert app_id("app-org.kde.dolphin@3f2a9b.service") == "org.kde.dolphin"
    assert app_id("app-flatpak-org.mozilla.firefox-12345.scope") == "org.mozilla.firefox"
    assert app_id("app-firefox-4711.scope") == "firefox"
    assert app_id("app-org.kde.konsole\\x2dterminal@1.service") == "org.kde.konsole-terminal"
    assert UNIT.match("app-org.kde.dolphin@3f2a.service") and not UNIT.match("../evil.service") and not UNIT.match("x;rm.scope")
    assert any(i["procs"] for i in plain_processes()) or not os.path.isdir("/proc/1")
    d = details()
    assert any(x["pid"] == os.getpid() and x["own"] for x in d), "this process is listed as yours"
    pf = perf()
    assert pf["mem_total"] > 0 and pf["procs"] > 0 and len(pf["cpu"]) == 2
    assert proc_ticks(os.getpid()) >= 0
    for bad in ("1; rm", "../x", ""):
        try:
            kill(bad)
            raise AssertionError("kill accepted " + bad)
        except SystemExit:
            pass
    for bad in ("x", "1;2"):
        try:
            show(bad)
            raise AssertionError("show accepted " + bad)
        except SystemExit:
            pass
    assert not own_unit("../x.service") and not own_unit("x;y.service")
    assert block_target(os.getpid()), "a process's program is found"
    print("selftest ok")


if __name__ == "__main__":
    a = sys.argv[1:]
    if a == ["--selftest"]:
        selftest()
    elif a == ["list"]:
        print(json.dumps(snapshot()))
    elif len(a) == 2 and a[0] == "end":
        end(a[1])
    elif len(a) == 2 and a[0] == "kill":
        kill(a[1])
    elif len(a) == 2 and a[0] in ("freeze", "thaw"):
        freeze(a[1], a[0] == "freeze")
    elif len(a) == 2 and a[0] == "block":
        block(a[1])
    elif len(a) == 2 and a[0] == "show":
        show(a[1])
    elif a == ["perf"]:
        print(json.dumps(perf()))
    elif a == ["details"]:
        print(json.dumps(details()))
    elif a == ["users"]:
        print(json.dumps(users()))
    elif a == ["services"]:
        print(json.dumps(services()))
    elif len(a) == 4 and a[0] == "service":
        service(a[1], a[2], a[3])
    else:
        sys.exit(__doc__)
