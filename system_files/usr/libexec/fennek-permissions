#!/usr/bin/python3
"""App permissions (Settings > Privacy & Security > App permissions): what each app may do outside its box, in plain
switches, for store apps (Flatpak: per-account overrides, `flatpak override --user`) and classic programs (.exe:
fennek-run-exe's sandbox choices and the no-internet list).

  fennek-permissions list                              JSON: {"apps": [...], "programs": [...]}
  fennek-permissions app APP-ID PERM on|off            PERM: network sound devices launch home host
                                                       documents downloads pictures music videos
  fennek-permissions reset APP-ID                      back to what the app asks for itself
  fennek-permissions program SHA256 run sandbox|sandbox-sound|trusted|ask
  fennek-permissions program SHA256 internet on|off    (sandboxed programs)
  fennek-permissions new-apps                          a notice for each app installed since last time, with what it
                                                       may reach (Review opens this page); the first run only records
  fennek-permissions --selftest
"""
import configparser, html, json, os, re, subprocess, sys
from pathlib import Path

CFG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "fennek"
APP_ID = re.compile(r"^[A-Za-z0-9_.-]{3,255}$")
DIGEST = re.compile(r"^[0-9a-f]{64}$")
FOLDERS = {"documents": "xdg-documents", "downloads": "xdg-download", "pictures": "xdg-pictures",
           "music": "xdg-music", "videos": "xdg-videos"}
LAUNCH_BUS = "org.freedesktop.Flatpak"   # flatpak-spawn --host: starting programs outside the box


# ---- store apps -------------------------------------------------------------------------------------------------
def parse(text):
    """Flatpak keyfile (metadata or overrides) -> {"shared": set, "sockets": set, "devices": set,
    "filesystems": set, "talk": set}; negations kept as "!x"."""
    c = configparser.ConfigParser(interpolation=None, strict=False, delimiters=("=",))
    c.optionxform = str
    try:
        c.read_string(text)
    except configparser.Error:
        return {k: set() for k in ("shared", "sockets", "devices", "filesystems", "talk")}
    ctx = c["Context"] if c.has_section("Context") else {}
    split = lambda k: {x for x in ctx.get(k, "").split(";") if x}
    bus = c["Session Bus Policy"] if c.has_section("Session Bus Policy") else {}
    # "own" (acting as that service) is kept apart from "talk" (using it): the safe list only covers talking.
    talk = set()
    for n, v in bus.items():
        talk |= {n} if v == "talk" else {"own:" + n} if v == "own" else {"!" + n, "!own:" + n}
    # The system bus (services running as administrator): never on the safe list, always named.
    sysbus = c["System Bus Policy"] if c.has_section("System Bus Policy") else {}
    talk |= {("sys:" + n) if v in ("talk", "own") else "!sys:" + n for n, v in sysbus.items()}
    return {"shared": split("shared"), "sockets": split("sockets"), "devices": split("devices"),
            "filesystems": split("filesystems"), "talk": talk}


def merge(base, *overrides):
    """What the app may really do: its own permissions with the overrides on top ("!x" takes x away)."""
    out = {k: set(x for x in v if not x.startswith("!")) for k, v in base.items()}
    for o in overrides:
        for k, v in o.items():
            for x in v:
                if x.startswith("!"):
                    if k == "filesystems":   # "!xdg-download" also takes away "xdg-download:ro"
                        name = x[1:].split(":")[0]
                        out[k] = {y for y in out[k] if y.split(":")[0] != name}
                    else:                    # services and the rest: exactly that entry, nothing else
                        out[k].discard(x[1:])
                else:
                    out[k].add(x)
    return out


# What an app may use without it counting as "reach outside its box".
SAFE_SOCKETS = {"wayland", "fallback-x11", "pulseaudio", "x11"}   # x11 is named separately below
SAFE_DEVICES = {"dri", "all"}                                       # "all" is its own switch
SAFE_TALK = re.compile(r"^(org\.freedesktop\.Notifications|org\.kde\.StatusNotifierWatcher|org\.freedesktop\.portal\..*"
                       r"|org\.mpris\.MediaPlayer2\..*|com\.canonical\.AppMenu\.Registrar|org\.freedesktop\.ScreenSaver"
                       r"|org\.kde\.KGlobalSettings|org\.freedesktop\.Flatpak)$")
KNOWN_FS = {"host", "host-os", "host-etc", "home", "~"} | set(FOLDERS.values())


def plain(x):
    """Names come from the app itself: only plain characters are shown (no markup, no look-alike tricks)."""
    x = re.sub(r"/(\./)+", "/", re.sub(r"/{2,}", "/", x))   # tidy paths; always shown in full (the end matters)
    return re.sub(r"[^A-Za-z0-9_.~/:@+-]", "?", x)


def other_access(p, app_id=""):
    """Everything beyond the page's switches and a short safe list, in plain words (so nothing is hidden)."""
    out = []
    fs = sorted(plain(x) for x in {x.split(":")[0] for x in p["filesystems"]} - KNOWN_FS)
    if fs:
        out.append("files at " + ", ".join(fs))
    if "x11" in p["sockets"]:
        out.append("other windows of older apps (X11: it could read their keys)")
    socks = sorted(p["sockets"] - SAFE_SOCKETS)
    if socks:
        out.append("system connections (" + ", ".join(socks) + ")")
    devs = sorted(p["devices"] - SAFE_DEVICES)
    if devs:
        out.append("devices (" + ", ".join(devs) + ")")
    system = sorted(plain(n[4:]) for n in p["talk"] if n.startswith("sys:"))
    if system:
        out.append("system services that run as administrator (" + ", ".join(system) + ")")
    talk = sorted(plain(n) for n in p["talk"] if not n.startswith(("!", "own:", "sys:")) and not SAFE_TALK.match(n))
    if talk:
        out.append("other services (" + ", ".join(talk) + ")")
    owned = sorted(plain(n[4:]) for n in p["talk"] if n.startswith("own:")
                   and not (app_id and (n[4:] == app_id or n[4:].startswith(app_id + "."))))
    if owned:
        out.append("acts as service " + ", ".join(owned))
    return out


def summary(p, app_id=""):
    fs = {x.split(":")[0] for x in p["filesystems"]}
    return {"network": "network" in p["shared"], "sound": "pulseaudio" in p["sockets"],
            "devices": "all" in p["devices"], "launch": LAUNCH_BUS in p["talk"],
            "host": bool(fs & {"host", "host-os", "host-etc"}), "home": "home" in fs or "~" in fs,
            **{k: v in fs for k, v in FOLDERS.items()}, "other": other_access(p, app_id)}


def override_args(perm, on):
    """The `flatpak override --user` options for one switch."""
    if perm == "network":
        return ["--share=network" if on else "--unshare=network"]
    if perm == "sound":
        return ["--socket=pulseaudio" if on else "--nosocket=pulseaudio"]
    if perm == "devices":
        return ["--device=all" if on else "--nodevice=all"]
    if perm == "launch":
        return [f"--talk-name={LAUNCH_BUS}" if on else f"--no-talk-name={LAUNCH_BUS}"]
    if perm == "host":
        return ["--filesystem=host"] if on else ["--nofilesystem=host", "--nofilesystem=host-os", "--nofilesystem=host-etc"]
    if perm == "home":   # off: the whole home and anything wider
        return ["--filesystem=home"] if on else ["--nofilesystem=home", "--nofilesystem=host"]
    if perm in FOLDERS:
        return [f"--filesystem={FOLDERS[perm]}" if on else f"--nofilesystem={FOLDERS[perm]}"]
    raise ValueError(f"unknown permission {perm}")


def run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout


def apps():
    out = []
    for line in run(["flatpak", "list", "--app", "--columns=application,name"]).splitlines():
        app, _, name = line.partition("\t")
        if not APP_ID.match(app) or any(a["id"] == app for a in out):
            continue
        base = parse(run(["flatpak", "info", "--show-metadata", app]))
        p = merge(base, parse(run(["flatpak", "override", "--show", app])),
                  parse(run(["flatpak", "override", "--user", "--show", app])))
        out.append({"id": app, "name": name or app, "perms": summary(p, app),
                    "changed": bool(run(["flatpak", "override", "--user", "--show", app]).strip())})
    return sorted(out, key=lambda a: a["name"].lower())


# ---- classic programs (.exe) ------------------------------------------------------------------------------------
def lines(name):
    f = CFG / name
    return f.read_text(encoding="utf-8", errors="replace").splitlines() if f.is_file() else []


def write(name, rows):
    CFG.mkdir(parents=True, exist_ok=True)
    tmp = CFG / (name + ".new")
    tmp.write_text("".join(r + "\n" for r in rows), encoding="utf-8")
    os.replace(tmp, CFG / name)


def odd_char(c):
    """Control characters and anything a line splitter could treat as a line break: never in a recorded path."""
    o = ord(c)
    return o < 32 or 127 <= o <= 159 or o in (0x2028, 0x2029) or 0xD800 <= o <= 0xDFFF   # also undecodable bytes


def programs():
    names = {}
    raw = (CFG / "exe-names").read_text(encoding="utf-8", errors="replace") if (CFG / "exe-names").is_file() else ""
    for l in raw.split("\n"):   # real line breaks only
        d, _, path = l.partition("\t")
        if DIGEST.match(d) and path.startswith("/") and not any(odd_char(c) for c in path):   # no forged lines
            names[d] = path
    trusted = set(lines("trusted-exes"))
    choices = dict(l.split(" ", 1) for l in lines("exe-choices") if " " in l)
    offline = set(lines("offline-exes"))
    out = []
    for d in sorted(set(names) | trusted | set(choices)):
        if not DIGEST.match(d):
            continue
        path = names.get(d, "")
        out.append({"sha256": d, "name": Path(path).name if path else "Program " + d[:8], "path": path,
                    "run": "trusted" if d in trusted else choices.get(d, "ask"), "internet": d not in offline})
    return out


def set_program(d, what, value):
    if what == "run":
        if value not in ("sandbox", "sandbox-sound", "trusted", "ask"):
            raise ValueError(value)
        write("trusted-exes", [l for l in lines("trusted-exes") if l != d] + ([d] if value == "trusted" else []))
        write("exe-choices", [l for l in lines("exe-choices") if not l.startswith(d + " ")]
              + ([f"{d} {value}"] if value in ("sandbox", "sandbox-sound") else []))
    elif what == "internet":
        if value not in ("on", "off"):
            raise ValueError(value)
        rest = [l for l in lines("offline-exes") if l != d]
        write("offline-exes", rest + ([d] if value == "off" else []))
    else:
        raise ValueError(what)


# ---- new apps -----------------------------------------------------------------------------------------------
def new_apps(current, known):
    """Apps in CURRENT not in KNOWN (both lists of ids); None on the very first run (record only, no notices)."""
    if known is None:
        return None
    return [a for a in current if a not in set(known)]


def notice_new_apps():
    known_file = CFG / "known-apps"
    known = lines("known-apps") if known_file.is_file() else None
    found = apps()
    fresh = new_apps([a["id"] for a in found], known)
    write("known-apps", sorted({a["id"] for a in found} | set(known or [])))
    for a in found:
        if fresh and a["id"] in fresh:
            subprocess.Popen(["sh", "-c", 'r=$(notify-send -a "App permissions" -i "$1" --action=review=Review --wait "$2" "$3"); '
                              '[ "$r" = review ] && exec fennek-app settings permissions', "sh",
                              a["id"], html.escape(a["name"]) + " was installed", "It can reach: " + html.escape(summary_text(a["perms"]))],
                             start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def summary_text(p):
    parts = []
    if p["network"]: parts.append("the internet")
    if p["host"]: parts.append("the whole computer")
    elif p["home"]: parts.append("your home folder")
    else: parts += [k.capitalize() for k in FOLDERS if p[k]]
    if p["sound"]: parts.append("sound and microphone")
    if p["devices"]: parts.append("camera and devices")
    if p["launch"]: parts.append("starting other programs")
    parts += p.get("other", [])
    return ", ".join(parts) if parts else "nothing outside its box"


# ---- check --------------------------------------------------------------------------------------------------
def selftest():
    import tempfile
    global CFG
    meta = ("[Application]\nname=org.example.Launcher\n\n[Context]\nshared=network;ipc;\nsockets=x11;wayland;pulseaudio;\n"
            "devices=dri;\nfilesystems=xdg-download;~/Games:ro;\n\n[Session Bus Policy]\norg.freedesktop.Notifications=talk\n")
    user = "[Context]\nshared=!network;\nfilesystems=home;!xdg-download;\n\n[Session Bus Policy]\norg.freedesktop.Flatpak=talk\n"
    s = summary(merge(parse(meta), parse(""), parse(user)))
    assert s["network"] is False and s["sound"] is True and s["launch"] is True, s
    assert s["home"] is True and s["downloads"] is False and s["devices"] is False and s["host"] is False, s
    s2 = summary(merge(parse(meta), parse("[Context]\nfilesystems=!xdg-download:ro;\n")))
    assert s2["downloads"] is False, "a negation removes the folder whatever its :ro/:rw"
    assert override_args("home", False) == ["--nofilesystem=home", "--nofilesystem=host"]
    assert override_args("launch", True) == [f"--talk-name={LAUNCH_BUS}"]
    try:
        override_args("everything", True)
        raise AssertionError("unknown permission accepted")
    except ValueError:
        pass
    CFG = Path(tempfile.mkdtemp())
    d = "a" * 64
    write("exe-names", [f"{d}\t/home/u/Downloads/Game Setup.exe", f"{'b' * 64}\tnot/absolute"])
    set_program(d, "run", "sandbox")
    assert programs()[0]["run"] == "sandbox" and programs()[0]["name"] == "Game Setup.exe"
    assert len(programs()) == 1, "a line that isn't a real path is not shown"
    write("exe-names", [f"{d}\t/home/u/Game.exe", "c" * 64 + "\t/x" + chr(0x2028) + "y.exe", "zz\t/z.exe"])
    assert [x["name"] for x in programs()] == ["Game.exe"], "odd characters and bad fingerprints are not shown"
    set_program(d, "run", "trusted")
    assert programs()[0]["run"] == "trusted" and lines("exe-choices") == []
    set_program(d, "run", "ask")
    assert programs()[0]["run"] == "ask" and lines("trusted-exes") == []
    set_program(d, "internet", "off")
    assert programs()[0]["internet"] is False
    set_program(d, "internet", "on")
    assert programs()[0]["internet"] is True and lines("offline-exes") == []
    assert new_apps(["a", "b"], None) is None, "first run: no notices"
    assert new_apps(["a", "b", "c"], ["a", "b"]) == ["c"] and new_apps(["a"], ["a", "x"]) == []
    t = summary_text({"network": True, "host": False, "home": False, "documents": True, "downloads": False, "pictures": False,
                      "music": False, "videos": False, "sound": False, "devices": False, "launch": True})
    assert t == "the internet, Documents, starting other programs", t
    sneaky = summary(merge(parse("[Context]\nsockets=wayland;session-bus;\nfilesystems=~/.ssh;\ndevices=input;\n\n"
                                 "[Session Bus Policy]\norg.freedesktop.secrets=talk\norg.freedesktop.Notifications=talk\n")))
    st = summary_text(sneaky)
    assert "~/.ssh" in st and "session-bus" in st and "input" in st and "org.freedesktop.secrets" in st, st
    assert "Notifications" not in st and st != "nothing outside its box", st
    spoof = summary_text(summary(merge(parse("[Session Bus Policy]\norg.freedesktop.Notifications=own\n"
                                             "org.example.App.Helper=own\n")), "org.example.App"))
    assert "acts as service org.freedesktop.Notifications" in spoof and "Helper" not in spoof, spoof
    assert plain("<b>x</b>") == "?b?x?/b?", plain("<b>x</b>")
    kept = summary_text(summary(merge(parse("[Session Bus Policy]\norg.evil.Spy=own\n"),
                                      parse("[Session Bus Policy]\norg.other.Thing=none\n"))))
    assert "acts as service org.evil.Spy" in kept, "removing one name keeps the others"
    assert plain("~//a/./b/" + "x" * 100 + "/.ssh").endswith("/.ssh"), "long paths are never cut"
    sb = summary_text(summary(merge(parse("[System Bus Policy]\norg.freedesktop.NetworkManager=talk\n"))))
    assert "run as administrator (org.freedesktop.NetworkManager)" in sb, sb
    print("selftest ok")


def main(a):
    if a == ["--selftest"]:
        return selftest()
    if a == ["new-apps"]:
        return notice_new_apps()
    if a == ["list"]:
        print(json.dumps({"apps": apps(), "programs": programs()}))
        return
    if len(a) == 4 and a[0] == "app" and APP_ID.match(a[1]) and a[3] in ("on", "off"):
        r = subprocess.run(["flatpak", "override", "--user", *override_args(a[2], a[3] == "on"), a[1]])
        sys.exit(r.returncode)
    if len(a) == 2 and a[0] == "reset" and APP_ID.match(a[1]):
        sys.exit(subprocess.run(["flatpak", "override", "--user", "--reset", a[1]]).returncode)
    if len(a) == 4 and a[0] == "program" and DIGEST.match(a[1]):
        return set_program(a[1], a[2], a[3])
    sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
