#!/usr/bin/bash
# At sign-in: the computer's own NTFS drives (Windows (C:) and its data partitions, as found by fennek-windows-scan at the
# start of the computer) open by themselves and show in Files like any other drive, for people allowed to administer this
# computer. Read-only when Windows isn't fully shut down: then it keeps files open in hibernation (Fast Startup), and
# writing to a drive now could damage them.
#   fennek-windows-drives
#   fennek-windows-drives --selftest
state=${XDG_STATE_HOME:-$HOME/.local/state}/fennek

# The scan's list (a file) -> first line read-only or read-write, then each drive's partition UUID. Nothing if there's no list.
drives() {
    python3 -I -c '
import json, sys
d = json.load(open(sys.argv[1]))
print("read-only" if d["read_only"] else "read-write")
for e in d["drives"]:
    print(e["uuid"])
' "$1" 2>/dev/null
}
# stdout of: udevadm info -q property DEVICE -> is this really the drive the scan found?
ours() { grep -qx 'FENNEK_NTFS=1' <<<"$1"; }
# A mount's options -> is it read-only?
read_only_mount() { case ,$1, in *,ro,*) ;; *) false ;; esac; }

if [ "${1:-}" = --selftest ]; then
    ours $'DEVNAME=/dev/sda3\nFENNEK_NTFS=1' || exit 1
    ! ours $'DEVNAME=/dev/sdb1\nID_FS_TYPE=ntfs' || exit 1
    read_only_mount ro,nosuid,nodev || exit 1
    ! read_only_mount rw,nosuid,errors=remount-ro || exit 1
    t=$(mktemp) || exit 1
    echo '{"read_only": true, "drives": [{"uuid": "a", "windows": true}, {"uuid": "b", "windows": false}]}' >"$t"
    [ "$(drives "$t" | paste -sd' ')" = "read-only a b" ] || exit 1
    echo '{"read_only": false, "drives": []}' >"$t"
    [ "$(drives "$t")" = read-write ] || exit 1
    rm -f "$t"
    [ -z "$(drives "$t")" ] || exit 1
    echo "selftest ok"; exit 0
fi

mapfile -t list < <(drives /run/fennek/windows-drives.json)
read_only=""
# From the installer USB, clean drives stay closed: the installer can't measure a mounted drive and greys out shrinking it.
# A hibernated one still opens read-only, so that shrinking stays off for it.
if grep -qw rd.live.image /proc/cmdline && [ "${list[0]:-}" != read-only ]; then
    list=("${list[0]:-}")
fi
for uuid in "${list[@]:1}"; do
    # The real device: a plugged-in drive with a copy of this UUID can take over the link (it doesn't get the scan's mark),
    # and by the link's name udisksctl could pick that one even when the link is ours.
    dev=$(readlink -f "/dev/disk/by-partuuid/$uuid")
    ours "$(udevadm info -q property "$dev" 2>/dev/null)" || continue
    [ -n "$(lsblk -nro MOUNTPOINTS "$dev" | tr -d '[:space:]')" ] && continue
    open=(udisksctl mount --no-user-interaction -b "$dev")
    if [ "${list[0]}" = read-only ]; then
        "${open[@]}" -o ro >/dev/null 2>&1 || continue
    else
        "${open[@]}" >/dev/null 2>&1 || "${open[@]}" -o ro >/dev/null 2>&1 || continue
    fi
    # Asked for read-write, a drive Windows didn't close cleanly opens read-only all the same, without a word.
    read_only_mount "$(findmnt -no OPTIONS -S "$dev")" && read_only=1
done

# Once per start of the computer, not at every sign-in.
boot=$(cat /proc/sys/kernel/random/boot_id)
if [ -n "$read_only" ] && [ "$(cat "$state/windows-read-only-noticed" 2>/dev/null)" != "$boot" ]; then
    mkdir -p "$state" && echo "$boot" >"$state/windows-read-only-noticed"
    notify-send -a "Files" -i drive-harddisk "Windows drive is read-only for now" \
        "Windows wasn't fully shut down, so you can open its files here but not change them. To change them: start Windows, hold Shift and click Shut down." || true
fi
# BitLocker: once ever. The drive is there, and Files asks for its recovery key when you open it.
if [ ! -e "$state/bitlocker-noticed" ] && lsblk -nro FSTYPE | grep -qx BitLocker; then
    mkdir -p "$state" && touch "$state/bitlocker-noticed"
    notify-send -a "Files" -i drive-harddisk-encrypted "A drive is locked with BitLocker" \
        "To open it here, click it in Files and type its BitLocker recovery key." || true
fi
exit 0
