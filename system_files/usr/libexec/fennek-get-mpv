#!/usr/bin/bash
# "MPV Player (Oleks Edition)" in Start: installs the mpv player (Flathub, for this account only, no password) and
# Oleks's setup for it (github.com/Olexify/MPV_Player_OleksEdition: modern controls, thumbnails, resume, smart
# keys). Not part of Fennek OS itself; nothing happens until you choose it. Run again: the setup is refreshed (the
# previous one is kept as mpv.bak-DATE).
# The setup is made for another system's graphics; its video output lines get the Linux equivalents.
set -euo pipefail
app=io.mpv.Mpv
repo=https://codeload.github.com/Olexify/MPV_Player_OleksEdition/tar.gz/refs/heads/master
note() { notify-send -a "MPV Player" -i multimedia-video-player "$@" || true; }

note "Installing MPV Player" "Oleks Edition: the player, then its setup. This takes a minute."
if ! flatpak info "$app" >/dev/null 2>&1; then
    flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    flatpak install --user -y --noninteractive flathub "$app" || { note "MPV Player wasn't installed" "Check the internet connection and try again."; exit 1; }
fi

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
curl -fsSL --max-time 120 --max-filesize 50000000 "$repo" -o "$tmp/setup.tar.gz" \
    || { note "MPV Player is installed" "Its Oleks Edition setup couldn't be downloaded; the player works with its own look."; exit 1; }
mkdir "$tmp/src"
tar -xzf "$tmp/setup.tar.gz" -C "$tmp/src" --strip-components=1 --no-same-owner --no-same-permissions
src=$tmp/src
[ -f "$src/mpv.conf" ] || { note "MPV Player is installed" "The setup download looked wrong; nothing was changed."; exit 1; }
rm -rf "$src/.git" "$src/.github" "$src/README.md" "$src/.gitignore"
# Linux graphics: the same idea (fast GPU output, hardware decoding) with this system's names.
sed -i -e 's/^gpu-api=d3d11$/gpu-api=auto/' -e 's/^hwdec=d3d11va\(-copy\)\?$/hwdec=auto-safe/' \
    -e '/^d3d11va-zero-copy=/d' -e '/^d3d11-exclusive-fs=/d' "$src/mpv.conf"

# The Flathub player reads its setup here (and a player from elsewhere from ~/.config/mpv).
for dest in "$HOME/.var/app/$app/config/mpv" "${XDG_CONFIG_HOME:-$HOME/.config}/mpv"; do
    [ "$dest" = "${XDG_CONFIG_HOME:-$HOME/.config}/mpv" ] && ! command -v mpv >/dev/null && continue
    if [ -e "$dest" ]; then mv "$dest" "$dest.bak-$(date +%Y%m%d-%H%M%S)"; fi
    mkdir -p "${dest%/*}" && cp -r "$src" "$dest"
done
note "MPV Player is ready" "Oleks Edition. Open a video with it from Files (right-click > Open with)."
