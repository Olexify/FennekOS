#!/usr/bin/env bash
# Once, in the background: the everyday apps people expect (photos, PDF, video, music, calculator, notepad, camera, alarms & clock,
# archives, paint, scanning), from Flathub. Office comes on request (Start / Welcome: LibreOffice, fennek-get-app). Apps already in the image are skipped. Retried later if the network isn't there.
set -u
stamp=/var/lib/fennek/essential-apps.v3   # new name when the list grows: existing PCs fetch the new apps
declare -A apps=([gwenview]=org.kde.gwenview [okular]=org.kde.okular [haruna]=org.kde.haruna [elisa]=org.kde.elisa
                 [kcalc]=org.kde.kcalc [kwrite]=org.kde.kwrite [ark]=org.kde.ark [kolourpaint]=org.kde.kolourpaint
                 [skanpage]=org.kde.skanpage [kamoso]=org.kde.kamoso [kclock]=org.kde.kclock)
want=()
for cmd in "${!apps[@]}"; do
    command -v "$cmd" >/dev/null || flatpak info --system "${apps[$cmd]}" >/dev/null 2>&1 || want+=("${apps[$cmd]}")
done
[ "${1:-}" = --list ] && { printf '%s\n' "${want[@]}"; exit 0; }
flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || exit 1
[ ${#want[@]} -eq 0 ] || flatpak install --system -y --noninteractive flathub "${want[@]}" || exit 1
mkdir -p "${stamp%/*}" && touch "$stamp"
