#!/usr/bin/python3
"""Fennek OS instant file search (Everything-style), one per user.

Keeps every file name under your home and plugged-in drives in memory, kept live with inotify: no rescans,
no CPU while idle. Answers the Start menu / KRunner (Alt+Space) over D-Bus (org.kde.krunner1).
Never sees other users' files: it runs as you and only indexes what you can read.

Query: words must all appear in the file name (any order, case-insensitive). Filters:
  ext:pdf;docx   type:image|video|audio|doc|archive|exe|folder   path:projects
History: files you open from search rank higher (~/.local/share/fennek/search-history, delete to clear).

  fennek-search             run the service
  fennek-search QUERY...    one-off search from a terminal (scans, prints, exits)
  fennek-search --selftest
"""
import ctypes, ctypes.util, json, os, struct, subprocess, sys

HOME = os.path.expanduser("~")
DATA = os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share")
HISTORY = os.path.join(DATA, "fennek", "search-history")
SKIP_DIRS = {os.path.join(DATA, d) for d in ("Trash", "fennek/sandboxes", "umu", "Steam", "flatpak")} | \
            {os.path.join(HOME, d) for d in (".cache", ".var", ".local/share/Trash")}
TYPES = {
    "image": {"png", "jpg", "jpeg", "gif", "webp", "bmp", "svg", "heic", "tif", "tiff", "raw", "avif"},
    "video": {"mp4", "mkv", "webm", "avi", "mov", "wmv", "flv", "m4v"},
    "audio": {"mp3", "flac", "ogg", "opus", "wav", "m4a", "aac", "wma"},
    "doc": {"pdf", "doc", "docx", "odt", "txt", "md", "rtf", "xls", "xlsx", "ods", "ppt", "pptx", "odp", "csv"},
    "archive": {"zip", "7z", "rar", "tar", "gz", "xz", "zst", "bz2", "iso"},
    "exe": {"exe", "msi", "appimage", "sh", "bat"},
}
MAX_RESULTS = 20

# inotify via libc (no extra packages)
IN_CREATE, IN_DELETE, IN_MOVED_FROM, IN_MOVED_TO = 0x100, 0x200, 0x40, 0x80
IN_DELETE_SELF, IN_Q_OVERFLOW, IN_IGNORED, IN_ISDIR, IN_ONLYDIR = 0x400, 0x4000, 0x8000, 0x40000000, 0x01000000
MASK = IN_CREATE | IN_DELETE | IN_MOVED_FROM | IN_MOVED_TO | IN_DELETE_SELF | IN_ONLYDIR
EVENT = struct.Struct("iIII")


class Index:
    """Paths (files and folders) in a dict for O(1) add/remove; folders are watched with inotify.
    ponytail: linear scan per query (~10 ms per 100k paths); move to a trigram index or Rust if homes get huge."""

    def __init__(self, roots, inotify=True):
        self.roots, self.paths, self.wd_dir, self.dir_wd = roots, {}, {}, {}
        self.libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True) if inotify else None
        self.fd = self.libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC) if inotify else -1

    def scan(self, top):
        stack = [top]
        while stack:
            d = stack.pop()
            if d in SKIP_DIRS or self._watch(d) is False:
                continue
            try:
                with os.scandir(d) as it:
                    for e in it:
                        if e.name.startswith("."):          # hidden: config clutter, not what people search
                            continue
                        self.paths[e.path] = None
                        if e.is_dir(follow_symlinks=False):
                            stack.append(e.path)
            except OSError:
                pass

    def _watch(self, d):
        if self.fd < 0:
            return True
        wd = self.libc.inotify_add_watch(self.fd, d.encode(), MASK)
        if wd < 0:
            return False
        self.wd_dir[wd], self.dir_wd[d] = d, wd
        return True

    def rebuild(self):
        for wd in list(self.wd_dir):
            self.libc.inotify_rm_watch(self.fd, wd)
        self.paths.clear(); self.wd_dir.clear(); self.dir_wd.clear()
        for r in self.roots:
            if os.path.isdir(r):
                self.scan(r)

    def _drop_tree(self, path):
        self.paths.pop(path, None)
        prefix = path + "/"
        for p in [p for p in self.paths if p.startswith(prefix)]:   # ponytail: O(n) per deleted folder
            del self.paths[p]
        for d in [d for d in self.dir_wd if d == path or d.startswith(prefix)]:
            self.wd_dir.pop(self.dir_wd.pop(d), None)

    def handle_events(self):
        try:
            buf = os.read(self.fd, 64 * 1024)
        except BlockingIOError:
            return
        i = 0
        while i + EVENT.size <= len(buf):
            wd, mask, _cookie, n = EVENT.unpack_from(buf, i)
            name = buf[i + EVENT.size:i + EVENT.size + n].rstrip(b"\0").decode(errors="surrogateescape")
            i += EVENT.size + n
            if mask & IN_Q_OVERFLOW:
                return self.rebuild()
            d = self.wd_dir.get(wd)
            if d is None or (name.startswith(".") and name):
                continue
            path = os.path.join(d, name) if name else d
            if mask & (IN_CREATE | IN_MOVED_TO):
                self.paths[path] = None
                if mask & IN_ISDIR:
                    self.scan(path)
            elif mask & (IN_DELETE | IN_MOVED_FROM):
                self._drop_tree(path)
            elif mask & (IN_DELETE_SELF | IN_IGNORED):
                self.wd_dir.pop(wd, None); self.dir_wd.pop(d, None)


def parse(query):
    """'report ext:pdf;docx type:doc path:work' → (words, exts or None, folders_only, path_words)."""
    words, exts, folders, paths = [], None, False, []
    for tok in query.lower().split():
        key, _, val = tok.partition(":")
        if key == "ext" and val:
            exts = (exts or set()) | {v.lstrip(".") for v in val.split(";") if v}
        elif key == "type" and val == "folder":
            folders = True
        elif key == "type" and val in TYPES:
            exts = (exts or set()) | TYPES[val]
        elif key == "path" and val:
            paths.append(val)
        else:
            words.append(tok)
    return words, exts, folders, paths


def search(paths, query, history=(), limit=MAX_RESULTS):
    words, exts, folders, path_words = parse(query)
    if not (words or exts or folders or path_words):
        return []
    hist = {p: i for i, p in enumerate(reversed(list(history)))}   # most recent = 0
    hits = []
    for p in paths:
        name = p.rsplit("/", 1)[-1].lower()
        if not all(w in name for w in words):
            continue
        if exts is not None and (name.rsplit(".", 1)[1] if "." in name else "") not in exts:
            continue
        if path_words and not all(w in p.lower() for w in path_words):
            continue
        if folders and not os.path.isdir(p):
            continue
        stem = name.rsplit(".", 1)[0]
        q = " ".join(words)
        rank = (0 if p in hist else 1, hist.get(p, 0),
                0 if stem == q else 1 if name.startswith(q) else 2, p.count("/"), len(name))
        hits.append((rank, p))
    hits.sort()
    return [p for _, p in hits[:limit]]


def load_history():
    try:
        return [l for l in open(HISTORY).read().splitlines() if l][-200:]
    except OSError:
        return []


def remember(path):
    h = [p for p in load_history() if p != path] + [path]
    os.makedirs(os.path.dirname(HISTORY), exist_ok=True)
    with open(HISTORY, "w") as f:
        f.write("\n".join(h[-200:]) + "\n")


def roots():
    media = f"/run/media/{os.environ.get('USER') or os.getlogin()}"
    return [HOME] + ([os.path.join(media, m) for m in os.listdir(media)] if os.path.isdir(media) else [])


def serve():
    import dbus, dbus.service
    from dbus.mainloop.glib import DBusGMainLoop
    from gi.repository import GLib

    DBusGMainLoop(set_as_default=True)
    index = Index(roots())

    class Runner(dbus.service.Object):
        @dbus.service.method("org.kde.krunner1", out_signature="a(sss)")
        def Actions(self):
            return [("folder", "Open containing folder", "document-open-folder")]

        @dbus.service.method("org.kde.krunner1", in_signature="s", out_signature="a(sssida{sv})")
        def Match(self, query):
            out = []
            for i, p in enumerate(search(index.paths, query, load_history())):
                icon = "folder" if os.path.isdir(p) else "text-x-generic"
                out.append((p, os.path.basename(p), icon, 30, 0.9 - i * 0.01,
                            {"subtext": os.path.dirname(p).replace(HOME, "~", 1), "urls": ["file://" + p]}))
            return out

        @dbus.service.method("org.kde.krunner1", in_signature="ss")
        def Run(self, match_id, action_id):
            remember(match_id)
            if action_id == "folder":
                subprocess.Popen(["dolphin", "--select", match_id])
            else:
                subprocess.Popen(["xdg-open", match_id])

    bus = dbus.SessionBus()
    name = dbus.service.BusName("org.fennek.Search", bus)   # keep a reference: releasing it drops the name
    Runner(bus, "/runner")
    index.rebuild()
    GLib.io_add_watch(index.fd, GLib.IO_IN, lambda *_: (index.handle_events(), True)[1])
    GLib.MainLoop().run()


def selftest():
    import tempfile, time
    global SKIP_DIRS
    t = tempfile.mkdtemp()
    SKIP_DIRS = {os.path.join(t, "skip")}
    for f in ("Work/Report 2026.pdf", "Work/report-draft.docx", "Photos/cat.jpg", "skip/secret.pdf",
              ".config/hidden.pdf", "Music/song.mp3"):
        os.makedirs(os.path.dirname(os.path.join(t, f)), exist_ok=True)
        open(os.path.join(t, f), "w").close()
    ix = Index([t])
    ix.rebuild()
    names = lambda q, h=(): [os.path.relpath(p, t) for p in search(ix.paths, q, h)]
    assert names("report") == ["Work/Report 2026.pdf", "Work/report-draft.docx"], "shorter name first"
    assert names("report ext:pdf") == ["Work/Report 2026.pdf"]
    assert names("type:image") == ["Photos/cat.jpg"] and names("type:audio") == ["Music/song.mp3"]
    assert names("type:folder work") == ["Work"]
    assert names("pdf path:work") == ["Work/Report 2026.pdf"]
    assert "skip/secret.pdf" not in names("secret") and not names("hidden"), "skipped/hidden never indexed"
    assert names("report", [os.path.join(t, "Work/Report 2026.pdf")])[0] == "Work/Report 2026.pdf", "history first"
    assert names("") == [] and names("zzz") == []
    # live updates through inotify
    open(os.path.join(t, "Work/new invoice.pdf"), "w").close()
    os.makedirs(os.path.join(t, "Projects/Deep")); open(os.path.join(t, "Projects/Deep/plan.txt"), "w").close()
    time.sleep(0.2); ix.handle_events()
    assert names("invoice") == ["Work/new invoice.pdf"], "new file found without rescanning"
    assert names("plan") == ["Projects/Deep/plan.txt"], "new folder tree indexed and watched"
    open(os.path.join(t, "Projects/Deep/later.txt"), "w").close()
    time.sleep(0.2); ix.handle_events()
    assert names("later") == ["Projects/Deep/later.txt"], "files in a new folder are tracked too"
    os.remove(os.path.join(t, "Work/new invoice.pdf"))
    os.rename(os.path.join(t, "Photos"), os.path.join(t, "Pictures"))
    time.sleep(0.2); ix.handle_events()
    assert names("invoice") == [], "deleted file gone"
    assert names("cat") == ["Pictures/cat.jpg"], "renamed folder: old paths gone, new ones found"
    subprocess.run(["rm", "-rf", t])
    print("selftest ok")


if __name__ == "__main__":
    args = sys.argv[1:]
    if args == ["--selftest"]:
        selftest()
    elif args:
        ix = Index(roots(), inotify=False)
        ix.rebuild()
        print("\n".join(search(ix.paths, " ".join(args), load_history())))
    else:
        serve()
