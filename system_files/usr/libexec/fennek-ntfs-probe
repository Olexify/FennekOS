#!/usr/bin/bash
# udev, for the NTFS partitions of disks built into this computer (90-fennek-windows-drive.rules keeps everything else
# out): prints properties for this partition. Only reads: never mounts or changes the drive. This reads a file system
# as root, which is fine for the computer's own disk but not for whatever gets plugged in.
#   FENNEK_NTFS=1            one of the computer's own NTFS drives
#   FENNEK_WINDOWS=1         the one Windows is installed on
#   FENNEK_NTFS_READONLY=1   Windows is hibernated (Fast Startup) on it: must not be written to
dev=${1:?usage: fennek-ntfs-probe DEVICE}
echo FENNEK_NTFS=1
ntfsls -f "$dev" -p /Windows/System32 >/dev/null 2>&1 && echo FENNEK_WINDOWS=1
case "$(ntfscat -f "$dev" hiberfil.sys 2>/dev/null | head -c 4 | tr -d '\0')" in
    hibr|HIBR|wake|WAKE) echo FENNEK_NTFS_READONLY=1 ;;
esac
exit 0
