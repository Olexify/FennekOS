# The computer's own NTFS drives (Windows and its data partitions): what fennek-windows-drives needs to know before it
# opens them at sign-in, and the name the Windows drive shows under in Files.
ACTION=="remove", GOTO="fennek_windows_end"
SUBSYSTEM!="block", GOTO="fennek_windows_end"
ENV{DEVTYPE}!="partition", GOTO="fennek_windows_end"
ENV{ID_FS_TYPE}!="ntfs", GOTO="fennek_windows_end"
# Only disks built into this computer reach the probe, which reads the file system as root. Never anything that can be
# plugged in, nor a file an account attaches as a disk (loop devices).
KERNEL!="sd*|nvme*|mmcblk*|vd*", GOTO="fennek_windows_end"
ENV{ID_BUS}=="usb", GOTO="fennek_windows_end"
SUBSYSTEMS=="usb|thunderbolt|firewire|pcmcia|memstick", GOTO="fennek_windows_end"
ATTRS{removable}=="1", GOTO="fennek_windows_end"
# An SD card in a reader (built-in eMMC storage stays)
ATTRS{type}=="SD", GOTO="fennek_windows_end"
# Microsoft basic data partitions only: not Windows' recovery partition.
ENV{ID_PART_ENTRY_TYPE}!="ebd0a0a2-b9e5-4433-87c0-68b6b72699c7", GOTO="fennek_windows_end"
IMPORT{program}="/usr/libexec/fennek-ntfs-probe $devnode"
ENV{FENNEK_WINDOWS}=="1", ENV{ID_FS_LABEL}="Windows (C:)", ENV{ID_FS_LABEL_ENC}="Windows\x20(C:)"
# Windows hibernated (Fast Startup): its open files are in memory, writing here now would damage them. Read-only.
ENV{FENNEK_NTFS_READONLY}=="1", ENV{UDISKS_MOUNT_OPTIONS_DEFAULTS}="ro"
LABEL="fennek_windows_end"
