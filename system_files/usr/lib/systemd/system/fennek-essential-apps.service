[Unit]
Description=Install the everyday apps once (photos, PDF, video, music, calculator, notepad, archives, paint, scanning)
Wants=network-online.target
After=network-online.target flatpak-add-fedora-repos.service
ConditionPathExists=!/var/lib/fennek/essential-apps.done
# Not in the live/installer session: it would download into memory.
ConditionKernelCommandLine=!rd.live.image

[Service]
Type=oneshot
ExecStart=/usr/libexec/fennek-essential-apps
Nice=19
IOSchedulingClass=idle
Restart=on-failure
RestartSec=15min

[Install]
WantedBy=multi-user.target
