#!/usr/bin/python3
"""Run a Windows program (.exe/.msi) with Proton. Unknown programs run in a sandbox (Fennek OS auto-containment).

Usage: fennek-run-exe FILE [ARGS...]                  asks per unknown program (or uses the remembered choice)
       fennek-run-exe --choose FILE [ARGS...]         ask again, whatever was remembered (right-click: Choose how to run)
       fennek-run-exe --sandbox FILE [ARGS...]        always sandboxed, no sound, no questions
       fennek-run-exe --sandbox-sound FILE [ARGS...]  sandboxed with sound (and therefore microphone)
       fennek-run-exe --trusted FILE [ARGS...]        normal run, no sandbox
       fennek-run-exe --box SHA256|trusted ID         a program installed earlier, from its entry in Start
       fennek-run-exe --sync                          bring programs' Start menu shortcuts into Start (at sign-in)
       fennek-run-exe --selftest

Sandbox: own private home (Wine prefix inside); sees only ~/Sandbox/<program> as "Shared", its own folder
read-only, Proton through a throwaway overlay. Own network namespace (pasta): internet works, but host-only
sockets (X11 abstract socket, D-Bus, local services) are unreachable. Wayland display when Proton supports it,
so no X11 snooping. No sound/microphone unless asked for. Your real home and other programs are invisible.
"""
import fcntl, grp, hashlib, itertools, os, re, shutil, subprocess, sys, threading, time, unicodedata
from pathlib import Path

HOME = Path.home()
CFG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "fennek"
DATA = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")
TRUSTED = CFG / "trusted-exes"           # one sha256 per line
CHOICES = CFG / "exe-choices"           # "sha256 sandbox|sandbox-sound" per line: remembered sandbox runs
OFFLINE = CFG / "offline-exes"           # sha256s blocked by fennek-firewall: sandbox gets no network at all
FOLDERS = CFG / "exe-folders"            # "sha256 documents|downloads|pictures|music|videos" per line: also visible
XDG_KIND = {"documents": "DOCUMENTS", "downloads": "DOWNLOAD", "pictures": "PICTURES", "music": "MUSIC", "videos": "VIDEOS"}
NAMES = CFG / "exe-names"               # "sha256<TAB>path" per line: what App permissions shows for each program
OLD_RECORDS = CFG / "old-exe-records"    # those files, less OFFLINE, before folder names got longer: see old_records
BOXES = DATA / "fennek" / "sandboxes"    # private home per sandboxed program
SHARED = HOME / "Sandbox"                # ~/Sandbox/<program> = the only real folder it can see
GUI = bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))
UMU = {"GAMEID": "umu-default"}
SECCOMP = Path("/usr/share/fennek/sandbox-seccomp.bpf")   # src/sandbox-seccomp/make-filter.py, made at build time
SANDBOX_DNS = "169.254.1.1"             # pasta answers DNS here and forwards to the host's resolver
PASTA = ["pasta", "--config-net", "--quiet",
         "--no-map-gw",                                             # gateway must NOT reach host 127.0.0.1 services
         "-t", "none", "-u", "none", "-T", "none", "-U", "none",    # no port forwarding in either direction
         "--dns-forward", SANDBOX_DNS]


def say(text, kind="msgbox"):
    if GUI:
        subprocess.run(["kdialog", "--title", "Windows program", f"--{kind}", text])
    else:
        print(text, file=sys.stderr)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def is_trusted(digest):
    return TRUSTED.is_file() and digest in TRUSTED.read_text().split()


def trust(digest):
    CFG.mkdir(parents=True, exist_ok=True)
    with open(TRUSTED, "a") as f:
        f.write(digest + "\n")


def remembered(digest):
    """The remembered sandbox choice for this program ("sandbox" / "sandbox-sound"), or None."""
    for line in CHOICES.read_text().splitlines() if CHOICES.is_file() else []:
        d, _, mode = line.partition(" ")
        if d == digest and mode in ("sandbox", "sandbox-sound"):
            return mode
    return None


def forget(digest):
    """Drop every remembered choice for this program (trusted and sandbox), before a new one is stored."""
    for f in (TRUSTED, CHOICES):
        if f.is_file():
            f.write_text("".join(l + "\n" for l in f.read_text().splitlines() if not l.startswith(digest)))


def odd_char(c):
    """Control characters and anything a line splitter could treat as a line break: never in a recorded path."""
    o = ord(c)
    return o < 32 or 127 <= o <= 159 or o in (0x2028, 0x2029) or 0xD800 <= o <= 0xDFFF   # also undecodable bytes


def granted_folders(digest):
    """Your folders this sandboxed program may also see (App permissions): [(real folder, same place inside)]. By its whole
    fingerprint, or the start of it that names its sandbox.
    Only real folders inside your home, never a link, never the home itself."""
    out = []
    rows = FOLDERS.read_text(encoding="utf-8", errors="replace").split("\n") if FOLDERS.is_file() else []
    for kind in sorted({l.split(" ", 1)[1] for l in rows if l.startswith(digest) and " " in l} & set(XDG_KIND)):
        try:
            p = subprocess.run(["xdg-user-dir", XDG_KIND[kind]], capture_output=True, text=True).stdout.strip()
        except OSError:
            continue
        real = Path(p)
        if p and real.is_dir() and not real.is_symlink() and real.resolve().parent == HOME.resolve():
            out.append((real, HOME / real.name))
    return out


def note_name(digest, exe):
    """Where this program was last run from, for Settings > App permissions (one line per program). A path with
    control characters (a file named to forge a line) is not recorded."""
    if any(odd_char(c) for c in str(exe)):
        return
    CFG.mkdir(parents=True, exist_ok=True)
    rows = [l for l in (NAMES.read_text(encoding="utf-8", errors="replace").split("\n") if NAMES.is_file() else [])
            if l and not l.startswith(digest + "\t")]
    NAMES.write_text("".join(l + "\n" for l in rows + [f"{digest}\t{exe}"]), encoding="utf-8")


def remember(digest, mode):
    forget(digest)
    CFG.mkdir(parents=True, exist_ok=True)
    with open(CHOICES, "a") as f:
        f.write(f"{digest} {mode}\n")


def safe_name(exe):
    """Folder name from the file name. Never '..', '.', hidden or empty: a download called '...exe'
    must not turn ~/Sandbox/<name> into ~/Sandbox/.. (= your whole home)."""
    stem = re.sub(r"\.(exe|msi|bat|com)$", "", exe.name, flags=re.I)   # not Path.stem: odd names like '...exe'
    return re.sub(r"[^\w .+-]", "_", stem).strip(" .") or "program"


def folder_name(exe, digest):
    """Per program, not per file name: a malicious setup.exe must not share a folder with a real setup.exe.
    16 digits of its fingerprint: a crafted file can be made to match 8 in no time. A very long file name is cut, on a
    letter's edge: a folder name holds 255 bytes."""
    return f"{safe_name(exe).encode()[:255 - 17].decode(errors='ignore')}-{digest[:16]}"


def old_folder_name(exe, digest):
    """From when the names had 8 digits and nothing was cut."""
    return f"{safe_name(exe)}-{digest[:8]}"


def old_records(digest):
    """What was on record about programs with these 8 digits before folder names got longer: the lines starting with
    them. From a copy made once, before the first launch that could add to it, and never rewritten: a program first
    seen later is never in it, under any name, and removing a program in Settings doesn't take it out. The firewall's
    list stays out of it: a file can be blocked without ever having run. (Installed apps reads the same copy, and makes
    it if it needs it first.)"""
    if not OLD_RECORDS.is_file():
        CFG.mkdir(parents=True, exist_ok=True)
        tmp = OLD_RECORDS.with_name(f"{OLD_RECORDS.name}.{os.getpid()}")
        tmp.write_bytes(b"\n".join(f.read_bytes() for f in (TRUSTED, CHOICES, FOLDERS, NAMES) if f.is_file()))
        os.replace(tmp, OLD_RECORDS)
    return [l for l in OLD_RECORDS.read_text(encoding="utf-8", errors="replace").split("\n") if l.startswith(digest[:8])]


def move_old_folders(exe, digest):
    """Folders from when the names had 8 digits move to the long name, so a program keeps its files; in ~/Sandbox a
    link stays at the old name, for shortcuts to what's inside. Returns where the program is now: it may have been
    inside. Only for the one program on record with those 8 digits, under this file name if the record has one (the
    old folder's name came from it): anything else could be a crafted file, so the old folder stays and the program
    starts fresh (old_folder_notice tells where that folder is)."""
    rows = old_records(digest)
    if {l[:64] for l in rows} != {digest} or any(l[64:65] == "\t" and safe_name(Path(l[65:])) != safe_name(exe) for l in rows):
        return exe
    for parent in (BOXES.resolve(), SHARED.resolve()):
        old, new = parent / old_folder_name(exe, digest), parent / folder_name(exe, digest)
        if os.path.islink(old) or not os.path.isdir(old) or os.path.lexists(new):
            continue
        try:
            old.rename(new)
            if exe.is_relative_to(old):
                exe = new / exe.relative_to(old)
            if parent == SHARED.resolve():
                old.symlink_to(new.name)
        except OSError:   # it stays where it is (something mounted there?): nothing lost
            pass
    return exe


def old_folder_notice(exe, digest):
    """For a program that starts fresh beside an old folder: where its earlier files may be, without promising they're
    its own."""
    old = SHARED / old_folder_name(exe, digest)
    if os.path.islink(old) or not os.path.isdir(old):
        return ""
    return (f" An older folder, ~/Sandbox/{old.name}, stays as it was: it may hold this program's earlier files, "
            "or those of another program with the same name.")


def wine_cmd(target, args):
    """What Proton runs: a program itself; an installer package through msiexec. (Batch files are not handed to cmd:
    it reads their name as a command line, so a crafted name could run something other than the file checked.)"""
    t = str(target)
    if re.search(r"\.msi$", t, re.I):   # Wine's Z: is /; a bare /path would read as a /switch to msiexec
        return ["msiexec", "/i", "Z:" + t.replace("/", "\\"), *args]
    return [t, *args]


def proton_dir():
    """Newest Proton that umu downloaded, or None."""
    found = [p for d in (DATA / "umu/compatibilitytools", DATA / "Steam/compatibilitytools.d")
             if d.is_dir() for p in d.iterdir() if (p / "proton").is_file()]
    return max(found, key=lambda p: p.stat().st_mtime, default=None)


def wine_wayland(proton):
    """Does this Proton have Wine's Wayland driver? Then the sandbox needs no X11 at all."""
    try:
        return "PROTON_ENABLE_WAYLAND" in (proton / "proton").read_text(errors="ignore")
    except OSError:
        return False


def umu_env(now=None):
    """umu settings for a normal (trusted) run. umu checks Valve/GitHub for updates on every launch;
    we let it do that at most once a day, otherwise it runs offline with the Proton we have."""
    env, stamp, proton = dict(UMU), DATA / "fennek" / "umu-last-update", proton_dir()
    now = now or time.time()
    if proton and stamp.exists() and now - stamp.stat().st_mtime < 86400:
        env.update(PROTONPATH=str(proton), UMU_RUNTIME_UPDATE="0")
    else:
        stamp.parent.mkdir(parents=True, exist_ok=True)
        stamp.touch()
    return env


def ensure_proton():
    """First use: let umu (trusted) download its runtime + Proton outside any sandbox."""
    if proton_dir() and (DATA / "umu").is_dir():
        return proton_dir()
    say("Setting up Windows support (one-time download, a few hundred MB)…", "passivepopup")
    tmp = BOXES / ".bootstrap"
    subprocess.run(["umu-run", "wineboot", "-u"], env={**os.environ, **UMU, "WINEPREFIX": str(tmp)})
    subprocess.run(["rm", "-rf", str(tmp)])
    return proton_dir()


NVIDIA_NODES = ["nvidiactl", "nvidia-modeset", "nvidia-uvm", "nvidia-uvm-tools", *(f"nvidia{n}" for n in range(20))]


def placement(exe, shared):
    """(file to mount read-only or None, the program's path inside the sandbox).
    Only the file itself is ever mounted: guessing which folders are "safe" to expose can't be done right
    (~/Projects/tool.exe would expose all projects). A program that needs its other files goes into its
    shared folder ~/Sandbox/<name>, which the sandbox sees as ~/Shared: then it runs from there."""
    if exe.is_relative_to(shared):
        return None, HOME / "Shared" / exe.relative_to(shared)
    return exe, HOME / "App" / exe.name


def bwrap_args(exe, args, box_home, shared, proton, runtime_dir, display_env, sound=False, wayland=False,
               resolv=None, uid=1000, gid=1000, folders=(), inside=None, controllers=True):
    src, target = (None, inside) if inside else placement(exe, shared)   # inside: already in its own folders
    a = ["bwrap",
         # pasta's namespace makes us "root" (mapped to the real user); map back to the user's own id,
         # umu refuses to run as root and nothing inside should look privileged.
         "--unshare-user", "--uid", str(uid), "--gid", str(gid),
         "--ro-bind", "/usr", "/usr", "--ro-bind", "/etc", "/etc",
         "--symlink", "usr/bin", "/bin", "--symlink", "usr/sbin", "/sbin",
         "--symlink", "usr/lib", "/lib", "--symlink", "usr/lib64", "/lib64",
         "--proc", "/proc", "--dev", "/dev", "--dev-bind-try", "/dev/dri", "/dev/dri",
         # Game controllers: an account outside group input can only open the joystick devices in there, not keyboards or mice
         # (reads_all_input). Never /dev/uinput,
         # /dev/uhid or /dev/hidraw*: this system lets the signed-in person use them, and with those a program could type
         # into the desktop or read the keyboard.
         *(["--dev-bind-try", "/dev/input", "/dev/input"] if controllers else []),
         # Only the sysfs parts GPU drivers need (not all of /sys: less hardware fingerprinting).
         "--ro-bind-try", "/sys/dev/char", "/sys/dev/char", "--ro-bind-try", "/sys/devices", "/sys/devices",
         "--ro-bind-try", "/sys/class/drm", "/sys/class/drm", "--ro-bind-try", "/sys/bus/pci", "/sys/bus/pci",
         "--tmpfs", "/tmp", "--tmpfs", "/var/tmp",
         "--bind", str(box_home), str(HOME),
         "--bind", str(shared), str(HOME / "Shared"),
         # Runtime + Proton: writable overlay (pressure-vessel needs lock files), writes vanish
         # into a tmpfs, so the shared real copies can never be modified from inside.
         "--overlay-src", str(DATA / "umu"), "--tmp-overlay", str(DATA / "umu"),
         "--overlay-src", str(proton), "--tmp-overlay", str(proton),
         "--unshare-pid", "--unshare-uts", "--die-with-parent", "--new-session",
         "--unsetenv", "DBUS_SESSION_BUS_ADDRESS",
         "--setenv", "HOME", str(HOME), "--setenv", "WINEPREFIX", str(HOME / "prefix"),
         "--setenv", "PROTONPATH", str(proton), "--setenv", "UMU_RUNTIME_UPDATE", "0"]
    for node in NVIDIA_NODES:
        a += ["--dev-bind-try", f"/dev/{node}", f"/dev/{node}"]
    if src:
        a += ["--ro-bind", str(src), str(target)]
    a += ["--chdir", str(target.parent)]   # files beside the program: found by the plain names it asks for
    for real, inside in folders:   # folders you allowed in App permissions, at the same place as outside
        a += ["--bind", str(real), str(inside)]
    if str(HOME).startswith("/var/home/"):
        a += ["--symlink", "var/home", "/home"]
    if resolv:   # host's resolv.conf points at 127.0.0.53, which is unreachable from the sandbox's network
        # It can be a link into /run, and nothing mounts onto a link: then the sandbox's own goes where the link leads.
        a += ["--ro-bind", str(resolv), os.path.realpath("/etc/resolv.conf")]
    if runtime_dir:
        a += ["--dir", runtime_dir, "--chmod", "0700", runtime_dir]
        socks = [display_env.get("WAYLAND_DISPLAY", "wayland-0")]   # Wayland: apps can't spy on each other
        if sound:
            socks += ["pulse/native"]                                # playback AND recording; Wine's sound goes this way
        for s in socks:
            a += ["--ro-bind-try", f"{runtime_dir}/{s}", f"{runtime_dir}/{s}"]
    if wayland:
        a += ["--setenv", "PROTON_ENABLE_WAYLAND", "1", "--unsetenv", "DISPLAY", "--unshare-ipc"]
    elif display_env.get("DISPLAY"):
        # Fallback for Protons without Wine-Wayland: X11 lets the program see other X11 (Xwayland) windows.
        a += ["--ro-bind-try", "/tmp/.X11-unix", "/tmp/.X11-unix"]
        if display_env.get("XAUTHORITY"):
            a += ["--ro-bind-try", display_env["XAUTHORITY"], display_env["XAUTHORITY"]]
    for k, v in UMU.items():
        a += ["--setenv", k, v]
    return a + ["--", "umu-run", *wine_cmd(target, args)]


def with_seccomp(cmd, bpf=SECCOMP):
    """bwrap CMD with Fennek's seccomp filter: a tiny shell opens the filter as fd 10 right where bwrap starts (so it
    survives pasta), and bwrap applies it to everything inside."""
    return ["sh", "-c", 'exec "$@" 10<"$0"', str(bpf), cmd[0], "--seccomp", "10", *cmd[1:]]


# ---- installed programs in Start --------------------------------------------------------------------------------
# An installer's shortcuts stay inside the program's own Windows folders. Here they become entries in Start. All of
# that folder was written by the program, and this runs outside its sandbox: nothing there is followed if it's a link,
# nothing from it reaches a command line, and a shortcut itself is only ever opened inside the same sandbox.
SHORTCUT_FOLDERS = ("users/steamuser/AppData/Roaming/Microsoft/Windows/Start Menu", "ProgramData/Microsoft/Windows/Start Menu",
                    "users/steamuser/Desktop", "users/Public/Desktop")
NOT_A_PROGRAM = re.compile(r"(?i)uninstal|^unins|read ?me|manual|documentation|website|licen[cs]e|\bhelp\b")
MOST_ENTRIES = 20
MOST_LOOKED_AT = 5000   # the walk stops there: the program made these folders, and could make them endless


def plain_folder(base, rel):
    """base/rel if every step of it is a real folder, else None."""
    cur = Path(base)
    for part in Path(rel).parts:
        cur = cur / part
        if cur.is_symlink() or not cur.is_dir():
            return None
    return cur


def shortcuts(drive_c):
    """[(name, path inside drive_c)] of a program's shortcuts, the first of each name, at most MOST_ENTRIES."""
    found, budget = {}, MOST_LOOKED_AT
    for rel in SHORTCUT_FOLDERS:
        top = plain_folder(drive_c, rel)
        stack = [top] if top else []
        while stack and budget > 0:
            try:
                with os.scandir(stack.pop()) as it:
                    entries = sorted(itertools.islice(it, budget), key=lambda e: e.name)
            except OSError:
                continue
            budget -= len(entries) + 1
            for e in entries:
                if e.is_dir(follow_symlinks=False):
                    stack.append(e.path)
                elif e.is_file(follow_symlinks=False) and e.name.lower().endswith(".lnk") and e.stat(follow_symlinks=False).st_size < 1 << 20:
                    stem = e.name[:-4]
                    if stem and not NOT_A_PROGRAM.search(stem):
                        found.setdefault(stem, os.path.relpath(e.path, drive_c))
    return sorted(found.items())[:MOST_ENTRIES]


def shortcut_id(rel):
    return hashlib.sha256(rel.encode("utf-8", "surrogateescape")).hexdigest()[:16]


def clean_name(stem):
    # Only what shows as itself: letters, digits, punctuation, plain spaces, no long gaps. Nothing invisible may push
    # " (sandbox)" out of sight or reorder it. (Some letters are blank: fillers and the empty Braille cell.)
    blank = "\u115f\u1160\u3164\uffa0\u2800\\"
    kept = "".join(c for c in unicodedata.normalize("NFKC", stem)
                   if c not in blank and unicodedata.category(c)[0] in "LNP" or unicodedata.category(c) == "Zs")
    return " ".join(kept.split())[:40].strip() or "Program"


def shortcut_icon(drive_c, stem, out):
    """The picture Wine made for this shortcut, copied out if it really is a small picture; else None."""
    folder = plain_folder(drive_c, "proton_shortcuts")
    try:
        entry = folder / (stem + ".desktop") if folder else None
        if not entry or entry.is_symlink() or not entry.is_file() or entry.stat().st_size > 1 << 16:
            return None
        m = re.search(r"^Icon=([\w.-]+)$", entry.read_text(encoding="utf-8", errors="replace"), re.M)
        for size in (256, 128, 64, 48, 32) if m else ():
            apps = plain_folder(folder, f"icons/{size}x{size}/apps")
            png = apps / (m.group(1) + ".png") if apps else None
            if png and not png.is_symlink() and png.is_file() and png.stat().st_size < 1 << 22:
                data = png.read_bytes()
                if data.startswith(b"\x89PNG\r\n\x1a\n"):
                    out.parent.mkdir(parents=True, exist_ok=True)
                    out.write_bytes(data)
                    return out
    except OSError:
        pass
    return None


def sync_start(box_id, drive_c):
    """Start's entries for one program's folder match the shortcuts in it now: new ones added, gone ones removed."""
    apps, icons = DATA / "applications", DATA / "fennek" / "exe-icons"
    prefix, wanted = f"fennek-exe-{box_id[:16]}-", set()
    for stem, rel in shortcuts(drive_c):
        lid = shortcut_id(rel)
        entry = apps / f"{prefix}{lid}.desktop"
        wanted.add(entry.name)
        if entry.exists():
            continue
        # A sandboxed program chose this name itself: it always says what it is, so it never passes for another app.
        name = clean_name(stem) + ("" if box_id == "trusted" else " (sandbox)")
        icon = shortcut_icon(drive_c, stem, icons / f"{box_id[:16]}-{lid}.png") or "application-x-ms-dos-executable"
        apps.mkdir(parents=True, exist_ok=True)
        tmp = entry.with_name(entry.name + ".new")
        tmp.write_text(f"[Desktop Entry]\nType=Application\nName={name}\nComment=Classic program\nIcon={icon}\n"
                       f"Exec=fennek-run-exe --box {box_id} {lid}\nCategories=Other;\n", encoding="utf-8")
        os.replace(tmp, entry)
    for old in apps.glob(prefix + "*.desktop") if apps.is_dir() else []:
        if old.name not in wanted:
            old.unlink(missing_ok=True)
            (icons / (old.stem.removeprefix("fennek-exe-") + ".png")).unlink(missing_ok=True)


def trusted_drive():
    return HOME / "Games/umu/umu-default/drive_c"


def box_of(digest):
    """A sandboxed program's own folder, by its fingerprint."""
    if not re.fullmatch(r"[0-9a-f]{64}", digest) or not BOXES.is_dir():
        return None
    for d in BOXES.iterdir():
        if d.name.endswith("-" + digest[:16]) and not d.is_symlink() and d.is_dir():
            return d
    return None


def sync_all():
    rows = NAMES.read_text(encoding="utf-8", errors="replace").split("\n") if NAMES.is_file() else []
    for digest in {l.partition("\t")[0] for l in rows if l}:
        box = box_of(digest)
        if box:
            sync_start(digest, box / "home/prefix/drive_c")
    sync_start("trusted", trusted_drive())


def keep_start_in_sync(box_id, drive_c, run):
    """run() with Start's entries kept up to date while it runs: an installer's "Run now" stays open until the program
    closes, and a shutdown would end this before any last step. A problem here never touches the run."""
    done = threading.Event()

    def sync():
        try:
            sync_start(box_id, drive_c)
        except OSError:
            pass

    def loop():
        while not done.wait(5):
            sync()
    threading.Thread(target=loop, daemon=True).start()
    try:
        return run()
    finally:
        done.set()
        sync()


def run_box(box_id, lid):
    """A program installed earlier: its shortcut, in its own sandbox with that sandbox's choices. Never asks, and never
    runs outside a sandbox unless the program's folder is the trusted one."""
    box = None if box_id == "trusted" else box_of(box_id)
    if box_id != "trusted" and not box:
        return say("This program isn't there any more.", "error")
    drive_c = trusted_drive() if not box else box / "home/prefix/drive_c"
    rel = next((r for _, r in shortcuts(drive_c) if shortcut_id(r) == lid), None)
    if not rel:
        return say("This program's shortcut isn't there any more.", "error")
    if not box:
        return run_trusted(drive_c / rel, [])
    return run_sandboxed(Path(rel), box_id, [], sound=remembered(box_id) == "sandbox-sound", box=box, inside=HOME / "prefix/drive_c" / rel)


def reads_all_input(groups=None):
    """In group input, this account can read every keyboard: no controllers in the sandbox then."""
    try:
        return grp.getgrnam("input").gr_gid in (os.getgroups() if groups is None else groups)
    except KeyError:
        return False


def own_box(exe, sandbox=None):
    """~/Sandbox/<name>/...: the folder a program sits in says which sandbox it runs in, whichever program it is. What each
    may reach beyond that stays per program."""
    try:
        parts = exe.relative_to(sandbox or SHARED).parts
    except ValueError:
        return None
    return parts[0] if len(parts) > 1 and re.search(r"-[0-9a-f]{16}$", parts[0]) else None


def own_folder(folder, shared_places):
    """Is this the program's own folder, to offer copying? Not home or anything holding it, not a folder like Documents
    or Downloads, not a whole drive, nothing hidden in home."""
    if folder in shared_places or folder == HOME or folder in HOME.parents or os.path.ismount(folder):
        return False
    return not (folder.is_relative_to(HOME) and any(p.startswith(".") for p in folder.relative_to(HOME).parts))


def user_folders():
    out = {SHARED}
    for kind in ("DESKTOP", "DOWNLOAD", "DOCUMENTS", "MUSIC", "PICTURES", "VIDEOS", "PUBLICSHARE", "TEMPLATES"):
        r = subprocess.run(["xdg-user-dir", kind], capture_output=True, text=True)
        if r.stdout.strip():
            out.add(Path(r.stdout.strip()))
    return out


def copy_of(exe, digest):
    """The program's copy in its own folder, only while it's still the very same program."""
    c = SHARED / folder_name(exe, digest) / exe.parent.name / exe.name
    return c if c.is_file() and not c.is_symlink() and sha256(c) == digest else None


def offer_copy(exe, digest):
    """A program usually needs what's beside it, and only the file itself gets into the sandbox. Asks, naming the folder and
    its size. -> the copy, or exe as it was."""
    folder = exe.parent
    if not GUI or own_box(exe) or not own_folder(folder, user_folders()) or sum(1 for _ in itertools.islice(folder.iterdir(), 2)) < 2:
        return exe
    size = subprocess.run(["du", "-sh", "--", str(folder)], capture_output=True, text=True).stdout.split("\t")[0] or "?"
    shared = SHARED / folder_name(exe, digest)
    if subprocess.run(["kdialog", "--title", "Windows program", "--yesno",
                       f"{exe.name} probably needs the other files in its folder.\n\nCopy the folder {folder} ({size}) into "
                       f"~/Sandbox/{shared.name}? The program can then see and change that copy; the original stays as it is."]).returncode:
        return exe
    dest = shared / folder.name
    shared.mkdir(parents=True, exist_ok=True)
    if dest.exists() or subprocess.run(["cp", "-a", "--reflink=auto", "--", str(folder), str(dest)]).returncode:
        say(f"Couldn't copy {folder.name}; running {exe.name} by itself.", "passivepopup")
        return exe
    return dest / exe.name


# ---- what classic programs save -----------------------------------------------------------------------------------
# A Save dialog opens on Documents inside the program's Windows folders: hidden, and gone when the program is removed.
SAVE_FOLDERS = {"Documents": "documents", "Downloads": "downloads", "Music": "music", "Pictures": "pictures", "Videos": "videos"}
WIN_USER = "users/steamuser"


def own_saved_folder(shared, win):
    """shared/win, always a real folder: a link the program left there must not aim its next launch at something of yours."""
    f = shared / win
    if f.is_symlink():
        f.unlink()
    try:
        f.mkdir(exist_ok=True)
    except OSError:
        return None
    return f


def move_saved(drive_c, win, target):
    """What's in the Windows folder itself goes to target, replacing nothing. Runs outside the sandbox on folders the
    program wrote, so only through real folders: a link there could carry your own files into its reach."""
    src = plain_folder(drive_c, f"{WIN_USER}/{win}")
    for e in list(src.iterdir()) if src else []:
        try:
            if e.is_dir() and not e.is_symlink() and not any(e.iterdir()):
                e.rmdir()
                continue
            dest, n = target / e.name, 2
            while os.path.lexists(dest):
                dest, n = target / f"{e.stem} ({n}){e.suffix}", n + 1
            shutil.move(str(e), str(dest))
        except OSError:
            pass


def tidy_documents(folder):
    """Proton makes these empty folders inside Documents on first use and on updates."""
    for n in ("Downloads", "Music", "Pictures", "Templates", "Videos"):
        try:
            os.rmdir(folder / n)
        except OSError:
            pass


def user_dir(kind):
    try:
        return subprocess.run(["xdg-user-dir", XDG_KIND[kind]], capture_output=True, text=True).stdout.strip()
    except OSError:
        return ""


def saved_binds(drive_c, shared, granted):
    """[(folder, place inside)], Documents first: its Save folders are mounted from ~/Sandbox/<name>, or your real folder if
    it may see that. Mounts, not links: nothing in them can be replaced from inside, and Proton sees ordinary folders."""
    allowed, out = {real for real, _ in granted}, []
    for win, kind in SAVE_FOLDERS.items():
        real = Path(user_dir(kind)) if allowed else None
        target = real if real in allowed else own_saved_folder(shared, win)
        if target:
            move_saved(drive_c, win, target)
            out.append((target, HOME / "prefix/drive_c" / WIN_USER / win))
            if win == "Documents":
                tidy_documents(target)
    return out


def link_trusted_folders():
    """A trusted program's Save folders are links to your own folders: nothing to protect from it, and it has no mounts.
    After the first start: Proton would fill links in a new prefix, or swap a dangling one for a folder."""
    drive_c = trusted_drive()
    if not (drive_c.parent / "creation_sync_guard").exists():
        subprocess.run(["umu-run", "wineboot", "-u"], env={**os.environ, **umu_env()})
    for win, kind in SAVE_FOLDERS.items():
        p = user_dir(kind)
        real, here = Path(p), drive_c / WIN_USER / win
        if not p or not real.is_dir() or real.resolve() == HOME.resolve() or not here.parent.is_dir():   # unset: it answers home
            continue
        if here.is_symlink():
            if os.readlink(here) != str(real):
                here.unlink()
                here.symlink_to(real)
        elif here.is_dir():
            move_saved(drive_c, win, real)
            try:
                here.rmdir()
            except OSError:
                continue
            here.symlink_to(real)
        else:
            here.symlink_to(real)
        if win == "Documents":
            tidy_documents(real)


def run_sandboxed(exe, digest, args, sound=False, box=None, inside=None):
    proton = ensure_proton()
    if not proton:
        return say("Couldn't set up Windows support (no internet?).", "error")
    if not shutil.which("pasta"):
        return say("Sandbox networking (pasta) is missing; not running unsandboxed.", "error")
    home_box = None if box else own_box(exe)
    # Only a sandbox that exists: a folder unpacked here under a made-up name must not claim that program's permissions.
    if home_box and not (BOXES / home_box).is_dir():
        home_box = None
    name = box.name if box else home_box or folder_name(exe, digest)
    box_id = name[-16:] if home_box else digest
    box_home = BOXES / name / "home"
    shared = SHARED / name
    for d in (box_home, shared):
        d.mkdir(parents=True, exist_ok=True)
    if shared.resolve().parent != SHARED.resolve():   # belt and braces against path tricks
        return say(f"Refusing odd program name: {exe.name}", "error")
    # One run per sandbox: each has its own /tmp, so a second one would be a second Windows session on the same files.
    running = open(box_home.parent / ".running", "w")
    try:
        fcntl.flock(running, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return say(f"{exe.stem} is already open.", "error")
    wayland = bool(os.environ.get("WAYLAND_DISPLAY")) and wine_wayland(proton)
    resolv = box_home.parent / "resolv.conf"
    resolv.write_text(f"nameserver {SANDBOX_DNS}\n")
    # The sandbox's own program decides, for another .exe in its folder as well. That one's own choices don't count here:
    # what's already in this sandbox could use them.
    extra = granted_folders(box_id)
    also = (" and " + ", ".join(f"~/{inside.name}" for _, inside in extra)) if extra else ""
    if not box:
        say(f"{exe.name} runs in a sandbox and only sees ~/Sandbox/{name}{also}. "
            "If it needs other files, put them there."
            + old_folder_notice(exe, digest), "passivepopup")
    drive_c = box_home / "prefix/drive_c"
    binds = saved_binds(drive_c, shared, extra)
    cmd = bwrap_args(exe, args, box_home, shared, proton, os.environ.get("XDG_RUNTIME_DIR"), os.environ,
                     sound=sound, wayland=wayland, resolv=resolv, uid=os.getuid(), gid=os.getgid(),
                     folders=[*extra, *binds], inside=inside, controllers=not reads_all_input())
    if not SECCOMP.is_file():   # never quietly weaker
        return say("The sandbox's system-call filter is missing; not running.", "error")
    # A program blocked in the firewall stays blocked in another .exe that sits in its folder.
    blocked = OFFLINE.read_text().split() if OFFLINE.is_file() else []
    if digest in blocked or any(d.startswith(box_id) for d in blocked):
        full = with_seccomp([cmd[0], "--unshare-net", *cmd[1:]])   # firewall: no network
    else:   # Own network namespace with internet via pasta: host-only sockets and host loopback become unreachable.
        full = [*PASTA, "--", *with_seccomp(cmd)]
    code = keep_start_in_sync(box_id, drive_c, lambda: subprocess.run(full).returncode)
    if binds:
        tidy_documents(binds[0][0])   # a first start has just made them
    return code


def run_trusted(exe, args):
    link_trusted_folders()
    return keep_start_in_sync("trusted", trusted_drive(), lambda: subprocess.run(["umu-run", *wine_cmd(exe, args)], env={**os.environ, **umu_env()}).returncode)


def ask(exe, digest):
    """Unknown program → sandbox | sandbox-sound | vt | trust | None (cancel)."""
    text = (f"{exe.name} isn't trusted yet.\n\nIn the sandbox it can't see your files, "
            f"only the folder ~/Sandbox/{folder_name(exe, digest)}.")
    if not GUI:
        return "sandbox"
    r = subprocess.run(["kdialog", "--title", "Unknown Windows program", "--menu", text,
                        "sandbox", "Run in sandbox, no sound (recommended)",
                        "sandbox-sound", "Run in sandbox with sound (it can also use your microphone)",
                        "vt", "Check with VirusTotal first",
                        "trust", "I trust it: run normally"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def main(argv):
    if argv == ["--selftest"]:
        return selftest()
    if argv == ["--sync"]:
        return sync_all()
    if len(argv) == 2 and argv[0] == "--keep-saved":   # before a sandbox is removed: one not started since this came keeps its files inside
        if Path(argv[1]).name != argv[1] or argv[1] in (".", ".."):
            return 2
        (SHARED / argv[1]).mkdir(parents=True, exist_ok=True)
        if (SHARED / argv[1]).resolve().parent != SHARED.resolve():
            return 2
        saved_binds(BOXES / argv[1] / "home/prefix/drive_c", SHARED / argv[1], [])
        return 0
    if len(argv) == 3 and argv[0] == "--box" and re.fullmatch(r"[0-9a-f]{16}", argv[2]):
        return run_box(argv[1], argv[2])
    mode = argv.pop(0) if argv and argv[0] in ("--sandbox", "--sandbox-sound", "--trusted", "--choose") else None
    choose = mode == "--choose"
    mode = None if choose else mode
    if not argv:
        sys.exit(__doc__)
    exe = Path(argv[0]).resolve()
    if not exe.is_file():
        return say(f"Not found: {exe}", "error")
    digest = sha256(exe)
    exe = move_old_folders(exe, digest)   # first: this launch isn't recorded yet
    note_name(digest, exe)
    if mode == "--trusted" or (mode is None and not choose and is_trusted(digest)):
        return run_trusted(exe, argv[1:])
    if mode is None and not choose and remembered(digest):
        mode = "--" + remembered(digest)
    while mode is None:
        choice = ask(exe, digest)
        if choice == "vt":   # never remembered: checking is a one-off
            subprocess.run(["fennek-vt-check", str(exe)])
        elif choice == "trust":
            forget(digest)
            trust(digest)
            return run_trusted(exe, argv[1:])
        elif choice in ("sandbox", "sandbox-sound"):
            mode = "--" + choice
            exe = offer_copy(exe, digest)
            if GUI and subprocess.run(["kdialog", "--title", "Windows program", "--yesno",
                                       f"Run {exe.name} this way every time?\n\n"
                                       "You can change it later: right-click the file, Choose how to run."]).returncode == 0:
                remember(digest, choice)
            elif choose:
                forget(digest)   # asked again and not remembered: ask next time too
        else:
            return 0
    # Started from the original place later on: its copy, or it would be alone again.
    return run_sandboxed(copy_of(exe, digest) or exe, digest, argv[1:], sound=mode == "--sandbox-sound")


def selftest():
    global HOME, DATA
    HOME = Path("/var/home/u")
    for bad in ("...exe", "..exe", " . .exe", "....exe"):
        assert safe_name(Path(bad)) == "program", f"{bad!r} must not become a path trick"
    assert safe_name(Path(".evil.exe")) == "evil" and safe_name(Path("My Game.exe")) == "My Game"

    assert folder_name(Path("setup.exe"), "1a2b3c4d5e6f708199") == "setup-1a2b3c4d5e6f7081", "same name, other program: other folder"
    dl = HOME / "Downloads/setup.exe"
    sh = HOME / "Sandbox/setup-1a2b3c4d5e6f7081"
    for f in (dl, HOME / "Projects/tool.exe", HOME / ".config/x.exe"):
        assert placement(f, sh) == (f, HOME / "App" / f.name), f"{f}: only the file is mounted, never its folder"
    assert placement(sh / "bin/setup.exe", sh) == (None, HOME / "Shared/bin/setup.exe"), "inside its folder: run from Shared"

    a = bwrap_args(dl, ["/S"], Path("/b/home"), Path("/s"), Path("/p/UMU-Proton-9"), "/run/user/1000",
                   {"DISPLAY": ":0", "WAYLAND_DISPLAY": "wayland-0"})
    pairs = {(a[i], a[i + 1], a[i + 2]) for i in range(len(a) - 2)}
    assert ("--bind", "/b/home", "/var/home/u") in pairs, "private home replaces the real one"
    assert ("--ro-bind", str(dl), "/var/home/u/App/setup.exe") in pairs, "program is read-only"
    assert ("/p/UMU-Proton-9", "--tmp-overlay", "/p/UMU-Proton-9") in pairs, "Proton writes are throwaway"
    assert all(src != "/var/home/u" for flag, src, _ in pairs if flag in ("--bind", "--ro-bind")), "real home never mounted"
    assert "--unshare-pid" in a and "--new-session" in a
    f = bwrap_args(dl, [], Path("/b/home"), Path("/s"), Path("/p/UMU-Proton-9"), None, {},
                   folders=[(Path("/var/home/u/Documents"), Path("/var/home/u/Documents"))])
    assert f.index("/var/home/u/Documents") > f.index("/b/home"), "an allowed folder is mounted over the private home"
    assert "/var/home/u/Documents" not in a, "no folders unless allowed"
    assert "/sys" not in a, "never all of /sys"
    assert a.index("/var/home/u/App/setup.exe") > a.index("/var/home/u"), "program mounted over the private home"
    assert a[a.index("--uid") + 1] == "1000", "never root inside the sandbox"
    assert ("--chdir", "/var/home/u/App") in {(a[i], a[i + 1]) for i in range(len(a) - 1)}, "starts in its own folder"
    assert "/dev/input" in a and "/dev/nvidiactl" in a and "/dev/nvidia0" in a, "controllers and NVIDIA graphics"
    assert not any(x.startswith(("/dev/uinput", "/dev/uhid", "/dev/hidraw")) for x in a), "nothing that could type into the desktop"
    assert own_box(HOME / "Sandbox/x-0123456789abcdef/other.exe", HOME / "Sandbox") == "x-0123456789abcdef", "its folder says which sandbox"
    assert own_box(HOME / "Sandbox/x.exe", HOME / "Sandbox") is None and own_box(HOME / "Sandbox/plain/x.exe", HOME / "Sandbox") is None
    assert own_box(HOME / "Downloads/x.exe", HOME / "Sandbox") is None
    assert "/dev/input" not in bwrap_args(dl, [], Path("/b"), Path("/s"), Path("/p"), None, {}, controllers=False), "not when it could read keyboards"
    places = {HOME / "Downloads", HOME / "Documents"}
    assert own_folder(HOME / "Downloads/MyGame", places), "a program's own folder"
    for no in (HOME, HOME / "Downloads", HOME.parent, Path("/"), HOME / ".config/x"):
        assert not own_folder(no, places), f"{no}: never offered"
    assert not any("pipewire" in x or "pulse" in x for x in a), "no sound/microphone by default"
    assert "/tmp/.X11-unix" in a, "X11 only as fallback when Proton lacks Wine-Wayland"
    assert a[-3:] == ["umu-run", "/var/home/u/App/setup.exe", "/S"]
    w = with_seccomp(["bwrap", "--die-with-parent", "--", "x"], Path("/f.bpf"))
    assert w[:5] == ["sh", "-c", 'exec "$@" 10<"$0"', "/f.bpf", "bwrap"] and w[5:7] == ["--seccomp", "10"] and w[-2:] == ["--", "x"]
    assert wine_cmd(Path("/var/home/u/Setup.MSI"), ["/qb"]) == ["msiexec", "/i", "Z:\\var\\home\\u\\Setup.MSI", "/qb"]
    assert wine_cmd(Path("/h/a&calc.bat"), []) == ["/h/a&calc.bat"], "a batch file is never handed to cmd"

    s = bwrap_args(dl, [], Path("/b"), Path("/s"), Path("/p"), "/run/user/1000", {}, sound=True)
    assert "/run/user/1000/pulse/native" in s and "/run/user/1000/pipewire-0" not in s, "sound on request, by the one way Wine uses"
    w = bwrap_args(dl, [], Path("/b"), Path("/s"), Path("/p"), "/run/user/1000", {"DISPLAY": ":0"}, wayland=True)
    assert "/tmp/.X11-unix" not in w and "PROTON_ENABLE_WAYLAND" in w and "--unshare-ipc" in w, "Wayland: no X11"
    b = bwrap_args(HOME / "Games/Foo/foo.exe", [], Path("/b"), Path("/s"), Path("/p"), None, {}, resolv=Path("/r"))
    assert b[-1] == "/var/home/u/App/foo.exe" and str(HOME / "Games/Foo") not in b, "folder never mounted"
    assert b.index(os.path.realpath("/etc/resolv.conf")) > b.index("/etc"), "own resolv.conf mounted over the host /etc"
    assert "--no-map-gw" in PASTA and all(PASTA[PASTA.index(f) + 1] == "none" for f in ("-t", "-u", "-T", "-U")), \
        "no route from the sandbox to host loopback services, no port forwarding"

    import tempfile
    global CFG, TRUSTED, CHOICES
    CFG = Path(tempfile.mkdtemp()); TRUSTED = CFG / "trusted-exes"; CHOICES = CFG / "exe-choices"
    assert remembered("aa") is None
    remember("aa", "sandbox"); remember("bb", "sandbox-sound")
    assert remembered("aa") == "sandbox" and remembered("bb") == "sandbox-sound"
    trust("aa"); forget("aa")
    assert remembered("aa") is None and not is_trusted("aa") and remembered("bb") == "sandbox-sound", "forget: one program only"
    remember("bb", "sandbox")
    assert remembered("bb") == "sandbox" and CHOICES.read_text().count("bb") == 1, "a new choice replaces the old one"
    subprocess.run(["rm", "-rf", str(CFG)])
    DATA = Path(tempfile.mkdtemp())
    (DATA / "umu/compatibilitytools/UMU-Proton-9").mkdir(parents=True)
    (DATA / "umu/compatibilitytools/UMU-Proton-9/proton").write_text("PROTON_ENABLE_WAYLAND")
    assert wine_wayland(proton_dir())
    assert "UMU_RUNTIME_UPDATE" not in umu_env(), "first run: allow update check"
    assert umu_env()["UMU_RUNTIME_UPDATE"] == "0", "same day: offline"
    assert umu_env()["PROTONPATH"].endswith("UMU-Proton-9")
    assert "UMU_RUNTIME_UPDATE" not in umu_env(now=time.time() + 2 * 86400), "next day: check again"
    subprocess.run(["rm", "-rf", str(DATA)])

    global NAMES, BOXES, SHARED, OFFLINE, FOLDERS, OLD_RECORDS, run_trusted
    t = Path(tempfile.mkdtemp())
    CFG, NAMES, BOXES, SHARED = t, t / "exe-names", t / "boxes", t / "Sandbox"
    TRUSTED, CHOICES, OFFLINE, FOLDERS, OLD_RECORDS = (t / n for n in ("trusted-exes", "exe-choices", "offline-exes", "exe-folders", "old-exe-records"))
    exe = t / "setup.exe"
    exe.write_text("program")
    real = sha256(exe)
    twin = real[:8] + "0" * 56
    short, long = f"setup-{real[:8]}", f"setup-{real[:16]}"
    ran = []
    run_trusted = lambda e, args: ran.append(e)

    def old_folders(*recorded):
        for d in (BOXES, SHARED):
            shutil.rmtree(d, ignore_errors=True)
            (d / short).mkdir(parents=True)
            (d / short / "mine").write_text("x")
        for f in (TRUSTED, CHOICES, OFFLINE, OLD_RECORDS):
            f.unlink(missing_ok=True)
        NAMES.write_text("".join(f"{r}\t/x/setup.exe\n" for r in recorded))

    def launch():
        main(["--trusted", str(exe)])

    def left_alone():
        return all((d / short / "mine").exists() and not (d / long).exists() for d in (BOXES, SHARED))

    def moved():
        return all((d / long / "mine").exists() for d in (BOXES, SHARED)) and not os.path.lexists(BOXES / short) \
            and os.readlink(SHARED / short) == long

    old_folders()
    launch()
    launch()
    assert left_alone() and real in NAMES.read_text() and real not in OLD_RECORDS.read_text(), "first seen now: could be crafted, on its second launch too"
    assert f"~/Sandbox/{short}," in old_folder_notice(exe, real), "starting fresh: it hears where the old folder is"
    old_folders()
    other = t / "x.exe"
    other.write_text("program")
    main(["--trusted", str(other)])
    launch()
    assert left_alone(), "the same under another name first"
    old_folders(twin)
    launch()
    assert left_alone(), "another program is on record with these 8 digits, this one isn't"
    old_folders(real, twin)
    launch()
    assert left_alone(), "two programs on record with these 8 digits: whose it is can't be told"
    NAMES.write_text(f"{real}\t/x/setup.exe\n")
    launch()
    assert left_alone(), "nor later, when one of them is gone from the list"
    old_folders()
    NAMES.write_text(f"{real}\t/x/other.exe\n")
    launch()
    assert left_alone(), "on record under another file name: that one's folder is another folder"
    old_folders()
    CHOICES.write_text(f"{real} sandbox\n")
    TRUSTED.write_text(twin + "\n")
    launch()
    assert left_alone(), "another program in any of the records counts"
    old_folders()
    CHOICES.write_text(f"{real} sandbox\n")
    launch()
    assert moved(), "a remembered choice is a record too: this file name was never written down"
    old_folders()
    OFFLINE.write_text(real + "\n")
    launch()
    assert left_alone(), "blocked in the firewall is no record: a file can be blocked without ever having run"
    old_folders(real)
    OFFLINE.write_text(twin + "\n")
    launch()
    assert moved(), "nor does a blocked file with these digits cost the program on record its files"
    old_folders(real)
    old_records(real)
    NAMES.write_text(f"{twin}\t/x/setup.exe\n")
    launch()
    assert moved(), "a crafted file run first doesn't cost the program on record its files, nor does removing it in Settings"
    old_folders(real)
    launch()
    launch()
    assert moved(), "the one program on record keeps its files, and a link stays at the old name in ~/Sandbox"
    assert ran[-1] == exe.resolve(), "a program elsewhere stays where it is"
    assert old_folder_notice(exe, real) == "", "nothing to tell"
    old_folders(real)
    inside = SHARED / short / "bin/setup.exe"
    inside.parent.mkdir()
    inside.write_text("program")
    main(["--trusted", str(inside)])
    assert ran[-1] == SHARED.resolve() / long / "bin/setup.exe" and ran[-1].is_file(), "it was inside its folder: it moved along"
    assert str(ran[-1]) in NAMES.read_text(), "and is recorded at the new place"
    ran.clear()
    main(["--trusted", str(inside)])
    assert ran == [SHARED.resolve() / long / "bin/setup.exe"], "a shortcut made before the move still starts it"
    old_folders(real)
    (SHARED / long).mkdir()
    main(["--trusted", str(exe)])
    assert (SHARED / short / "mine").exists() and not list((SHARED / long).iterdir()), "a long folder is never replaced"
    assert (BOXES / long / "mine").exists(), "each folder on its own: a move that stopped halfway finishes"
    old_folders(real)
    shutil.rmtree(SHARED / short)

    # Saved files: out of the Windows folders, nothing replaced, nothing followed through a link.
    c, to = t / "drive_c", t / "to"
    (c / WIN_USER / "Documents/Music").mkdir(parents=True)
    (c / WIN_USER / "Documents/letter.txt").write_text("new")
    to.mkdir()
    (to / "letter.txt").write_text("old")
    move_saved(c, "Documents", to)
    assert (to / "letter.txt").read_text() == "old" and (to / "letter (2).txt").read_text() == "new" and not (to / "Music").exists()
    mine = t / "mine"
    mine.mkdir()
    (mine / "secret").write_text("x")
    os.symlink(mine, c / WIN_USER / "Pictures")
    move_saved(c, "Pictures", to)
    assert (mine / "secret").exists() and not (to / "secret").exists(), "a link in its folders leads nowhere"
    os.symlink(mine, to / "Pictures")
    assert not own_saved_folder(to, "Pictures").is_symlink() and (mine / "secret").exists(), "a link it left is replaced, not followed"
    (to / "Music").write_text("a file")
    assert own_saved_folder(to, "Music") is None
    (to / "Templates").mkdir()
    (to / "Videos").mkdir()
    (to / "Videos/film").write_text("x")
    tidy_documents(to)
    assert not (to / "Templates").exists() and (to / "Videos/film").exists(), "only empty ones go"
    binds = saved_binds(t / "nothing", to, [])
    assert binds[0] == (to / "Documents", HOME / "prefix/drive_c" / WIN_USER / "Documents")
    (SHARED / short).symlink_to(t)
    main(["--trusted", str(exe)])
    assert (SHARED / short).is_symlink() and not (SHARED / long).exists(), "a link is never moved"
    # Installed programs in Start: only real shortcuts, nothing from the program on a command line, no way out by links.
    DATA = t / "data"
    d = t / "drive_c"
    menu = d / "users/steamuser/AppData/Roaming/Microsoft/Windows/Start Menu/Programs/Game"
    menu.mkdir(parents=True)
    (menu / "My Game.lnk").write_text("x")
    (menu / "Uninstall My Game.lnk").write_text("x")
    (menu / "Read Me.lnk").write_text("x")
    (menu / "notes.txt").write_text("x")
    (menu / "Evil\\\nExec=rm -rf.lnk").write_text("x")
    (menu / "Link.lnk").symlink_to(t / "setup.exe")
    (d / "users/Public").mkdir(parents=True)
    (d / "users/Public/Desktop").symlink_to(t)   # a program can point these at your real folders
    (t / "Outside.lnk").write_text("x")
    names = [n for n, _ in shortcuts(d)]
    assert "My Game" in names and "Outside" not in names and "Link" not in names, names
    assert not [n for n in names if "Uninstall" in n or "Read Me" in n], names
    box_id = "a" * 64
    sync_start(box_id, d)
    made = {f.read_text(encoding="utf-8") for f in (DATA / "applications").glob("fennek-exe-*.desktop")}
    assert len(made) == 2 and any("Name=My Game (sandbox)\n" in m for m in made)
    for m in made:
        lines = m.split("\n")
        assert sum(l.startswith("Exec=") for l in lines) == 1 and re.fullmatch(r"Exec=fennek-run-exe --box a{64} [0-9a-f]{16}", next(l for l in lines if l.startswith("Exec="))), m
    sync_start("trusted", d)
    assert any("Name=My Game\n" in f.read_text(encoding="utf-8") for f in (DATA / "applications").glob("fennek-exe-trusted*")), "only sandboxed ones are marked"
    for f in (DATA / "applications").glob("fennek-exe-trusted*"):
        f.unlink()
    (menu / "My Game.lnk").unlink()
    sync_start(box_id, d)
    assert not any("Name=My Game (sandbox)\n" in f.read_text(encoding="utf-8") for f in (DATA / "applications").glob("fennek-exe-*.desktop")), "gone with its shortcut"
    for i in range(40):
        (menu / f"p{i}.lnk").write_text("x")
    assert len(shortcuts(d)) == MOST_ENTRIES, "a program can't flood Start"
    global MOST_LOOKED_AT
    deep = t / "deep"
    for i in range(30):
        (deep / "users/Public/Desktop" / f"f{i}").mkdir(parents=True)
    MOST_LOOKED_AT = 10
    assert shortcuts(deep) == [], "the walk ends even if the folders don't"
    MOST_LOOKED_AT = 5000
    assert clean_name("a\u2028b\\c") == "abc" and clean_name("\n") == "Program"
    assert clean_name("Fire\u202efox\u200b  \u3000 x" + " " * 200 + "y") == "Firefox x y", "nothing hides the mark"
    assert len(clean_name("x" * 200)) == 40
    assert clean_name("\u3164\u2800\u0301") == "Program" and clean_name("Гра 2") == "Гра 2", "blank letters go, real ones stay"
    a = bwrap_args(Path("x"), [], Path("/b"), Path("/s"), Path("/p"), None, {}, inside=HOME / "prefix/drive_c/x.lnk")
    assert a[-1] == "/var/home/u/prefix/drive_c/x.lnk" and "/var/home/u/App/x" not in a, "an installed program runs from inside, nothing extra mounted"
    very_long = Path("я" * 120 + ".exe")   # 240 bytes: it fitted with 8 digits, not with 16
    assert folder_name(very_long, real) == "я" * 119 + "-" + real[:16], "cut to fit, on a letter's edge"
    assert old_folder_name(very_long, real) == "я" * 120 + "-" + real[:8], "the old name stays uncut: it must still be found"
    assert len(folder_name(Path("x" * 251 + ".exe"), real).encode()) == 255
    shutil.rmtree(t)
    print("selftest ok")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]) or 0)
