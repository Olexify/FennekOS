#!/usr/bin/python3
"""Run a Windows program (.exe/.msi) with Proton. Unknown programs run in a sandbox (Fennek OS auto-containment).

Usage: fennek-run-exe FILE [ARGS...]                  asks once per unknown program
       fennek-run-exe --sandbox FILE [ARGS...]        always sandboxed, no sound, no questions
       fennek-run-exe --sandbox-sound FILE [ARGS...]  sandboxed with sound (and therefore microphone)
       fennek-run-exe --trusted FILE [ARGS...]        normal run, no sandbox
       fennek-run-exe --selftest

Sandbox: own private home (Wine prefix inside); sees only ~/Sandbox/<program> as "Shared", its own folder
read-only, Proton through a throwaway overlay. Own network namespace (pasta): internet works, but host-only
sockets (X11 abstract socket, D-Bus, local services) are unreachable. Wayland display when Proton supports it,
so no X11 snooping. No sound/microphone unless asked for. Your real home and other programs are invisible.
"""
import hashlib, os, re, shutil, subprocess, sys, time
from pathlib import Path

HOME = Path.home()
CFG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "fennek"
DATA = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")
TRUSTED = CFG / "trusted-exes"           # one sha256 per line
OFFLINE = CFG / "offline-exes"           # sha256s blocked by fennek-firewall: sandbox gets no network at all
BOXES = DATA / "fennek" / "sandboxes"    # private home per sandboxed program
SHARED = HOME / "Sandbox"                # ~/Sandbox/<program> = the only real folder it can see
GUI = bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))
UMU = {"GAMEID": "umu-default"}
SANDBOX_DNS = "169.254.1.1"             # pasta answers DNS here and forwards to the host's resolver
PASTA = ["pasta", "--config-net", "--quiet",
         "--no-map-gw",                                             # gateway must NOT reach host 127.0.0.1 services
         "-t", "none", "-u", "none", "-T", "none", "-U", "none",    # no port forwarding in either direction
         "--dns-forward", SANDBOX_DNS]


def say(text, kind="msgbox"):
    if GUI:
        subprocess.run(["kdialog", "--title", "Windows program", f"--{kind}", text])
    else:
        print(text, file=sys.stderr)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def is_trusted(digest):
    return TRUSTED.is_file() and digest in TRUSTED.read_text().split()


def trust(digest):
    CFG.mkdir(parents=True, exist_ok=True)
    with open(TRUSTED, "a") as f:
        f.write(digest + "\n")


def safe_name(exe):
    """Folder name from the file name. Never '..', '.', hidden or empty: a download called '...exe'
    must not turn ~/Sandbox/<name> into ~/Sandbox/.. (= your whole home)."""
    stem = re.sub(r"\.(exe|msi|bat|com)$", "", exe.name, flags=re.I)   # not Path.stem: odd names like '...exe'
    return re.sub(r"[^\w .+-]", "_", stem).strip(" .") or "program"


def folder_name(exe, digest):
    """Per program, not per file name: a malicious setup.exe must not share a folder with a real setup.exe."""
    return f"{safe_name(exe)}-{digest[:8]}"


def proton_dir():
    """Newest Proton that umu downloaded, or None."""
    found = [p for d in (DATA / "umu/compatibilitytools", DATA / "Steam/compatibilitytools.d")
             if d.is_dir() for p in d.iterdir() if (p / "proton").is_file()]
    return max(found, key=lambda p: p.stat().st_mtime, default=None)


def wine_wayland(proton):
    """Does this Proton have Wine's Wayland driver? Then the sandbox needs no X11 at all."""
    try:
        return "PROTON_ENABLE_WAYLAND" in (proton / "proton").read_text(errors="ignore")
    except OSError:
        return False


def umu_env(now=None):
    """umu settings for a normal (trusted) run. umu checks Valve/GitHub for updates on every launch;
    we let it do that at most once a day, otherwise it runs offline with the Proton we have."""
    env, stamp, proton = dict(UMU), DATA / "fennek" / "umu-last-update", proton_dir()
    now = now or time.time()
    if proton and stamp.exists() and now - stamp.stat().st_mtime < 86400:
        env.update(PROTONPATH=str(proton), UMU_RUNTIME_UPDATE="0")
    else:
        stamp.parent.mkdir(parents=True, exist_ok=True)
        stamp.touch()
    return env


def ensure_proton():
    """First use: let umu (trusted) download its runtime + Proton outside any sandbox."""
    if proton_dir() and (DATA / "umu").is_dir():
        return proton_dir()
    say("Setting up Windows support (one-time download, a few hundred MB)…", "passivepopup")
    tmp = BOXES / ".bootstrap"
    subprocess.run(["umu-run", "wineboot", "-u"], env={**os.environ, **UMU, "WINEPREFIX": str(tmp)})
    subprocess.run(["rm", "-rf", str(tmp)])
    return proton_dir()


def placement(exe, shared):
    """(file to mount read-only or None, the program's path inside the sandbox).
    Only the file itself is ever mounted: guessing which folders are "safe" to expose can't be done right
    (~/Projects/tool.exe would expose all projects). A program that needs its other files goes into its
    shared folder ~/Sandbox/<name>, which the sandbox sees as ~/Shared: then it runs from there."""
    if exe.is_relative_to(shared):
        return None, HOME / "Shared" / exe.relative_to(shared)
    return exe, HOME / "App" / exe.name


def bwrap_args(exe, args, box_home, shared, proton, runtime_dir, display_env, sound=False, wayland=False,
               resolv=None, uid=1000, gid=1000):
    src, target = placement(exe, shared)
    a = ["bwrap",
         # pasta's namespace makes us "root" (mapped to the real user); map back to the user's own id,
         # umu refuses to run as root and nothing inside should look privileged.
         "--unshare-user", "--uid", str(uid), "--gid", str(gid),
         "--ro-bind", "/usr", "/usr", "--ro-bind", "/etc", "/etc",
         "--symlink", "usr/bin", "/bin", "--symlink", "usr/sbin", "/sbin",
         "--symlink", "usr/lib", "/lib", "--symlink", "usr/lib64", "/lib64",
         "--proc", "/proc", "--dev", "/dev", "--dev-bind-try", "/dev/dri", "/dev/dri",
         # Only the sysfs parts GPU drivers need (not all of /sys: less hardware fingerprinting).
         "--ro-bind-try", "/sys/dev/char", "/sys/dev/char", "--ro-bind-try", "/sys/devices", "/sys/devices",
         "--ro-bind-try", "/sys/class/drm", "/sys/class/drm", "--ro-bind-try", "/sys/bus/pci", "/sys/bus/pci",
         "--tmpfs", "/tmp", "--tmpfs", "/var/tmp",
         "--bind", str(box_home), str(HOME),
         "--bind", str(shared), str(HOME / "Shared"),
         # Runtime + Proton: writable overlay (pressure-vessel needs lock files), writes vanish
         # into a tmpfs, so the shared real copies can never be modified from inside.
         "--overlay-src", str(DATA / "umu"), "--tmp-overlay", str(DATA / "umu"),
         "--overlay-src", str(proton), "--tmp-overlay", str(proton),
         "--unshare-pid", "--unshare-uts", "--die-with-parent", "--new-session",
         "--unsetenv", "DBUS_SESSION_BUS_ADDRESS",
         "--setenv", "HOME", str(HOME), "--setenv", "WINEPREFIX", str(HOME / "prefix"),
         "--setenv", "PROTONPATH", str(proton), "--setenv", "UMU_RUNTIME_UPDATE", "0"]
    if src:
        a += ["--ro-bind", str(src), str(target)]
    if str(HOME).startswith("/var/home/"):
        a += ["--symlink", "var/home", "/home"]
    if resolv:   # host's resolv.conf points at 127.0.0.53, which is unreachable from the sandbox's network
        a += ["--ro-bind", str(resolv), "/etc/resolv.conf"]
    if runtime_dir:
        a += ["--dir", runtime_dir, "--chmod", "0700", runtime_dir]
        socks = [display_env.get("WAYLAND_DISPLAY", "wayland-0")]   # Wayland: apps can't spy on each other
        if sound:
            socks += ["pipewire-0", "pulse/native"]                  # playback AND recording
        for s in socks:
            a += ["--ro-bind-try", f"{runtime_dir}/{s}", f"{runtime_dir}/{s}"]
    if wayland:
        a += ["--setenv", "PROTON_ENABLE_WAYLAND", "1", "--unsetenv", "DISPLAY", "--unshare-ipc"]
    elif display_env.get("DISPLAY"):
        # Fallback for Protons without Wine-Wayland: X11 lets the program see other X11 (Xwayland) windows.
        a += ["--ro-bind-try", "/tmp/.X11-unix", "/tmp/.X11-unix"]
        if display_env.get("XAUTHORITY"):
            a += ["--ro-bind-try", display_env["XAUTHORITY"], display_env["XAUTHORITY"]]
    for k, v in UMU.items():
        a += ["--setenv", k, v]
    return a + ["--", "umu-run", str(target), *args]


def run_sandboxed(exe, digest, args, sound=False):
    proton = ensure_proton()
    if not proton:
        return say("Couldn't set up Windows support (no internet?).", "error")
    if not shutil.which("pasta"):
        return say("Sandbox networking (pasta) is missing; not running unsandboxed.", "error")
    name = folder_name(exe, digest)
    box_home = BOXES / name / "home"
    shared = SHARED / name
    for d in (box_home, shared):
        d.mkdir(parents=True, exist_ok=True)
    if shared.resolve().parent != SHARED.resolve():   # belt and braces against path tricks
        return say(f"Refusing odd program name: {exe.name}", "error")
    wayland = bool(os.environ.get("WAYLAND_DISPLAY")) and wine_wayland(proton)
    resolv = box_home.parent / "resolv.conf"
    resolv.write_text(f"nameserver {SANDBOX_DNS}\n")
    say(f"{exe.name} runs in a sandbox and only sees ~/Sandbox/{name}. "
        "If it needs its other files, move them there and start it from that folder.", "passivepopup")
    cmd = bwrap_args(exe, args, box_home, shared, proton, os.environ.get("XDG_RUNTIME_DIR"), os.environ,
                     sound=sound, wayland=wayland, resolv=resolv, uid=os.getuid(), gid=os.getgid())
    if OFFLINE.is_file() and digest in OFFLINE.read_text().split():
        return subprocess.run([cmd[0], "--unshare-net", *cmd[1:]]).returncode   # firewall: no network at all
    # Own network namespace with internet via pasta: host-only sockets and host loopback become unreachable.
    return subprocess.run([*PASTA, "--", *cmd]).returncode


def run_trusted(exe, args):
    return subprocess.run(["umu-run", str(exe), *args], env={**os.environ, **umu_env()}).returncode


def ask(exe, digest):
    """Unknown program → sandbox | sandbox-sound | vt | trust | None (cancel)."""
    text = (f"{exe.name} isn't trusted yet.\n\nIn the sandbox it can't see your files, "
            f"only the folder ~/Sandbox/{folder_name(exe, digest)}.")
    if not GUI:
        return "sandbox"
    r = subprocess.run(["kdialog", "--title", "Unknown Windows program", "--menu", text,
                        "sandbox", "Run in sandbox (recommended)",
                        "sandbox-sound", "Run in sandbox with sound (it can also use your microphone)",
                        "vt", "Check with VirusTotal first",
                        "trust", "I trust it: run normally"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def main(argv):
    if argv == ["--selftest"]:
        return selftest()
    mode = argv.pop(0) if argv and argv[0] in ("--sandbox", "--sandbox-sound", "--trusted") else None
    if not argv:
        sys.exit(__doc__)
    exe = Path(argv[0]).resolve()
    if not exe.is_file():
        return say(f"Not found: {exe}", "error")
    digest = sha256(exe)
    if mode == "--trusted" or (mode is None and is_trusted(digest)):
        return run_trusted(exe, argv[1:])
    while mode is None:
        choice = ask(exe, digest)
        if choice == "vt":
            subprocess.run(["fennek-vt-check", str(exe)])
        elif choice == "trust":
            trust(digest)
            return run_trusted(exe, argv[1:])
        elif choice in ("sandbox", "sandbox-sound"):
            mode = "--" + choice
        else:
            return 0
    return run_sandboxed(exe, digest, argv[1:], sound=mode == "--sandbox-sound")


def selftest():
    global HOME, DATA
    HOME = Path("/var/home/u")
    for bad in ("...exe", "..exe", " . .exe", "....exe"):
        assert safe_name(Path(bad)) == "program", f"{bad!r} must not become a path trick"
    assert safe_name(Path(".evil.exe")) == "evil" and safe_name(Path("My Game.exe")) == "My Game"

    assert folder_name(Path("setup.exe"), "1a2b3c4d99") == "setup-1a2b3c4d", "same name, other program: other folder"
    dl = HOME / "Downloads/setup.exe"
    sh = HOME / "Sandbox/setup-1a2b3c4d"
    for f in (dl, HOME / "Projects/tool.exe", HOME / ".config/x.exe"):
        assert placement(f, sh) == (f, HOME / "App" / f.name), f"{f}: only the file is mounted, never its folder"
    assert placement(sh / "bin/setup.exe", sh) == (None, HOME / "Shared/bin/setup.exe"), "inside its folder: run from Shared"

    a = bwrap_args(dl, ["/S"], Path("/b/home"), Path("/s"), Path("/p/UMU-Proton-9"), "/run/user/1000",
                   {"DISPLAY": ":0", "WAYLAND_DISPLAY": "wayland-0"})
    pairs = {(a[i], a[i + 1], a[i + 2]) for i in range(len(a) - 2)}
    assert ("--bind", "/b/home", "/var/home/u") in pairs, "private home replaces the real one"
    assert ("--ro-bind", str(dl), "/var/home/u/App/setup.exe") in pairs, "program is read-only"
    assert ("/p/UMU-Proton-9", "--tmp-overlay", "/p/UMU-Proton-9") in pairs, "Proton writes are throwaway"
    assert all(src != "/var/home/u" for flag, src, _ in pairs if flag in ("--bind", "--ro-bind")), "real home never mounted"
    assert "--unshare-pid" in a and "--new-session" in a
    assert "/sys" not in a, "never all of /sys"
    assert a.index("/var/home/u/App/setup.exe") > a.index("/var/home/u"), "program mounted over the private home"
    assert a[a.index("--uid") + 1] == "1000", "never root inside the sandbox"
    assert not any("pipewire" in x or "pulse" in x for x in a), "no sound/microphone by default"
    assert "/tmp/.X11-unix" in a, "X11 only as fallback when Proton lacks Wine-Wayland"
    assert a[-3:] == ["umu-run", "/var/home/u/App/setup.exe", "/S"]

    s = bwrap_args(dl, [], Path("/b"), Path("/s"), Path("/p"), "/run/user/1000", {}, sound=True)
    assert "/run/user/1000/pipewire-0" in s, "sound on request"
    w = bwrap_args(dl, [], Path("/b"), Path("/s"), Path("/p"), "/run/user/1000", {"DISPLAY": ":0"}, wayland=True)
    assert "/tmp/.X11-unix" not in w and "PROTON_ENABLE_WAYLAND" in w and "--unshare-ipc" in w, "Wayland: no X11"
    b = bwrap_args(HOME / "Games/Foo/foo.exe", [], Path("/b"), Path("/s"), Path("/p"), None, {}, resolv=Path("/r"))
    assert b[-1] == "/var/home/u/App/foo.exe" and str(HOME / "Games/Foo") not in b, "folder never mounted"
    assert b.index("/etc/resolv.conf") > b.index("/etc"), "own resolv.conf mounted over the host /etc"
    assert "--no-map-gw" in PASTA and all(PASTA[PASTA.index(f) + 1] == "none" for f in ("-t", "-u", "-T", "-U")), \
        "no route from the sandbox to host loopback services, no port forwarding"

    import tempfile
    DATA = Path(tempfile.mkdtemp())
    (DATA / "umu/compatibilitytools/UMU-Proton-9").mkdir(parents=True)
    (DATA / "umu/compatibilitytools/UMU-Proton-9/proton").write_text("PROTON_ENABLE_WAYLAND")
    assert wine_wayland(proton_dir())
    assert "UMU_RUNTIME_UPDATE" not in umu_env(), "first run: allow update check"
    assert umu_env()["UMU_RUNTIME_UPDATE"] == "0", "same day: offline"
    assert umu_env()["PROTONPATH"].endswith("UMU-Proton-9")
    assert "UMU_RUNTIME_UPDATE" not in umu_env(now=time.time() + 2 * 86400), "next day: check again"
    subprocess.run(["rm", "-rf", str(DATA)])
    print("selftest ok")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]) or 0)
