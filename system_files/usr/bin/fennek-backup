#!/usr/bin/python3
"""Back up your folders to a USB drive (like the classic File History).

A copy of Documents, Pictures, Music, Videos and Desktop on the drive you chose, refreshed every hour while the
drive is connected (fennek-backup.timer). Files you changed or deleted are not lost: the previous version moves
to "Older versions/<date>" on the drive, kept for a year. Works on any drive format (exFAT, NTFS, ext4...).

  fennek-backup drives [--json]   connected drives you can back up to
  fennek-backup use UUID          back up to this drive (by its filesystem ID, so any mount point works)
  fennek-backup off               stop backing up (the backup on the drive stays)
  fennek-backup run [--if-due]    back up now (--if-due: only if the drive is here and the last run is >1 h old)
  fennek-backup status [--json]
  fennek-backup --selftest
"""
import json, os, re, shutil, socket, subprocess, sys, time
from datetime import datetime, timedelta
from pathlib import Path

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "fennek" / "backup.json"
FOLDERS = ("DOCUMENTS", "PICTURES", "MUSIC", "VIDEOS", "DESKTOP")
KEEP_DAYS = 365


def load():
    try:
        return json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        return {}


def save(cfg):
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG.with_suffix(".new")
    tmp.write_text(json.dumps(cfg, indent=2))
    tmp.replace(CONFIG)


def parse_pairs(line):
    """findmnt -P line: UUID="..." LABEL="My Drive" TARGET="..." (\\x20-style escapes decoded)."""
    out = {}
    for key, val in re.findall(r'(\w+)="((?:[^"\\]|\\.)*)"', line):
        out[key] = re.sub(r"\\x([0-9a-fA-F]{2})", lambda m: chr(int(m[1], 16)), val)
    return out


def drives():
    """Mounted removable drives: [{uuid, label, path, free, size}] (USB sticks and disks mounted for this user)."""
    out = subprocess.run(["findmnt", "-n", "-P", "-o", "UUID,LABEL,TARGET", "-t", "vfat,exfat,ntfs,ntfs3,fuseblk,ext4,btrfs,xfs"],
                         capture_output=True, text=True).stdout
    found = []
    for line in out.splitlines():
        f = parse_pairs(line)
        uuid, label, target = f.get("UUID", ""), f.get("LABEL", ""), f.get("TARGET", "")
        if not uuid or not target.startswith(("/run/media/", "/media/")):
            continue
        st = shutil.disk_usage(target)
        found.append({"uuid": uuid, "label": label or Path(target).name, "path": target, "free": st.free, "size": st.total})
    return found


def mountpoint(uuid):
    return next((d["path"] for d in drives() if d["uuid"] == uuid), None)


def plugged_in(uuid):
    return bool(re.fullmatch(r"[0-9A-Za-z-]+", uuid or "")) and os.path.exists(f"/dev/disk/by-uuid/{uuid}")


def mount_drive(uuid):
    """(where it's mounted, whether this just did it), (None, False) if it can't be. Never asks: a timer runs this too."""
    mount = mountpoint(uuid)
    if mount or not plugged_in(uuid):
        return mount, False
    subprocess.run(["udisksctl", "mount", "--no-user-interaction", "-b", f"/dev/disk/by-uuid/{uuid}"], capture_output=True)
    mount = mountpoint(uuid)
    return mount, bool(mount)


def plugged_drives(mounted=()):
    """Removable drives plugged in but not open yet, listed by what udev knows: nothing on them gets read until one is chosen."""
    out = subprocess.run(["lsblk", "-J", "-l", "-b", "-o", "UUID,LABEL,FSTYPE,HOTPLUG,MOUNTPOINT,SIZE"], capture_output=True, text=True).stdout
    return parse_plugged(out, mounted)


def parse_plugged(out, mounted=()):
    try:
        rows = json.loads(out)["blockdevices"]
    except (ValueError, KeyError):
        return []
    return [{"uuid": r["uuid"], "label": r.get("label") or "USB drive", "path": "", "free": 0, "size": r.get("size") or 0}
            for r in rows if r.get("uuid") and r.get("hotplug") and not r.get("mountpoint") and r["uuid"] not in mounted
            and r.get("fstype") in ("vfat", "exfat", "ntfs", "ext4", "btrfs", "xfs")]


def notify(title, text):
    subprocess.run(["notify-send", "-a", "Backup", "-i", "drive-removable-media", title, text], capture_output=True)


def notice_due(seen, key, now, every):
    return now - seen.get(key, 0) >= every


def warn(cfg, result, now=None):
    """From the hourly run: what went wrong, once a day; a backup getting old, after 14 days and then weekly. A drive that
    simply isn't there isn't a failure: a laptop's drive stays at home."""
    now = now or time.time()
    seen = cfg.setdefault("noticed", {})
    if result.startswith(("Backup incomplete", "Backup stopped", "This isn't your")) and notice_due(seen, "failed", now, 86400):
        seen["failed"] = now
        notify("Backup didn't finish", result)
    elif cfg.get("last") and now - cfg["last"] > 14 * 86400 and notice_due(seen, "old", now, 7 * 86400):
        seen["old"] = now
        notify("Your last backup is old", f"It's from {datetime.fromtimestamp(cfg['last']):%d %B}. Connect {cfg.get('label', 'the backup drive')} to back up.")
    else:
        return
    save(cfg)


def sources():
    out = []
    for kind in FOLDERS:
        p = subprocess.run(["xdg-user-dir", kind], capture_output=True, text=True).stdout.strip()
        if p and p != str(Path.home()) and os.path.isdir(p):
            out.append(p)
    sandbox = Path.home() / "Sandbox"   # what classic programs save
    if sandbox.is_dir() and not sandbox.is_symlink():
        out.append(str(sandbox))
    return out


def destination(mount, fresh=False):
    """The folder chosen when the drive was: renaming the computer later doesn't change it."""
    name = None if fresh else load().get("folder")
    return Path(mount) / "Fennek Backup" / (name if name and "/" not in name and name not in (".", "..") else f"{os.environ.get('USER', 'user')}@{socket.gethostname()}")


TOKEN = ".fennek-backup-id"


def real_dir(mount, path):
    """path (inside mount), created one level at a time. A drive is untrusted: a link anywhere on the way, or a
    path leading off the drive, could make a backup or clean-up write to or delete the user's own files."""
    root = os.path.realpath(mount)
    cur = Path(mount)
    for part in Path(path).relative_to(mount).parts:
        cur = cur / part
        if cur.is_symlink():
            raise ValueError(f"{cur} is a link")
        if not cur.exists():
            cur.mkdir()
        if not cur.is_dir():
            raise ValueError(f"{cur} is not a folder")
    real = os.path.realpath(cur)
    if real != root and not real.startswith(root + os.sep):
        raise ValueError(f"{cur} leads off the drive")
    return cur


def write_token(dest):
    """Random secret on the drive, also kept in the config: automatic backups go only to the drive that has it
    (a drive copying another drive's ID gets nothing)."""
    token = os.urandom(16).hex()
    fd = os.open(dest / TOKEN, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(token)
    return token


def read_token(dest):
    try:
        fd = os.open(dest / TOKEN, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return ""
    with os.fdopen(fd) as f:
        return f.read(64).strip()


def rsync_args(src, current, older):
    # -rt plus no owners/permissions/links: works on exFAT/NTFS too. --modify-window: FAT keeps 2 s timestamps.
    return ["rsync", "-rt", "--no-perms", "--no-owner", "--no-group", "--modify-window=2", "--delete",
            "--backup", f"--backup-dir={older}", "--exclude=.cache/", f"{src}/", f"{current}/{Path(src).name}/"]


def prune(older_root, now=None):
    """Drop "Older versions" folders past KEEP_DAYS (names are YYYY-MM-DD HH.MM). Links are never followed."""
    now = now or datetime.now()
    if older_root.is_symlink() or not older_root.is_dir():
        return []
    gone = []
    for d in older_root.iterdir():
        if d.is_symlink() or not d.is_dir():
            continue
        try:
            when = datetime.strptime(d.name, "%Y-%m-%d %H.%M")
        except ValueError:
            continue
        if now - when > timedelta(days=KEEP_DAYS):
            shutil.rmtree(d, ignore_errors=True)
            gone.append(d.name)
    return gone


def run(if_due=False):
    cfg = load()
    if not cfg.get("uuid"):
        return "Backup is off."
    if if_due and time.time() - max(cfg.get("last", 0), cfg.get("tried", 0)) < 3600:
        return "Backed up less than an hour ago."
    mount, opened = mount_drive(cfg["uuid"])
    if not mount:
        result = "The backup drive isn't connected."
    else:
        if if_due:
            cfg["tried"] = int(time.time())   # a full drive isn't copied to again every 15 minutes
            save(cfg)
        result = copy_all(mount)
        if opened:   # safe to pull between the hourly runs; busy is fine, then it stays open
            subprocess.run(["udisksctl", "unmount", "--no-user-interaction", "-b", f"/dev/disk/by-uuid/{cfg['uuid']}"], capture_output=True)
    if if_due:
        warn(load(), result)
    return result


def restore(mount):
    """The drive's copies back into your folders. Never replaces a file that's here, and what comes from a drive arrives
    plain, whatever it says about itself: nothing restored can be run by a double-click."""
    current = destination(mount) / "Current"
    if current.is_symlink() or not current.is_dir():
        return "No backup to restore on this drive."
    here = {Path(s).name: s for s in sources()}
    failed = []
    for folder in sorted(current.iterdir(), key=lambda p: p.name):
        # A drive is untrusted: its folder names never choose a place in home, or .config/autostart would run at sign-in.
        # Names this computer doesn't have (another language's Documents) go into a plain folder of their own.
        if folder.is_symlink() or not folder.is_dir() or folder.name.startswith("."):
            continue
        target = here.get(folder.name) or str(Path.home() / "Restored from backup" / folder.name)
        os.makedirs(target, exist_ok=True)
        rc = subprocess.run(["rsync", "-rt", "--ignore-existing", "--chmod=D755,F644", "--", f"{folder}/", f"{target}/"]).returncode
        if rc not in (0, 24):
            failed.append(folder.name)
    return "Restored, except " + ", ".join(failed) + "." if failed else "Your files are back. Nothing that was already here was replaced."


def has_backup(dest):
    current = dest / "Current"
    return not current.is_symlink() and current.is_dir() and any(True for _ in current.iterdir())


def choose_existing(dest):
    """A drive that already holds this account's backup: restore | fresh | None."""
    r = subprocess.run(["kdialog", "--title", "Backup", "--menu", "This drive already has a backup of your files.",
                        "restore", "Restore my files, then keep backing up here",
                        "fresh", "Start fresh (what's there now moves to Older versions for a year)"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def copy_all(mount):
    cfg = load()
    dest = destination(mount)
    if not cfg.get("token") or read_token(dest) != cfg["token"]:
        return "This isn't your backup drive any more (its backup doesn't match). Choose the drive again in Backup."
    stamp = datetime.now().strftime("%Y-%m-%d %H.%M")
    try:
        current, older = real_dir(mount, dest / "Current"), real_dir(mount, dest / "Older versions")
        if (older / stamp).is_symlink():
            raise ValueError("link in Older versions")
    except (ValueError, OSError) as e:
        return f"Backup stopped: the drive's backup folder looks wrong ({e})."
    failed = []
    for src in sources():
        try:
            real_dir(mount, current / Path(src).name)
        except (ValueError, OSError):
            failed.append(Path(src).name)
            continue
        rc = subprocess.run(rsync_args(src, current, older / stamp / Path(src).name)).returncode
        if rc not in (0, 24):   # 24 = some files vanished while copying: fine
            failed.append(Path(src).name)
    prune(older)
    if failed:
        return "Backup incomplete: " + ", ".join(failed) + " (is the drive full?)"
    cfg["last"] = int(time.time())
    save(cfg)
    os.sync()   # "Backed up" must be true when the drive is pulled right after it
    return "Backed up."


def status():
    cfg = load()
    return {"on": bool(cfg.get("uuid")), "uuid": cfg.get("uuid", ""), "label": cfg.get("label", ""), "connected": plugged_in(cfg.get("uuid")) or bool(cfg.get("uuid") and mountpoint(cfg["uuid"])),
            "last": cfg.get("last", 0), "folder": str(destination(mountpoint(cfg["uuid"]))) if cfg.get("uuid") and mountpoint(cfg["uuid"]) else ""}


def selftest():
    import tempfile
    a = rsync_args("/home/u/Documents", "/m/Fennek Backup/u@pc/Current", "/m/Fennek Backup/u@pc/Older versions/2026-10-17 10.00/Documents")
    assert a[-2:] == ["/home/u/Documents/", "/m/Fennek Backup/u@pc/Current/Documents/"] and "--delete" in a and "--no-perms" in a
    with tempfile.TemporaryDirectory() as t:
        old = Path(t) / "Older versions"
        for name in ("2025-01-01 10.00", "2026-10-01 10.00", "notes"):
            (old / name).mkdir(parents=True)
        assert prune(old, now=datetime(2026, 10, 17)) == ["2025-01-01 10.00"]
        assert sorted(p.name for p in old.iterdir()) == ["2026-10-01 10.00", "notes"]
    with tempfile.TemporaryDirectory() as t:   # an untrusted drive: links must not lead anywhere
        mount, other = Path(t) / "drive", Path(t) / "home"
        mount.mkdir(); other.mkdir()
        assert real_dir(mount, mount / "Fennek Backup" / "u@pc" / "Current").is_dir()
        (mount / "Evil").symlink_to(other)
        for bad in (mount / "Evil" / "x", mount / "Evil"):
            try:
                real_dir(mount, bad); raise AssertionError("followed a link")
            except ValueError:
                pass
        (mount / "Older").mkdir(); (mount / "Older" / "2020-01-01 10.00").symlink_to(other)
        assert prune(mount / "Older", now=datetime(2026, 10, 17)) == [] and other.exists()
        dest = real_dir(mount, mount / "Fennek Backup" / "u@pc")
        tok = write_token(dest)
        assert read_token(dest) == tok and len(tok) == 32
        (dest / TOKEN).unlink(); (dest / TOKEN).symlink_to(other / "x")
        assert read_token(dest) == ""
    f = parse_pairs(r'UUID="AB12-CD34" LABEL="My\x20Stick" TARGET="/run/media/u/My\x20Stick"')   # as findmnt writes it
    assert f == {"UUID": "AB12-CD34", "LABEL": "My Stick", "TARGET": "/run/media/u/My Stick"}, f
    assert parse_pairs('UUID="" LABEL="" TARGET="/"') == {"UUID": "", "LABEL": "", "TARGET": "/"}
    rows = {"blockdevices": [{"uuid": "A", "label": None, "fstype": "exfat", "hotplug": True, "mountpoint": None, "size": 8},
                             {"uuid": "B", "label": "C", "fstype": "ntfs", "hotplug": False, "mountpoint": None, "size": 9},
                             {"uuid": "D", "label": "E", "fstype": "vfat", "hotplug": True, "mountpoint": "/run/media/u/E", "size": 9},
                             {"uuid": "F", "label": "L", "fstype": "crypto_LUKS", "hotplug": True, "mountpoint": None, "size": 9}]}
    assert [d["uuid"] for d in parse_plugged(json.dumps(rows))] == ["A"], "only removable drives not open yet"
    assert parse_plugged("nonsense") == [] and not plugged_in("../../x") and not plugged_in("")
    assert notice_due({}, "x", 100, 50) and not notice_due({"x": 90}, "x", 100, 50)
    print("selftest ok")


def main(argv):
    if argv == ["--selftest"]:
        return selftest()
    cmd = argv[0] if argv else "status"
    if cmd == "drives":
        ds = drives()
        ds += plugged_drives({d["uuid"] for d in ds})
        print(json.dumps(ds) if argv[1:] == ["--json"] else "\n".join(f"{d['label']}  ({d['uuid']})" for d in ds) or "No drive connected.")
    elif cmd == "use" and len(argv) == 2:
        mount_drive(argv[1])
        d = next((d for d in drives() if d["uuid"] == argv[1]), None)
        if not d:
            sys.exit("That drive isn't connected.")
        dest = destination(d["path"], fresh=True)
        first = ""
        try:
            # Choosing a drive must not empty a backup that's already there, just when it's needed.
            if not dest.is_symlink() and dest.is_dir() and has_backup(dest) and read_token(dest) != load().get("token"):
                choice = choose_existing(dest)
                if not choice:
                    return print("Nothing changed.")
                if choice == "restore":
                    save({**load(), "folder": dest.name})
                    first = restore(d["path"]) + " "
            token = write_token(real_dir(d["path"], dest))
        except (ValueError, OSError) as e:
            sys.exit(f"Can't use this drive: {e}")
        save({**load(), "uuid": d["uuid"], "label": d["label"], "token": token, "folder": dest.name})
        print(f"{first}Backing up to {d['label']}. " + run())
    elif cmd == "open":
        mount, _ = mount_drive(load().get("uuid"))
        if not mount:
            sys.exit("The backup drive isn't connected.")
        os.execvp("xdg-open", ["xdg-open", str(destination(mount))])
    elif cmd == "restore":
        mount, _ = mount_drive(load().get("uuid"))
        print(restore(mount) if mount else "The backup drive isn't connected.")
    elif cmd == "off":
        cfg = load(); cfg.pop("uuid", None); save(cfg)
        print("Backup is off. The copy on the drive stays.")
    elif cmd == "run":
        print(run(if_due=argv[1:] == ["--if-due"]))
    elif cmd == "status":
        s = status()
        print(json.dumps(s) if argv[1:] == ["--json"] else
              ("Off" if not s["on"] else f"On: {s['label']} ({'connected' if s['connected'] else 'not connected'})"))
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]) or 0)
