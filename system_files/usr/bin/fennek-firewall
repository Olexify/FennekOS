#!/usr/bin/python3
"""Block or allow a program's internet access (Fennek OS firewall, OpenSnitch engine).

Usage: fennek-firewall block PROGRAM    PROGRAM = path, command name (firefox) or a Windows .exe
       fennek-firewall allow PROGRAM
       fennek-firewall list [--json]
       fennek-firewall active [--json]          apps with internet connections right now (your own apps)
       fennek-firewall profile [home|public]   network profile of the current connection (show / set)
       fennek-firewall --selftest

Native programs and trusted Windows programs get an OpenSnitch rule (connections are rejected).
Sandboxed Windows programs simply get no network at all (their traffic would otherwise leave via pasta).
The engine (opensnitchd) only runs while at least one program is blocked: no cost when unused.
"""
import hashlib, json, os, re, shutil, subprocess, sys
from datetime import datetime, timezone
from pathlib import Path

RULES = Path("/etc/opensnitchd/rules")
PREFIX = "fennek-block-"
OFFLINE = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "fennek" / "offline-exes"
GUI = bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))


def tell(text):
    if GUI and sys.stdout is not None and not sys.stdout.isatty():
        subprocess.run(["notify-send", "-a", "Fennek Firewall", "Firewall", text], check=False)
    print(text)


def is_exe(prog):
    return prog.lower().endswith((".exe", ".msi"))


def resolve(prog):
    """Command name or relative path → absolute real path (Windows programs keep their name)."""
    if is_exe(prog):
        return os.path.realpath(prog) if os.path.exists(prog) else prog
    path = prog if "/" in prog else shutil.which(prog)
    if not path or not os.path.exists(path):
        sys.exit(f"Program not found: {prog}")
    return os.path.realpath(path)


def slug(label):
    return re.sub(r"[^a-z0-9._-]+", "-", label.lower()).strip("-.") or "program"


def rule(prog, now=None):
    """OpenSnitch rule rejecting all connections of PROG (absolute path, or a Windows .exe)."""
    now = now or datetime.now(timezone.utc).isoformat(timespec="seconds")
    label = Path(prog).name
    if is_exe(prog):   # Wine processes: match the .exe in the command line, not the wine binary
        op = {"type": "regexp", "operand": "process.command",
              "data": r"(?i)(^|[\\/ ])" + re.escape(label) + r"(\s|\"|$)"}
    else:
        op = {"type": "simple", "operand": "process.path", "data": prog}
    return {"created": now, "updated": now, "name": PREFIX + slug(label), "enabled": True, "precedence": True,
            "action": "reject", "duration": "always", "nolog": False,
            "description": f"Fennek OS: no internet for {label}",
            "operator": {**op, "sensitive": False, "list": []}}


def ours():
    return sorted(RULES.glob(PREFIX + "*.json")) if RULES.is_dir() else []


def engine(on):
    """Start/stop the blocking engine. Starting must really work: a block without a running engine is a lie."""
    action = ["enable", "--now"] if on else ["disable", "--now"]
    subprocess.run(["systemctl", *action, "--quiet", "opensnitch.service"], check=False)
    if on and subprocess.run(["systemctl", "is-active", "--quiet", "opensnitch.service"]).returncode != 0:
        sys.exit("The firewall engine didn't start: nothing is blocked. Try again or restart the computer.")


def engine_installed():
    return shutil.which("opensnitchd") is not None


def set_offline(exe, offline):
    """Per-user list of sandboxed Windows programs that get no network (by content hash)."""
    if not os.path.isfile(exe):
        return
    digest = hashlib.sha256(Path(exe).read_bytes()).hexdigest()
    lines = set(OFFLINE.read_text().split()) if OFFLINE.is_file() else set()
    lines = lines | {digest} if offline else lines - {digest}
    OFFLINE.parent.mkdir(parents=True, exist_ok=True)
    OFFLINE.write_text("".join(d + "\n" for d in sorted(lines)))


def blocked_entry(r):
    """Rule → {"name": shown name, "program": what to pass to `allow`} (path, or the .exe name)."""
    name = r["description"].removeprefix("Fennek OS: no internet for ")
    return {"name": name, "program": r["operator"]["data"] if r["operator"]["operand"] == "process.path" else name}


def root_part(cmd, prog):
    """Runs as root: write/remove the OpenSnitch rule, start/stop the engine."""
    r = rule(prog)
    path = RULES / f"{r['name']}.json"
    if cmd == "block":
        RULES.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(r, indent=2))
        engine(True)
    else:
        path.unlink(missing_ok=True)
        if not ours():
            engine(False)


def exe_of(pid):
    """Program behind a process: the .exe for programs run through the compatibility layer, else its path."""
    try:
        for arg in Path(f"/proc/{pid}/cmdline").read_bytes().decode(errors="replace").split("\0"):
            if is_exe(arg):
                return re.split(r"[\\/]", arg)[-1]
        return os.readlink(f"/proc/{pid}/exe")
    except OSError:
        return None


def active(ss_out, exe=exe_of):
    """`ss -tunpH` → apps with connections to other computers, one entry per program."""
    apps = {}
    for line in ss_out.splitlines():
        f = line.split()
        if len(f) < 7:
            continue
        host = f[5].rsplit(":", 1)[0].strip("[]").removeprefix("::ffff:")
        if host in ("*", "0.0.0.0", "::") or host.startswith("127.") or host == "::1":
            continue                                       # listening/unconnected, or this computer itself
        m = re.search(r'\("([^"]*)",pid=(\d+)', line)
        if not m:
            continue                                       # another user's process: not visible to us
        prog = exe(int(m[2])) or m[1]
        e = apps.setdefault(prog, {"name": prog if is_exe(prog) else m[1], "program": prog, "connections": 0})
        e["connections"] += 1
    return sorted(apps.values(), key=lambda a: a["name"].lower())


PROFILES = {"home": "FennekOS", "public": "FennekOS-Public"}


def connections(nmcli_out):
    """`nmcli -t -f NAME,TYPE connection show --active` → names of real network connections."""
    out = []
    for line in nmcli_out.splitlines():
        name, _, kind = line.rpartition(":")
        if name and kind not in ("loopback", "bridge", "tun", "wireguard"):
            out.append(name.replace("\\:", ":"))
    return out


def profile(set_to=None):
    """Network profile of the active connections: home (printers, phone pairing) or public (nothing in)."""
    nm = lambda *a: subprocess.run(["nmcli", *a], capture_output=True, text=True).stdout
    active = connections(nm("-t", "-f", "NAME,TYPE", "connection", "show", "--active"))
    if set_to:
        for c in active:   # NetworkManager asks for the admin password itself when needed
            subprocess.run(["nmcli", "connection", "modify", c, "connection.zone", PROFILES[set_to]], check=True)
            subprocess.run(["nmcli", "connection", "up", c], capture_output=True)   # apply now
        return set_to
    zones = {nm("-g", "connection.zone", "connection", "show", c).strip() for c in active}
    return "public" if PROFILES["public"] in zones else "home"


def main(argv):
    if argv == ["--selftest"]:
        return selftest()
    if argv[:1] == ["profile"] and len(argv) <= 2:
        if argv[1:] and argv[1] not in PROFILES:
            sys.exit(__doc__)
        print(profile(argv[1] if argv[1:] else None))
        return
    if argv[:1] == ["active"]:
        apps = active(subprocess.run(["ss", "-tunpH"], capture_output=True, text=True).stdout)
        print(json.dumps(apps) if argv[1:] == ["--json"] else "\n".join(f"{a['name']} ({a['connections']})" for a in apps))
        return
    if argv[:1] == ["list"]:
        blocked = [blocked_entry(json.loads(p.read_text())) for p in ours()]
        print(json.dumps(blocked) if argv[1:] == ["--json"] else "\n".join(b["name"] for b in blocked if b["name"]))
        return
    if argv[:1] == ["--root"] and os.geteuid() == 0:     # second half, after pkexec
        return root_part(argv[1], argv[2])
    if len(argv) != 2 or argv[0] not in ("block", "allow"):
        sys.exit(__doc__)
    cmd, prog = argv[0], resolve(argv[1])
    if cmd == "block" and not engine_installed():
        tell("Blocking an app's internet isn't available on this computer yet. Nothing was changed.")
        return 1
    if is_exe(prog):
        set_offline(prog, cmd == "block")                 # sandboxed runs: no network at all
    root = [os.path.realpath(sys.argv[0]), "--root", cmd, prog]
    rc = subprocess.run(root if os.geteuid() == 0 else ["pkexec", *root]).returncode
    if rc == 0:
        tell(f"{Path(prog).name}: internet {'blocked' if cmd == 'block' else 'allowed'}.")
    return rc


def selftest():
    assert connections("Wired connection 1:802-3-ethernet\nlo:loopback\nCafe\\:Free:802-11-wireless\n") \
        == ["Wired connection 1", "Cafe:Free"]
    r = rule("/usr/bin/curl", now="t")
    assert r["name"] == "fennek-block-curl" and r["action"] == "reject" and r["duration"] == "always"
    assert r["operator"]["operand"] == "process.path" and r["operator"]["data"] == "/usr/bin/curl"
    w = rule("/var/home/u/Downloads/My Game.exe", now="t")
    assert w["name"] == "fennek-block-my-game.exe" and w["operator"]["operand"] == "process.command"
    rx = re.compile(w["operator"]["data"][4:], re.I)   # strip (?i) for Python
    assert rx.search(r"C:\users\steamuser\My Game.exe") and rx.search(r"Z:\var\home\u\Downloads\my game.EXE -x")
    assert not rx.search(r"C:\Other Game.exe") and not rx.search(r"C:\NotMy Game.exe")
    assert slug("../../etc") == "etc", "rule names can't leave the rules folder"
    assert blocked_entry(r) == {"name": "curl", "program": "/usr/bin/curl"}
    assert blocked_entry(w) == {"name": "My Game.exe", "program": "My Game.exe"}
    ss = ('tcp ESTAB 0 0 10.0.2.15:41000 93.184.216.34:443 users:(("firefox",pid=10,fd=3))\n'
          'tcp ESTAB 0 0 10.0.2.15:41001 [2606:4700::1]:443 users:(("firefox",pid=11,fd=4))\n'
          'tcp ESTAB 0 0 127.0.0.1:5000 127.0.0.1:41002 users:(("dev",pid=12,fd=5))\n'
          'udp UNCONN 0 0 0.0.0.0:5353 0.0.0.0:* users:(("avahi",pid=13,fd=6))\n'
          'tcp ESTAB 0 0 10.0.2.15:41003 1.1.1.1:443 users:(("wine64-preload",pid=14,fd=7))\n'
          'tcp ESTAB 0 0 10.0.2.15:41004 8.8.8.8:53\n')
    paths = {10: "/usr/lib64/firefox/firefox", 11: "/usr/lib64/firefox/firefox", 14: "Game.exe"}
    assert active(ss, paths.get) == [
        {"name": "firefox", "program": "/usr/lib64/firefox/firefox", "connections": 2},
        {"name": "Game.exe", "program": "Game.exe", "connections": 1}]
    print("selftest ok")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]) or 0)
