[Desktop Entry]
Type=Application
Name=Thunderbird
GenericName=Mail and calendar (get it)
Comment=Email, calendar and contacts for any mail account. Not installed yet: one click installs it.
Exec=/usr/libexec/fennek-get-app org.mozilla.Thunderbird Thunderbird fennek-get-thunderbird
Icon=internet-mail
Categories=Office;Network;Email;
Keywords=mail;email;calendar;contacts;outlook;inbox;

Actions=hide;

[Desktop Action hide]
Name=Don't recommend this
Icon=list-remove
Exec=/usr/libexec/fennek-get-app --hide fennek-get-thunderbird
