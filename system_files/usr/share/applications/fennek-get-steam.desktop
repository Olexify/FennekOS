[Desktop Entry]
Type=Application
Name=Steam
GenericName=Games store and library (get it)
Comment=Your games library. Not installed yet: one click installs it.
Exec=/usr/libexec/fennek-get-app com.valvesoftware.Steam "Steam" fennek-get-steam
Icon=fennek-get-steam
Categories=Game;
Keywords=steam;games;valve;

Actions=hide;

[Desktop Action hide]
Name=Don't recommend this
Icon=list-remove
Exec=/usr/libexec/fennek-get-app --hide fennek-get-steam
