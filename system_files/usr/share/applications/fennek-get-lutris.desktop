Categories=Game;
Keywords=battle.net;blizzard;games;launcher;

Actions=hide;

[Desktop Action hide]
Name=Don't recommend this
Icon=list-remove
Exec=/usr/libexec/fennek-get-app --hide fennek-get-lutris
