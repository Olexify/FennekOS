[Desktop Entry]
Type=Application
Name=Install a program
Comment=Says what to do with a Linux program downloaded from a website
Exec=/usr/libexec/fennek-package-help %f
Icon=plasmadiscover
Terminal=false
NoDisplay=true
MimeType=application/x-rpm;application/vnd.debian.binary-package;application/vnd.appimage;application/x-iso9660-appimage;
