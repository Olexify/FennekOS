# Fennek OS: windows behave like the classic desktop.
[org.kde.kdecoration2]
# Fennek Classic frame (/usr/share/aurorae/themes/FennekClassic): white title bar, wide buttons, red close on hover.
library=org.kde.kwin.aurorae.v2
theme=__aurorae__svg__FennekClassic
# Thin edge drawn with the shadow; resize from the invisible area just outside the window.
BorderSize=None
BorderSizeAuto=false
# Window menu (app icon) on the left; minimize, maximize, close on the right. No extra KDE buttons.
ButtonsOnLeft=M
ButtonsOnRight=IAX

[Windows]
# Maximized windows keep their title bar: drag it down to restore, double-click to un-maximize.
BorderlessMaximizedWindows=false

[TabBox]
# Alt+Tab shows a grid of window previews.
LayoutName=thumbnail_grid

[Plugins]
# Alt+F4 on the desktop opens Shut down (/usr/share/kwin-wayland/scripts/fennekaltf4).
fennekaltf4Enabled=true
# F11: any window full screen, or back to a normal window with borders (/usr/share/kwin-wayland/scripts/fennekf11).
fennekf11Enabled=true
# Super+X quick links at the bottom-left (/usr/share/kwin-wayland/scripts/fennekwinx).
fennekwinxEnabled=true
fenneksnapassistEnabled=true
# Super+D shows the desktop and brings the same windows back on the second press (scripts/fennekshowdesktop).
fennekshowdesktopEnabled=true
# Super+Up maximizes, Super+Down restores or minimizes (scripts/fennekarrows).
fennekarrowsEnabled=true
