# Fennek OS Terminal: tabs always on top with a "+" for a new tab, like a classic terminal app
# (the toolbars are hidden in its layout files, see build.sh).
[TabBar]
TabBarVisibility=AlwaysShowTabBar
TabBarPosition=Top
NewTabButton=true

[Desktop Entry]
# Fennek profile: Fennek colours, Cascadia Mono 11, line cursor, unlimited scrollback.
DefaultProfile=Fennek.profile
