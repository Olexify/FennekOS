# Fennek OS: familiar global shortcuts (defaults; each user can change them in Settings → Keyboard shortcuts).
# Format: active shortcuts (tab-separated), default, description.
[kwin]
Overview=Meta+Tab	Meta+W,Meta+W,Toggle Overview
# Alt+F4 goes to the fennekaltf4 script: closes the window, or opens Shut down on the desktop.
Window Close=none,Alt+F4,Close Window
Fennek Close or Shut Down=Alt+F4,Alt+F4,Close the window, or shut down from the desktop
# Super+D goes to the fennekshowdesktop script (classic show desktop / bring back), not KWin's own peek.
Show Desktop=none,Meta+D,Peek at Desktop
Fennek Show Desktop=Meta+D,Meta+D,Show the desktop; press again to bring the windows back
# Super+Up / Super+Down: maximize / restore or minimize (fennekarrows), not KWin's top / bottom half.
Window Quick Tile Top=none,Meta+Up,Quick Tile Window to the Top
Window Quick Tile Bottom=none,Meta+Down,Quick Tile Window to the Bottom
Fennek Maximize=Meta+Up,Meta+Up,Maximize the window
Fennek Restore or Minimize=Meta+Down,Meta+Down,Restore a maximized window, or minimize it
# Super+M / Super+Home: minimize all windows / all but the active one, like the classic keys.
MinimizeAll=Meta+M,Meta+Shift+D,Minimize all windows
minimizeAllOthers=Meta+Home,Meta+Shift+O,Minimize all other windows

[ksmserver]
# Ctrl+Alt+Del opens the security options screen below, not the sign-out prompt.
Log Out=none,Ctrl+Alt+Del,Log Out

[plasmashell]
# Super+Tab belongs to the task view above, not to switching activities.
next activity=none,Meta+Tab,Walk through activities

[services][org.kde.krunner.desktop]
# Search everything (apps, files, sums): Alt+Space / Alt+F2. Super+R belongs to the Run box below.
_launch=Alt+Space	Alt+F2	Search

# Super+R: the Run box (fennek-app run), a centred card like the classic Run dialog.
[services][fennek-run.desktop]
_launch=Meta+R

# Super+I: Settings. Ctrl+Shift+Esc: Task Manager (Ctrl+Esc keeps working).
[services][fennek-settings.desktop]
_launch=Meta+I

# Super+X: quick links (Task Manager, Settings, File Explorer, Run, Shut down...).
[services][fennek-winx.desktop]
_launch=Meta+X

# Ctrl+Alt+Del: Lock, Switch user, Sign out, Change a password, Task Manager.
[services][fennek-security.desktop]
_launch=Ctrl+Alt+Del

# Super+Pause: About this computer (version, hardware), like the classic System page.
[services][fennek-about.desktop]
_launch=Meta+Pause

[services][org.kde.plasma-systemmonitor.desktop]
_launch=Ctrl+Shift+Esc	Ctrl+Esc

# Super+Space: the next input language (Alt+Shift and Super+Alt+K keep working).
[KDE Keyboard Layout Switcher]
Switch to Next Keyboard Layout=Meta+Space	Meta+Alt+K,Meta+Alt+K,Switch to Next Keyboard Layout
