# Fennek OS: Files (Dolphin) defaults that feel like the classic desktop.
[General]
ShowStatusBar=FullWidth
SortingChoice=NaturalSorting
RememberOpenedTabs=false
# Each folder remembers its own view (default: details); This PC keeps its grouped big-icon view.
GlobalViewProps=false
# Files opens on This PC (folders + drives), like the classic file manager.
HomeUrl=thispc:/
# No pop-up on hover: the Information panel on the right shows what you click or point at.
ShowToolTips=false
# No "+" box popping up on every item under the pointer (select with Ctrl/Shift or a drag, like the classic one).
ShowSelectionToggle=false

[MainWindow]
# Classic menu bar (File, Edit, View, Go...) shown from the first start; Ctrl+M hides it.
MenuBar=Enabled

[DetailsMode]
# Classic details view: comfortable rows, clear icons, no tree lines (folders open on double-click).
ExpandableFolders=false
IconSize=22
PreviewSize=22
# No empty strip left and right of the rows (the list starts at the edge, like the classic file manager).
LeftPadding=0
RightPadding=0

[IconsMode]
# Big icons where folders show as icons (This PC: folders and drives with their usage bar, like the classic page).
IconSize=64
PreviewSize=64

[ContentDisplay]
# Folders show the size of what they hold (counted in the background, ten levels deep).
DirectorySizeMode=ContentSize
# Real dates (18.10.2026 21:02) instead of "Yesterday at 21:02", like the classic file manager.
UseShortRelativeDates=false
