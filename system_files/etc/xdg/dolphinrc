# Fennek OS: File Explorer (Dolphin) defaults that feel like the classic desktop.
[General]
ShowStatusBar=FullWidth
SortingChoice=NaturalSorting
RememberOpenedTabs=false
GlobalViewProps=true
ShowToolTips=true

[MainWindow]
# Classic menu bar (File, Edit, View, Go...) shown from the first start; Ctrl+M hides it.
MenuBar=Enabled
