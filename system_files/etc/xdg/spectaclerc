# Fennek OS: snipping like the classic Snip tool. Drag, let go: the snip is taken (no extra confirm step),
# copied to the clipboard only (nothing piles up in Pictures); Save is one click in its window.
[General]
useReleaseToCapture=true
clipboardGroup=PostScreenshotCopyImage
autoSaveImage=false
showCaptureInstructions=false

[GuiConfig]
# Every snip starts fresh (no box left over from the last one).
rememberSelectionRect=Never
